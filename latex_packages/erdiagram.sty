      }
  }
\cs_new:Npn \er@shown
  {
    \str_if_eq:VnT \l__er_derived_tl { 1 } { / }
    \str_if_eq:VnT \l__er_multi_tl { 1 } { \exp_not:N \{ }
    \exp_not:V \l__er_label_tl
    \str_if_eq:VnT \l__er_multi_tl { 1 } { \exp_not:N \} }
  }
