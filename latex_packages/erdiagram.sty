      { \A (.*?) \s* \x40 ([-+]?[0-9.]+) / ([-+]?[0-9.]+) \s* \Z }
      \l__er_label_tl \l__er_parts_seq
      {
        \tl_set:Nx \l__er_label_tl { \seq_item:Nn \l__er_parts_seq { 2 } }
        \tl_set:Nx \l__er_px_tl { \seq_item:Nn \l__er_parts_seq { 3 } }
        \tl_set:Nx \l__er_py_tl { \seq_item:Nn \l__er_parts_seq { 4 } }
