%
% Copy this single file next to your document and write
%     \usepackage{erdiagram}
%
% Public interface (the only names defined globally):
%   environment   erdiagram            \begin{erdiagram}[<options>] ... \end{erdiagram}
%   command       \inputerdiagram      \inputerdiagram[<options>]{<file>}
%   command       \ersetup             \ersetup{<style keys>}
%   environment   relationalschema     relational schemas, as ERDTeX writes them
%
% Inside an erdiagram environment (and only there) the following short
% commands are available.  Optional (x,y) positions use TikZ coordinates
% (default unit: cm).  [..] = optional key/value options.
%
%   \entity[opts]{id}(x,y){Label}           entity type (rectangle)
%   \relationship[opts]{id}(x,y){Label}     relationship type (diamond)
%   \isa[opts]{id}(x,y){supertype}{cd}      generalisation (IS_A) + arrow
%   \canbe[opts]{id}(x,y){supertype}{cd}    specialisation (CAN_BE) + arrow
%   \partof[opts]{id}(x,y)                  aggregation (PART_OF diamond)
%   \attribute[opts]{id}(x,y){Label}        Chen-style attribute (ellipse)
%   \attributes[opts]{node}{*Key, Attr, ..} attribute tree attached to node
%   \link[opts]{from}{to}{cardinality}      edge (cardinality is optional)
%   \point{id}(x,y)                         invisible junction / waypoint
%   \note[opts](x,y){text}                  free text annotation
%   \subdomain[opts]{Label}{(x,y) (x,y) ..} subdomain frame (background)
%   \grid(x1,y1)(x2,y2)                     helper grid with coordinates
%   \setup{style keys}                      like \ersetup, local to diagram
%
% Any option a command does not know is handed to TikZ unchanged, so e.g.
% \entity[right=2cm of a]{b}{B} or \link[bend left=20]{a}{r} work too.
%
% See erdiagram-manual.pdf for the full documentation.

\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{erdiagram}[2026/11/07 v3.0.2 ER diagrams]

\RequirePackage{tikz}
\usetikzlibrary{calc,positioning,shapes.geometric,arrows.meta,backgrounds,patterns}

% ====================================================================
%  1.  STYLE PARAMETERS   (change with \ersetup{key=value, ...})
% ====================================================================
\pgfkeys{
  /er/.is family, /er,
  % -- entity types ---------------------------------------------------
  entity fill/.initial           = gray!15,
  entity draw/.initial           = black,
  entity line width/.initial     = 0.6pt,
  entity text/.initial           = black,
  entity font/.initial           = \bfseries,
  entity minimum width/.initial  = 2.8cm,
  entity minimum height/.initial = 1cm,
  entity inner sep/.initial      = 5pt,
  weak double distance/.initial  = 2pt,   % gap of double borders
  % -- relationship types ---------------------------------------------
  rel fill/.initial              = white,
  rel draw/.initial              = black,
  rel line width/.initial        = 0.6pt,
  rel text/.initial              = black,
  rel font/.initial              = \itshape,
  rel minimum width/.initial     = 2cm,
  rel minimum height/.initial    = 1.4cm,
  rel aspect/.initial            = 1.6,
  dependency color/.initial      = red!70!black,  % the "E" / "Id" mark
  dependency font/.initial       = \normalfont\bfseries,
  isa label/.initial             = \er@lang{IS\_A}{IST\_EIN*E},
  canbe label/.initial           = \er@lang{CAN\_BE}{KANN\_SEIN},
  partof label/.initial          = \er@lang{PART\_OF}{TEIL\_VON},
  isa shape/.initial             = hexagon, % or diamond (IS_A and CAN_BE)
  isa minimum width/.initial     = 2cm,
  isa minimum height/.initial    = 1cm,
  isa slant/.initial             = 0.5,     % top shorter by slant x half height on each side
  constraint style/.initial      = letters, % or words: cd -> complete, disjoint
  constraint color/.initial      = red!70!black,  % cd, co, id, io
  constraint font/.initial       = \normalfont\small,
  constraint pos/.initial        = inside,        % or auto, east, north, ...
  % -- attribute trees ------------------------------------------------
  attr font/.initial             = \small,
  attr text/.initial             = black,
  attr spread/.initial           = 0.35cm,  % distance between attributes
  attr gap/.initial              = {},      % trunk: node -> first attr (empty = spread)
  attr tick/.initial             = 0.3cm,   % length of the small ticks
  attr indent/.initial           = 3pt,     % the parts of a composite attribute
  attribute style/.initial       = compact, % or chen: lists drawn as ovals
  chen dist/.initial             = 0.9cm,   % from a node to the ovals of its list
  attr stem/.initial             = 0.3cm,   % bar layout: node -> bar
  % -- data types (attribute "name : type", \attribute[type=...]) ------
  show types/.code               = {\def\er@showtypes{#1}}, % print data types
  show types/.default            = true,
  type sep/.initial              = {:\ },   % between name and type
  type font/.initial             = {},      % font of the type
  % -- Chen-style attribute ellipses ----------------------------------
  attribute fill/.initial        = white,
  attribute draw/.initial        = black,
  attribute minimum width/.initial  = 1.2cm,
  attribute minimum height/.initial = 0.7cm,
  % -- cardinalities --------------------------------------------------
  card font/.initial             = \footnotesize,
  card text/.initial             = black,
  card placement/.initial        = inline,  % inline (mid-edge) | beside (near the entity)
  card dist/.initial             = 0.3cm,   % distance from the entity border
  card side/.initial             = auto,    % auto|above|below|left|right
  card notation/.initial         = n,       % n | minmax: read by the desktop editor
  card symbols/.initial          = labels,  % labels | crowsfoot (for 1, c, n, cn)
  crow length/.initial           = 6pt,     % crow's foot: from the border to the apex
  crow width/.initial            = 3.5pt,   % crow's foot: half its width, half a bar
  % -- role labels ----------------------------------------------------
  role font/.initial             = \footnotesize\itshape,
  role text/.initial             = black,
  role pos/.initial              = auto,  % auto: 0.5, or 0.25 from the entity with inline cards
  % -- edges ----------------------------------------------------------
  edge color/.initial            = black,
  edge line width/.initial       = 0.5pt,
  link double distance/.initial  = 1.5pt,   % gap of double-lined links
  % -- notes ----------------------------------------------------------
  note color/.initial            = red!70!black,
  note font/.initial             = \small,
  % -- subdomains -----------------------------------------------------
  subdomain color/.initial       = blue!60,
  subdomain label font/.initial  = \small\bfseries,
  subdomain line width/.initial  = 1.2pt,
  subdomain tuck/.initial        = 4pt,
  subdomain label vpad/.initial  = 4pt,
  subdomain label hpad/.initial  = 5pt,
  % -- misc -----------------------------------------------------------
  rm rules/.initial              = ,        % written by older versions of the editor (ignored here)
  sans serif/.initial            = false,   % all text of the diagrams
  sans serif/.default            = true,
  % the labels below follow the document's language; auto, english or german
  label language/.initial        = auto,
  rule warnings/.initial         = true,    % warn about ER rule violations
  grid color/.initial            = gray!25,
  grid label color/.initial      = gray!55,
  .unknown/.code={\PackageError{erdiagram}{Unknown style key
     `\pgfkeyscurrentname'}{See the erdiagram manual for valid keys.}},
}
\newcommand\ersetup[1]{\pgfqkeys{/er}{#1}}
\def\er@val#1{\pgfkeysvalueof{/er/#1}}

% ====================================================================
%  2.  TIKZ STYLES  (global, but prefixed with "er ")
% ====================================================================
\tikzset{
  er entity/.style={
    rectangle, align=center,
    draw=\er@val{entity draw}, fill=\er@val{entity fill},
    line width=\er@val{entity line width}, text=\er@val{entity text},
    font=\er@val{entity font}, inner sep=\er@val{entity inner sep},
    minimum width=\er@val{entity minimum width},
    minimum height=\er@val{entity minimum height}},
  er weak/.style={double, double distance=\er@val{weak double distance}},
  er crow/.style={draw=\er@val{edge color}, line width=\er@val{edge line width}},
  er relationship/.style={
    diamond, align=center,
    draw=\er@val{rel draw}, fill=\er@val{rel fill},
    line width=\er@val{rel line width}, text=\er@val{rel text},
    font=\er@val{rel font}, inner sep=2pt,
    minimum width=\er@val{rel minimum width},
    minimum height=\er@val{rel minimum height},
    aspect=\er@val{rel aspect}},
  er isa/.code={\er@ifeq{\er@val{isa shape}}{hexagon}%
    {\pgfkeysalso{er relationship, shape=er hexagon,
       minimum width=\er@val{isa minimum width},
       minimum height=\er@val{isa minimum height}}}%
    {\pgfkeysalso{er relationship}}},
  er attribute/.style={
    ellipse, align=center, inner sep=2pt,
    draw=\er@val{attribute draw}, fill=\er@val{attribute fill},
    line width=\er@val{edge line width},
    font=\er@val{attr font}, text=\er@val{attr text},
    minimum width=\er@val{attribute minimum width},
    minimum height=\er@val{attribute minimum height}},
  er composite attribute/.style={er attribute, rectangle, rounded corners=0.3cm},
  er partial key/.style={dash pattern=on 2pt off 1.2pt},
  er attr label/.style={
    font=\er@val{attr font}, text=\er@val{attr text}, inner sep=1pt,
    text height=1.5ex, text depth=0.25ex},
  er card/.style={
    font=\er@val{card font}, text=\er@val{card text}, inner sep=1.5pt},
  er card inline/.style={fill=white, inner sep=1pt},
  er role/.style={
    font=\er@val{role font}, text=\er@val{role text}, inner sep=2pt},
  er constraint/.style={
    font=\er@val{constraint font}, text=\er@val{constraint color},
    inner sep=2pt},
  er edge/.style={
    draw=\er@val{edge color}, line width=\er@val{edge line width}},
  er arrow/.style={er edge, -{Triangle[length=6pt, width=4pt]}},
  er double link/.style={double, double distance=\er@val{link double distance}},
  er note/.style={
    draw=none, fill=none, align=left, inner sep=0pt,
    text=\er@val{note color}, font=\er@val{note font}},
}

% ====================================================================
%  3.  INTERNAL HELPERS
% ====================================================================
%% <shared:helpers> -- maintained in erdiagram.sty, copied by tools/sync_shared.py
% --- option handling: our keys are processed by pgfkeys, all unknown
%     keys are collected in \er@tikz and handed to TikZ verbatim.
\newtoks\er@tikz
\def\er@addtikz#1{\er@tikz\expandafter{\the\er@tikz#1,}}
\def\er@addtikzx#1{\edef\er@tmp{#1}\expandafter\er@addtikz\expandafter{\er@tmp}}
\def\er@forward#1{%
  \def\er@tmpv{#1}%
  \ifx\er@tmpv\pgfkeysnovalue@text
    \expandafter\er@addtikz\expandafter{\pgfkeyscurrentname}%
  \else
    \edef\er@tmp{\expandafter\unexpanded\expandafter{\pgfkeyscurrentname}%
      ={\unexpanded{#1}}}%
    \expandafter\er@addtikz\expandafter{\er@tmp}%
  \fi}
% turn the collected options into the TikZ style "er@user"
\def\er@usetikz{\tikzset{er@user/.style/.expanded={\the\er@tikz}}}

% --- boolean test for "true"/"false" values ---------------------------
\def\er@true{true}
\def\er@iftrue#1{\edef\er@tmpb{#1}\ifx\er@tmpb\er@true
  \expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
% \er@ifempty{\macro or text}: the argument is expanded only ONCE and then
% detokenized -- labels may contain fragile commands that must not be
% expanded in an \edef (e.g. \textbar in OT1)
\def\er@ifempty#1{\expandafter\er@ifempty@\expandafter{#1}}
\def\er@ifempty@#1{\if\relax\detokenize{#1}\relax
  \expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
% full expansion, for option values only
\def\er@ifemptyx#1{\edef\er@tmpb{#1}\ifx\er@tmpb\@empty
  \expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\def\er@ifeq#1#2{\edef\er@tmpa{#1}\edef\er@tmpb{#2}\ifx\er@tmpa\er@tmpb
  \expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}

% --- colour tints: "blue" -> blue!20, "orange!30" stays as it is -------
\def\er@tint#1{%
  \edef\er@tmp{\noexpand\in@{!}{#1}}\er@tmp
  \ifin@ \def\er@tinted{#1}%
  \else
    \er@ifeq{#1}{white}{\def\er@tinted{white}}{%
    \er@ifeq{#1}{none}{\def\er@tinted{none}}{\def\er@tinted{#1!20}}}%
  \fi}

% --- diagram-wide registry of node types --------------------------------
\newcount\er@diagramno
\newcount\er@k   % general loop counter
\def\er@reg#1{er@\the\er@diagramno @#1}  % name of a registry entry
\def\er@settype#1#2{\expandafter\xdef\csname\er@reg{type@#1}\endcsname{#2}}
\def\er@gettype#1{%  -> \er@type
  \expandafter\ifx\csname\er@reg{type@#1}\endcsname\relax
    \def\er@type{unknown}%
  \else
    \edef\er@type{\csname\er@reg{type@#1}\endcsname}%
  \fi}
\def\er@setflag#1{\expandafter\gdef\csname\er@reg{#1}\endcsname{}}
\def\er@ifflag#1{\expandafter\ifx\csname\er@reg{#1}\endcsname\relax
  \expandafter\@secondoftwo\else\expandafter\@firstoftwo\fi}
\def\er@incr#1{\edef\er@tmpn{\the\numexpr\er@count{#1}+1\relax}%
  \expandafter\global\expandafter\let\csname\er@reg{#1}\endcsname\er@tmpn}
\def\er@count#1{\ifcsname\er@reg{#1}\endcsname\csname\er@reg{#1}\endcsname\else0\fi}
\def\er@remember#1#2{% append id #2 to list #1
  \expandafter\ifx\csname\er@reg{list@#1}\endcsname\relax
    \expandafter\xdef\csname\er@reg{list@#1}\endcsname{#2}%
  \else
    \expandafter\xdef\csname\er@reg{list@#1}\endcsname{%
      \csname\er@reg{list@#1}\endcsname,#2}%
  \fi}
\def\er@forlist#1#2{% #1 list name, #2 macro taking one id
  \expandafter\ifx\csname\er@reg{list@#1}\endcsname\relax\else
    \edef\er@tmpl{\csname\er@reg{list@#1}\endcsname}%
    \@for\er@item:=\er@tmpl\do{\expandafter#2\expandafter{\er@item}}%
  \fi}

% --- optional trailing {argument}: \er@peekbrace{\cmd{a}{b}} calls
%     \cmd{a}{b}{<arg>} if a brace group follows, else \cmd{a}{b}{}
\long\def\er@peekbrace#1{\@ifnextchar\bgroup{#1}{#1{}}}

% --- node id without anchor: "student.north" -> "student" -------------
\def\er@splitid#1{\er@splitid@#1.\@nil}
\def\er@splitid@#1.#2\@nil{\def\er@id{#1}}

% --- rule warnings -------------------------------------------------------
\def\er@rule#1{\er@iftrue{\er@val{rule warnings}}%
  {\PackageWarning{erdiagram}{ER rule: #1}}{}}


% anchor on the opposite side (for labels placed next to a node)
\def\er@oppositeanchor#1{%
  \def\er@oppanchor{west}%
  \er@ifeq{#1}{north}{\def\er@oppanchor{south}}{}%
  \er@ifeq{#1}{south}{\def\er@oppanchor{north}}{}%
  \er@ifeq{#1}{east}{\def\er@oppanchor{west}}{}%
  \er@ifeq{#1}{west}{\def\er@oppanchor{east}}{}%
  \er@ifeq{#1}{north east}{\def\er@oppanchor{south west}}{}%
  \er@ifeq{#1}{north west}{\def\er@oppanchor{south east}}{}%
  \er@ifeq{#1}{south east}{\def\er@oppanchor{north west}}{}%
  \er@ifeq{#1}{south west}{\def\er@oppanchor{north east}}{}}
%% </shared:helpers>

% ====================================================================
%  4.  NODES
% ====================================================================
\pgfkeys{
  /er/node/.is family, /er/node,
  .unknown/.code   = {\er@forward{#1}},
  weak/.code       = {\er@ifeq{#1}{false}{}{\er@addtikz{er weak}\def\er@weak{1}}},
  weak/.default    = true,
  dependency/.code = {\def\er@dep{#1}\er@addtikz{er weak}\def\er@weak{1}},
  color/.code      = {\er@tint{#1}\er@addtikzx{fill=\er@tinted}},
  colour/.forward to = /er/node/color,
  % only for \attribute
  key/.code        = {\def\er@akey{1}},
  derived/.code    = {\er@addtikz{dashed}},
  multivalued/.code= {\er@addtikz{double, double distance=1.5pt}},
  composite/.code  = {\def\er@astyle{er composite attribute}},
  of/.store in     = \er@aof,
  type/.store in   = \er@atype,
  formula/.code    = {},  % for the relational schema only
  unique/.code     = {},  % a further candidate key, not drawn
  unique/.default  = true,
  % relational model (read by the desktop editor, no effect on the drawing)
  rm/.code          = {},
  rm name/.code     = {},
  rm key/.code      = {},
  rm category/.code = {},
  % only for \isa / \canbe
  constraint pos/.store in = \er@cpos,
  super card/.store in     = \er@supercard,
  sub card/.store in       = \er@subcard,
}
\def\er@resetnode{%
  \er@tikz{}\let\er@dep\@empty\let\er@weak\@empty
  \let\er@akey\@empty\def\er@astyle{er attribute}\let\er@aof\@empty
  \let\er@atype\@empty
  \edef\er@cpos{\er@val{constraint pos}}%
  \let\er@supercard\@empty\let\er@subcard\@empty}

% \er@node{<type>}{<tikz style>}{<options>}{<id>}{<position or -NoValue->}{<label>}
\def\er@node#1#2#3#4#5#6{%
  \er@resetnode
  \pgfqkeys{/er/node}{#3}%
  \er@usetikz
  \er@ifempty{\er@dep}{\def\er@label{#6}}{%
    \def\er@label{{\color{\er@val{dependency color}}\er@val{dependency font}%
      \er@dep}\\[-2pt]#6}}%
  \IfNoValueTF{#5}%
    {\node[#2, er@user] (#4) {\er@label};}%
    {\node[#2, er@user] (#4) at (#5) {\er@label};}%
  \er@settype{#4}{#1}%
  \er@ifempty{\er@weak}{}{\er@setflag{weak@#4}%
    \expandafter\xdef\csname\er@reg{rdep@#4}\endcsname{\er@dep}}%
  \er@remember{#1}{#4}}

\NewDocumentCommand\er@cmd@entity{O{} m d() m}{%
  \er@node{entity}{er entity}{#1}{#2}{#3}{#4}}
\NewDocumentCommand\er@cmd@relationship{O{} m d() m}{%
  \er@node{relationship}{er relationship}{#1}{#2}{#3}{#4}}
\NewDocumentCommand\er@cmd@partof{O{} m d()}{%
  \er@node{relationship}{er relationship}{#1}{#2}{#3}{\er@val{partof label}}}
\NewDocumentCommand\er@cmd@point{m d()}{%
  \IfNoValueTF{#2}{\PackageError{erdiagram}{\string\point\space needs a
    position: \string\point{#1}(x,y)}{}}{\coordinate (#1) at (#2);}%
  \er@settype{#1}{point}}

% --- Chen-style attribute ellipse --------------------------------------
\NewDocumentCommand\er@cmd@attribute{O{} m d() m}{%
  \er@resetnode
  \pgfqkeys{/er/node}{#1}%
  \er@usetikz
  \let\er@asuffix\@empty
  \ifx\er@atype\@empty\else\er@iftypes{\def\er@asuffix{\er@typesuffix{\er@atype}}}{}\fi
  % it may only get linked to a weak entity later
  \er@ifempty{\er@akey}{\def\er@label{#4\er@asuffix}}%
    {\def\er@label{\er@latekey{#2}{#4}{\er@asuffix}}}%
  \IfNoValueTF{#3}%
    {\node[\er@astyle, er@user] (#2) {\er@label};}%
    {\node[\er@astyle, er@user] (#2) at (#3) {\er@label};}%
  \er@settype{#2}{attribute}%
  \er@ifempty{\er@aof}{}{%
    \edef\er@tmp{\noexpand\er@link{}{\er@aof}{#2}{}}\er@tmp}}

% --- the shape of IS_A and CAN_BE: an elongated hexagon ------------------
%  Flat top and bottom, pointed sides.  \er@hh, \er@hw: half sizes, \er@hs: how
%  much shorter the top is on each side.  Wide enough that the text's corners stay
%  inside under the slanted sides.  (desktop app: geometry.hexagon_shape)
\def\er@hexcalc{%
  \pgfmathsetmacro\er@tw{\the\wd\pgfnodeparttextbox/2}%
  \pgfmathsetmacro\er@th{(\the\ht\pgfnodeparttextbox+\the\dp\pgfnodeparttextbox)/2}%
  \pgfmathsetmacro\er@hh{max(\er@th+\pgfshapeinnerysep,\pgfshapeminheight/2)}%
  \pgfmathsetmacro\er@hs{\er@val{isa slant}*\er@hh}%
  \pgfmathsetmacro\er@hw{max(\er@tw+\pgfshapeinnerxsep+\er@hs*(\er@th+\pgfshapeinnerysep)/\er@hh,
                             \pgfshapeminwidth/2)}}
\pgfdeclareshape{er hexagon}{%
  \savedanchor\er@hexcenter{%
    \pgf@x=.5\wd\pgfnodeparttextbox
    \pgf@y=.5\ht\pgfnodeparttextbox \advance\pgf@y by -.5\dp\pgfnodeparttextbox}%
  \savedanchor\er@hexsize{\er@hexcalc \pgf@x=\er@hw pt \pgf@y=\er@hh pt}%
  \savedanchor\er@hexslant{\er@hexcalc \pgf@x=\er@hs pt \pgf@y=0pt}%
  \savedmacro\er@hexouter{\pgfmathsetmacro\er@hexouter{\pgfshapeouterxsep}}%
  \anchor{center}{\er@hexcenter}%
  \anchor{mid}{\er@hexcenter}%
  \anchor{base}{\er@hexcenter \pgf@y=0pt}%
  \anchor{north}{\er@hexat{0}{0}{1}}%
  \anchor{south}{\er@hexat{0}{0}{-1}}%
  \anchor{east}{\er@hexat{1}{0}{0}}%
  \anchor{west}{\er@hexat{-1}{0}{0}}%
  \anchor{north east}{\er@hexat{1}{1}{1}}%
  \anchor{north west}{\er@hexat{-1}{1}{1}}%
  \anchor{south east}{\er@hexat{1}{1}{-1}}%
  \anchor{south west}{\er@hexat{-1}{1}{-1}}%
  \anchorborder{%
    % a unit vector: long edges would overflow pgfmath otherwise
    \pgfpointnormalised{\pgfqpoint{\pgf@x}{\pgf@y}}%
    \edef\er@hexdx{\the\pgf@x}\edef\er@hexdy{\the\pgf@y}%
    \er@hexsize
    \pgfmathsetmacro\er@hw{\the\pgf@x+\er@hexouter}%
    \pgfmathsetmacro\er@hh{\the\pgf@y+\er@hexouter}%
    \er@hexslant
    \pgfmathsetmacro\er@hs{\the\pgf@x}%
    \pgfmathsetmacro\er@ha{abs(\er@hexdx)}%
    \pgfmathsetmacro\er@hb{abs(\er@hexdy)}%
    % the top edge if the ray passes inside its corner, otherwise a slanted side
    % (not with ?: which would evaluate both, and divide by zero on a level edge)
    \pgfmathsetmacro\er@hl{\er@ha*\er@hh}%
    \pgfmathsetmacro\er@hr{(\er@hw-\er@hs)*\er@hb}%
    \ifdim\er@hl pt>\er@hr pt
      \pgfmathsetmacro\er@ht{\er@hw/(\er@ha+\er@hs*\er@hb/\er@hh)}%
    \else\ifdim\er@hb pt=0pt
      \def\er@ht{0}%
    \else
      \pgfmathsetmacro\er@ht{\er@hh/\er@hb}%
    \fi\fi
    \er@hexcenter
    \advance\pgf@x by \er@ht\dimexpr\er@hexdx\relax
    \advance\pgf@y by \er@ht\dimexpr\er@hexdy\relax}%
  \backgroundpath{%
    \er@hexsize \pgf@xa=\pgf@x \pgf@ya=\pgf@y
    \er@hexslant \pgf@xb=\pgf@x
    \er@hexcenter \pgf@xc=\pgf@x \pgf@yc=\pgf@y
    \pgfpathmoveto{\pgfqpoint{\dimexpr\pgf@xc+\pgf@xa}{\pgf@yc}}%
    \pgfpathlineto{\pgfqpoint{\dimexpr\pgf@xc+\pgf@xa-\pgf@xb}{\dimexpr\pgf@yc+\pgf@ya}}%
    \pgfpathlineto{\pgfqpoint{\dimexpr\pgf@xc-\pgf@xa+\pgf@xb}{\dimexpr\pgf@yc+\pgf@ya}}%
    \pgfpathlineto{\pgfqpoint{\dimexpr\pgf@xc-\pgf@xa}{\pgf@yc}}%
    \pgfpathlineto{\pgfqpoint{\dimexpr\pgf@xc-\pgf@xa+\pgf@xb}{\dimexpr\pgf@yc-\pgf@ya}}%
    \pgfpathlineto{\pgfqpoint{\dimexpr\pgf@xc+\pgf@xa-\pgf@xb}{\dimexpr\pgf@yc-\pgf@ya}}%
    \pgfpathclose}%
}
% \er@hexat{sx}{corner}{sy}: sx,sy = -1,0,1; corner=1: the end of the flat side
\def\er@hexat#1#2#3{%
  \er@hexsize
  \pgfmathsetmacro\er@hw{\the\pgf@x+\er@hexouter}%
  \pgfmathsetmacro\er@hh{\the\pgf@y+\er@hexouter}%
  \er@hexslant
  \pgfmathsetmacro\er@hs{\the\pgf@x}%
  \er@hexcenter
  \pgfmathsetlength\pgf@xa{#1*(\er@hw-#2*\er@hs)}%
  \pgfmathsetlength\pgf@ya{#3*\er@hh}%
  \advance\pgf@x by \pgf@xa
  \advance\pgf@y by \pgf@ya}
% the letters of a constraint as words; anything else stays as it is
\ExplSyntaxOn
% several lines need their own box: \\ can't be used inside the label's colour group
\cs_new_protected:Npn \er@constraintlines
  {
    \tl_if_in:NnT \er@constext { \\ }
      {
        \tl_put_left:Nn \er@constext { \begingroup \tabcolsep = 0pt \begin{tabular}{c} }
        \tl_put_right:Nn \er@constext { \end{tabular} \endgroup }
      }
  }
\str_new:N \l__er_card_str
\cs_new_protected:Npn \er@constraintwords
  {
    \str_set:NV \l__er_card_str \er@constext
    \str_case:onT { \l__er_card_str }
      {
        { cd } { \def \er@constext { complete,~disjoint } }
        { co } { \def \er@constext { complete,~overlapping } }
        { id } { \def \er@constext { incomplete,~disjoint } }
        { io } { \def \er@constext { incomplete,~overlapping } }
        { c } { \def \er@constext { complete } }
        { i } { \def \er@constext { incomplete } }
        { d } { \def \er@constext { disjoint } }
        { o } { \def \er@constext { overlapping } }
      }
      { }
  }
\ExplSyntaxOff

% --- the labels in the language of the document: #1 English, #2 German ---
\def\er@lang#1#2{%
  \er@ifeq{\er@val{label language}}{german}{#2}{%
    \er@ifeq{\er@val{label language}}{english}{#1}{%
      % as strings: babel's \languagename doesn't consist of letters for TeX
      \edef\er@tmp{\noexpand\in@{,\detokenize\expandafter{\languagename},}%
        {\detokenize{,german,ngerman,austrian,naustrian,swissgerman,nswissgerman,}}}\er@tmp
      \ifin@ #2\else #1\fi}}}
% --- generalisation / specialisation -----------------------------------
%  \isa[opts]{id}(x,y){supertype}{constraint}
%  (the constraint argument is optional; we peek for a brace group)
\NewDocumentCommand\er@cmd@isa{O{} m d() m}{%
  \er@peekbrace{\er@isa{\er@val{isa label}}{#1}{#2}{#3}{#4}}}
\NewDocumentCommand\er@cmd@canbe{O{} m d() m}{%
  \er@peekbrace{\er@isa{\er@val{canbe label}}{#1}{#2}{#3}{#4}}}
\def\er@isa#1#2#3#4#5#6{%
  \er@resetnode
  \pgfqkeys{/er/node}{#2}%
  \er@usetikz
  \def\er@constext{#6}%
  \er@ifeq{\er@val{constraint style}}{words}{% words don't fit inside
    \er@constraintwords
    \er@ifeq{\er@cpos}{inside}{\def\er@cpos{auto}}{}}{}%
  \er@constraintlines
  \er@ifeq{\er@cpos}{inside}%
    {\er@ifempty{\er@constext}{\def\er@label{#1}}%
       {\def\er@label{#1\\[-2pt]{\color{\er@val{constraint color}}%
          \er@val{constraint font}\er@constext}}}}%
    {\def\er@label{#1}}%
  \IfNoValueTF{#4}%
    {\node[er isa, er@user] (#3) {\er@label};}%
    {\node[er isa, er@user] (#3) at (#4) {\er@label};}%
  \er@settype{#3}{isa}%
  \er@remember{isa}{#3}%
  % constraint letters beside the shape ("auto": placed at the end of
  % the diagram in the direction with the most room)
  \er@ifeq{\er@cpos}{inside}{}{\er@ifempty{\er@constext}{}{%
    \er@ifeq{\er@cpos}{auto}{%
      \er@remember{isacons}{#3}%
      \expandafter\xdef\csname\er@reg{cons@#3}\endcsname{%
        \unexpanded\expandafter{\er@constext}}}%
     {\er@oppositeanchor{\er@cpos}%
      \node[er constraint, anchor=\er@oppanchor] at (#3.\er@cpos) {\er@constext};}}}%
  % "n", "c", "cn" below the shape (alternative notation)
  \er@ifempty{\er@subcard}{}{%
    \node[er card, anchor=north west, xshift=1pt] at (#3.south) {\er@subcard};}%
  % arrow to the supertype
  \er@splitid{#5}\er@gettype{\er@id}%
  \er@ifeq{\er@type}{entity}{}{\er@ifeq{\er@type}{unknown}{}{%
    \er@rule{the supertype `#5' of `#3' is not an entity}}}%
  \begingroup
    \er@tikz{}\er@resetlink
    \def\er@A{(#3)}\def\er@B{(#5)}\def\er@cardend{b}%
    \let\er@cardtext\er@supercard
    \def\er@edgestyle{er arrow}%
    \er@drawedge
  \endgroup}


% ====================================================================
%  5.  LINKS (edges) WITH CARDINALITIES AND ROLES
% ====================================================================
\pgfkeys{
  /er/link/.is family, /er/link,
  .unknown/.code       = {\er@forward{#1}},
  card side/.store in  = \er@cardside,
  card dist/.store in  = \er@carddist,
  card pos/.store in   = \er@cardpos,
  card placement/.store in = \er@cardplacement,
  inline/.code         = {\def\er@cardplacement{inline}},
  beside/.code         = {\def\er@cardplacement{beside}},
  role/.store in       = \er@role,
  role pos/.store in   = \er@rolepos,
  role side/.store in  = \er@roleside,
  bend/.code           = {\er@setbend{#1}},
  via/.store in        = \er@via,
  ortho/.store in      = \er@ortho,
  arrow/.code          = {\def\er@edgestyle{er arrow}},
  % double line, e.g. between a weak relationship and its weak entity
  double/.code         = {\er@ifeq{#1}{false}{}{\er@addtikz{er double link}\def\er@double{1}}},
  double/.default      = true,
}
\def\er@resetlink{%
  \let\er@crow\@empty
  \def\er@double{0}%
  \edef\er@cardside{\er@val{card side}}%
  \edef\er@carddist{\er@val{card dist}}%
  \let\er@cardpos\@empty
  \edef\er@cardplacement{\er@val{card placement}}%
  \let\er@role\@empty
  \edef\er@rolepos{\er@val{role pos}}%
  \let\er@roleside\@empty
  \let\er@via\@empty\let\er@ortho\@empty
  \let\er@cardtext\@empty
  \def\er@edgestyle{er edge}}

%% <shared:geometry> -- maintained in erdiagram.sty, copied by tools/sync_shared.py
% --- parse "(1,2) (a.north) (3,4)" into \er@pts = {(1,2)}{(a.north)}{(3,4)}
\def\er@stopmark{\er@stop}
\def\er@parsevia#1{\def\er@pts{}\er@npts=0 \er@parsevia@#1(\er@stop)}
\newcount\er@npts
\def\er@parsevia@#1(#2){%
  \def\er@tmp{#2}%
  \ifx\er@tmp\er@stopmark\else
    \advance\er@npts by 1
    \expandafter\def\csname er@pt@\the\er@npts\endcsname{(#2)}%
    \expandafter\er@parsevia@
  \fi}

% --- geometry of the segment from #1 to #2 (both "(...)") --------------
%     -> \er@vx, \er@vy (direction, pt) and \er@len (length, pt)
\def\er@measure#1#2{%
  \edef\er@do{\noexpand\path[draw=none] #1 -- #2 coordinate[pos=0] (er@s)
    coordinate[pos=1] (er@t);}\er@do
  \pgfpointanchor{er@s}{center}\pgfgetlastxy\er@sx\er@sy
  \pgfpointanchor{er@t}{center}\pgfgetlastxy\er@tx\er@ty
  \pgfmathsetmacro\er@vx{\er@tx-\er@sx}%
  \pgfmathsetmacro\er@vy{\er@ty-\er@sy}%
  \pgfmathsetmacro\er@len{veclen(\er@vx,\er@vy)}}

% --- which side of the direction (\er@vx,\er@vy) is "above", "right"..?
%     #1 = auto|above|below|left|right  -> \er@sideleft = 1 (left) / 0
\def\er@chooseside#1{%
  \pgfmathparse{abs(\er@vx)>=abs(\er@vy) ? 1 : 0}%
  \ifnum\pgfmathresult=1 \def\er@horiz{1}\else\def\er@horiz{0}\fi
  \def\er@req{#1}%
  \er@ifeq{\er@req}{auto}{%
    \ifnum\er@horiz=1 \def\er@req{above}\else\def\er@req{right}\fi}{}%
  \er@ifeq{\er@req}{above}{%
    \ifdim\er@vx pt>0.01pt \def\er@sideleft{1}\else
    \ifdim\er@vx pt<-0.01pt \def\er@sideleft{0}\else
    \er@chooseside@right\fi\fi}{}%
  \er@ifeq{\er@req}{below}{%
    \ifdim\er@vx pt>0.01pt \def\er@sideleft{0}\else
    \ifdim\er@vx pt<-0.01pt \def\er@sideleft{1}\else
    \er@chooseside@left\fi\fi}{}%
  \er@ifeq{\er@req}{right}{\er@chooseside@right}{}%
  \er@ifeq{\er@req}{left}{\er@chooseside@left}{}}
\def\er@chooseside@right{%
  \ifdim\er@vy pt<-0.01pt \def\er@sideleft{1}\else
  \ifdim\er@vy pt>0.01pt \def\er@sideleft{0}\else
  \ifdim\er@vx pt>0pt \def\er@sideleft{0}\else\def\er@sideleft{1}\fi\fi\fi}
\def\er@chooseside@left{%
  \ifdim\er@vy pt<-0.01pt \def\er@sideleft{0}\else
  \ifdim\er@vy pt>0.01pt \def\er@sideleft{1}\else
  \ifdim\er@vx pt>0pt \def\er@sideleft{1}\else\def\er@sideleft{0}\fi\fi\fi}

\newcount\er@i
% --- "(student.north)" -> \er@id = student
\def\er@idof#1{\expandafter\er@idof@#1}
\def\er@idof@(#1){\er@splitid{#1}}
% --- direction (degrees) from coordinate #1 to coordinate #2 -> \er@ang
\def\er@angleof#1#2{%
  \pgfpointanchor{#1}{center}\pgfgetlastxy\er@xa\er@ya
  \pgfpointanchor{#2}{center}\pgfgetlastxy\er@xb\er@yb
  \pgfmathsetmacro\er@ang{atan2(\er@yb-\er@ya,\er@xb-\er@xa)}}
% --- remember that something leaves node #1 in direction #2 -> #3
%     (#4 = edge number, 0 for attribute trees etc.)
\def\er@recordangle#1#2#3#4{%
  \er@angleof{#2}{#3}%
  \er@remember{angles@#1}{#4/\er@ang}}
\newif\ifer@sidesonly % wide text: centred above or below it would straddle the edges
% --- the free direction around node #1 that is furthest away from all
%     recorded edges -> \er@bestpos (anchor name), \er@oppanchor
%     (candidates in order of preference; ties keep the earlier one)
\def\er@bestdir#1{%
  \def\er@bestscore{-1}\def\er@bestpos{east}%
  \expandafter\ifx\csname\er@reg{list@angles@#1}\endcsname\relax
    \def\er@tmplb{}\else\edef\er@tmplb{\csname\er@reg{list@angles@#1}\endcsname}\fi
  \er@trydir{0}{east}\er@trydir{45}{north east}\er@trydir{315}{south east}%
  \ifer@sidesonly\else\er@trydir{90}{north}\er@trydir{270}{south}\fi
  \er@trydir{180}{west}%
  \er@trydir{135}{north west}\er@trydir{225}{south west}%
  \er@oppositeanchor{\er@bestpos}}
\def\er@trydir#1#2{%
  \def\er@score{180}\def\er@cand{#1}%
  \ifx\er@tmplb\@empty\else
    \@for\er@itemb:=\er@tmplb\do{\expandafter\er@trydir@\er@itemb\@nil}\fi
  \ifdim\er@score pt>\er@bestscore pt
    \let\er@bestscore\er@score\def\er@bestpos{#2}\fi}
\def\er@trydir@#1/#2\@nil{%
  \pgfmathsetmacro\er@d{min(Mod(\er@cand-#2,360),Mod(#2-\er@cand,360))}%
  \pgfmathsetmacro\er@score{min(\er@score,\er@d)}}
% --- bend=<signed angle>: positive bends left, negative right
\def\er@setbend#1{%
  \pgfmathparse{#1}\let\er@b\pgfmathresult
  \ifdim\er@b pt>0pt \er@addtikzx{bend left=\er@b}\fi
  \ifdim\er@b pt<0pt \pgfmathparse{-\er@b}\er@addtikzx{bend right=\pgfmathresult}\fi}
%% </shared:geometry>

% --- the edge drawer --------------------------------------------------
%  input: \er@A, \er@B ("(...)"), \er@via, \er@ortho, \er@cardend (a|b),
%         \er@cardtext, \er@card..., \er@role..., \er@edgestyle, \er@tikz
%  Cardinalities with "card side=auto" are only *marked* on the path; they
%  are placed at the end of the diagram (\er@placecards), when all edges
%  meeting the entity are known and the side with more room can be chosen.
\def\er@drawedge{%
  \er@usetikz
  \global\advance\er@edgeno by 1 \edef\er@en{\the\er@edgeno}%
  % points P0 .. Pn
  \er@ifempty{\er@via}{\er@npts=0 }{\expandafter\er@parsevia\expandafter{\er@via}}%
  \expandafter\let\csname er@pt@0\endcsname\er@A
  \advance\er@npts by 1
  \expandafter\let\csname er@pt@\the\er@npts\endcsname\er@B
  % segment that carries the labels and its "outward" direction
  \er@ifeq{\er@cardend}{b}%
    {\edef\er@lseg{\the\er@npts}%
     \edef\er@E{\csname er@pt@\the\er@npts\endcsname}%
     \edef\er@N{\csname er@pt@\the\numexpr\er@npts-1\endcsname}}%
    {\def\er@lseg{1}%
     \edef\er@E{\csname er@pt@0\endcsname}%
     \edef\er@N{\csname er@pt@1\endcsname}}%
  \er@measure\er@E\er@N
  % position of the cardinality along the segment
  \er@ifeq{\er@cardplacement}{inline}{\def\er@p{0.5}}{%
    \er@ifempty{\er@cardpos}{%
      \ifdim\er@len pt<1pt \def\er@p{0.5}\else
        \pgfmathsetmacro\er@p{min(\er@carddist/\er@len, 0.45)}\fi}%
      {\edef\er@p{\er@cardpos}}%
    \er@ifeq{\er@cardend}{b}{\pgfmathsetmacro\er@p{1-\er@p}}{}}%
  % deferred placement? (all cardinalities beside the edge)
  \def\er@defer{0}%
  \er@ifempty{\er@cardtext}{}{\er@ifeq{\er@cardplacement}{inline}{}%
    {\def\er@defer{1}}}%
  % side of the cardinality / role (relative to the outward direction)
  \er@chooseside{\er@cardside}\let\er@cardleft\er@sideleft
  \er@ifeq{\er@cardside}{auto}{\edef\er@cardpref{\er@sideleft}}%
    {\edef\er@cardpref{\er@sideleft!}}% "!" = forced by the user
  \er@ifempty{\er@roleside}{\er@chooseside{auto}\let\er@roleleft\er@sideleft}%
    {\er@chooseside{\er@roleside}\let\er@roleleft\er@sideleft}%
  \er@ifeq{\er@cardend}{b}{% path runs towards the entity: flip sides
    \ifnum\er@cardleft=1 \def\er@cardleft{0}\else\def\er@cardleft{1}\fi
    \ifnum\er@roleleft=1 \def\er@roleleft{0}\else\def\er@roleleft{1}\fi}{}%
  \ifnum\er@cardleft=1 \def\er@cardauto{auto=left}\else\def\er@cardauto{auto=right}\fi
  \ifnum\er@roleleft=1 \def\er@roleauto{auto=left}\else\def\er@roleauto{auto=right}\fi
  % label nodes
  \def\er@nodes{}%
  \er@ifempty{\er@cardtext}{}{%
    \ifnum\er@defer=1
      \er@ifeq{\er@cardend}{b}{\pgfmathsetmacro\er@pt{max(\er@p-0.02,0)}}%
                              {\pgfmathsetmacro\er@pt{min(\er@p+0.02,1)}}%
      \edef\er@nodes{coordinate[pos=\er@p] (er@cp@\er@en)
        coordinate[pos=\er@pt] (er@ct@\er@en)}%
    \else
    \er@ifeq{\er@cardplacement}{inline}%
      {\edef\er@nodes{\unexpanded\expandafter{\er@nodes} node[er card,
         er card inline, pos=\er@p] {\unexpanded\expandafter{\er@cardtext}}}}%
      {\edef\er@nodes{\unexpanded\expandafter{\er@nodes} node[er card,
         pos=\er@p, \er@cardauto] {\unexpanded\expandafter{\er@cardtext}}}}%
    \fi}%
  \er@ifeq{\er@rolepos}{auto}{% keep the role clear of a mid-edge cardinality
    \er@ifeq{\er@cardplacement}{inline}{\er@ifempty{\er@cardtext}{\def\er@rolepos{0.5}}{%
      \er@ifeq{\er@cardend}{b}{\def\er@rolepos{0.75}}{\def\er@rolepos{0.25}}}}%
      {\def\er@rolepos{0.5}}}{}%
  \er@ifempty{\er@role}{}{%
    \edef\er@nodes{\unexpanded\expandafter{\er@nodes} node[er role,
      pos=\er@rolepos, \er@roleauto] {\unexpanded\expandafter{\er@role}}}}%
  % operation between the points
  \er@ifempty{\er@ortho}{\def\er@op{to}}{%
    \ifnum\er@npts=1 \let\er@op\er@ortho\else\def\er@op{to}\fi}%
  % assemble the path (with helper coordinates at both ends)
  \let\er@stub\@empty
  \ifx\er@crow\@empty\else\er@crowstub\fi
  \er@buildpath
  \ifx\er@stub\@empty\else      % the straight piece at the entity
    \er@ifeq{\er@stub}{b}%
      {\edef\er@pathtl{\unexpanded\expandafter{\er@pathtl} -- (er@h@\er@en)}}%
      {\edef\er@pathtl{(er@h@\er@en) -- \unexpanded\expandafter{\er@pathtl}}}%
  \fi
  \edef\er@do{\noexpand\draw[\er@edgestyle, er@user]
    \unexpanded\expandafter{\er@pathtl};}%
  \er@do
  \ifx\er@stub\@empty\else      % the edge leaves the entity along the stub
    \coordinate (er@e@\er@en @\er@stub 0) at (er@h@\er@en);
    \coordinate (er@e@\er@en @\er@stub 1) at (er@q@\er@en);
  \fi
  \ifx\er@crow\@empty\else\er@drawcrow\fi
  % remember the directions in which the edge leaves its two end nodes
  \er@idof\er@A\er@recordangle{\er@id}{er@e@\er@en @a0}{er@e@\er@en @a1}{\er@en}%
  \er@idof\er@B\er@recordangle{\er@id}{er@e@\er@en @b0}{er@e@\er@en @b1}{\er@en}%
  \ifnum\er@defer=1
    \er@ifeq{\er@cardend}{b}{\er@idof\er@B}{\er@idof\er@A}%
    \er@remember{cards}{\er@en}%
    \expandafter\xdef\csname\er@reg{card@\er@en @ent}\endcsname{\er@id}%
    \expandafter\xdef\csname\er@reg{card@\er@en @pref}\endcsname{\er@cardpref}%
    \expandafter\xdef\csname\er@reg{card@\er@en @text}\endcsname{%
      \unexpanded\expandafter{\er@cardtext}}%
  \fi}
\newcount\er@edgeno
% --- the path through P0 .. Pn, with the helper coordinates -> \er@pathtl
\def\er@buildpath{%
  \edef\er@pathtl{\csname er@pt@0\endcsname}%
  \er@i=0
  \loop\ifnum\er@i<\er@npts
    \advance\er@i by 1
    \edef\er@pathtl{\unexpanded\expandafter{\er@pathtl} \er@op\space}%
    \ifnum\er@i=1
      \edef\er@pathtl{\unexpanded\expandafter{\er@pathtl}%
        coordinate[pos=0] (er@e@\er@en @a0) coordinate[pos=0.1] (er@e@\er@en @a1) }%
    \fi
    \ifnum\er@i=\er@npts
      \edef\er@pathtl{\unexpanded\expandafter{\er@pathtl}%
        coordinate[pos=1] (er@e@\er@en @b0) coordinate[pos=0.9] (er@e@\er@en @b1) }%
    \fi
    \ifnum\er@i=\er@lseg\relax
      \edef\er@pathtl{\unexpanded\expandafter{\er@pathtl}%
        \unexpanded\expandafter{\er@nodes} }%
    \fi
    \edef\er@pathtl{\unexpanded\expandafter{\er@pathtl}%
      \csname er@pt@\the\er@i\endcsname}%
  \repeat}
% --- crow's foot: the edge meets the side of the entity at a right angle.  The
%  path is found once without drawing it, to learn where it meets the border (H).
%  The side there gives the normal; Q is H moved outwards along it.  The edge is
%  then drawn to Q, and a straight piece from Q to H carries the symbol.
\def\er@crowstub{%
  \let\er@savednodes\er@nodes\let\er@nodes\@empty
  \er@buildpath
  \edef\er@do{\noexpand\path[\er@edgestyle, er@user, draw=none, fill=none,
    every postaction/.style={draw=none}]
    \unexpanded\expandafter{\er@pathtl};}%
  \er@do
  \let\er@nodes\er@savednodes
  \er@ifeq{\er@cardend}{b}{\let\er@stubnode\er@bid}{\let\er@stubnode\er@aid}%
  \pgfpointanchor{\er@stubnode}{center}\pgfgetlastxy\er@cx\er@cy
  \pgfpointanchor{\er@stubnode}{east}\pgfgetlastxy\er@ex\er@tmpy
  \pgfpointanchor{\er@stubnode}{north}\pgfgetlastxy\er@tmpx\er@nty
  \pgfpointanchor{er@e@\er@en @\er@cardend 0}{center}\pgfgetlastxy\er@hx\er@hy
  \pgfmathsetmacro\er@hw{\er@ex-\er@cx}\pgfmathsetmacro\er@hh{\er@nty-\er@cy}%
  \ifdim\er@hw pt>0pt \ifdim\er@hh pt>0pt
    \pgfmathsetmacro\er@rx{abs(\er@hx-\er@cx)/\er@hw}%
    \pgfmathsetmacro\er@ry{abs(\er@hy-\er@cy)/\er@hh}%
    \ifdim\er@rx pt<\er@ry pt
      \def\er@nx{0}\ifdim\er@hy<\er@cy\relax \def\er@ny{-1}\else\def\er@ny{1}\fi
    \else
      \def\er@ny{0}\ifdim\er@hx<\er@cx\relax \def\er@nx{-1}\else\def\er@nx{1}\fi
    \fi
    \pgfmathsetmacro\er@sl{2.5*\er@val{crow length}}%
    \coordinate (er@h@\er@en) at (er@e@\er@en @\er@cardend 0);
    \coordinate (er@q@\er@en) at ($(er@h@\er@en)+(\er@nx*\er@sl pt,\er@ny*\er@sl pt)$);
    \er@ifeq{\er@cardend}{b}%
      {\expandafter\def\csname er@pt@\the\er@npts\endcsname{(er@q@\er@en)}}%
      {\expandafter\def\csname er@pt@0\endcsname{(er@q@\er@en)}}%
    \let\er@stub\er@cardend
  \fi\fi}

% --- place the deferred cardinalities -----------------------------------
%  For each card: theta = direction in which its edge leaves the entity.
%  gap left/right = angle to the next edge (or attribute tree) at that
