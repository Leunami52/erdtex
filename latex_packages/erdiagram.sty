\cs_new_protected:Npn \er@storerow #1
  {
    \cs_set:cpx { er@attrparent@ \int_use:N \er@nattrs } {#1}
    \int_compare:nNnT {#1} > { 0 }
      { \cs_set:cpx { er@attrlast@ #1 } { \int_use:N \er@nattrs } }
    \cs_set:cpx { er@attrkey@ \int_use:N \er@nattrs } { \l__er_iskey_tl }
    \cs_set:cpx { er@attrderived@ \int_use:N \er@nattrs } { \l__er_derived_tl }
    \cs_set:cpx { er@attrmulti@ \int_use:N \er@nattrs } { \l__er_multi_tl }
    \cs_set:cpn { er@attrcomposite@ \int_use:N \er@nattrs } { 0 }
    \cs_set:cpx { er@attrpx@ \int_use:N \er@nattrs } { \exp_not:V \l__er_px_tl }
    \cs_set:cpx { er@attrpy@ \int_use:N \er@nattrs } { \exp_not:V \l__er_py_tl }
    \cs_set:cpx { er@attrname@ \int_use:N \er@nattrs } { \exp_not:V \l__er_label_tl }
    \cs_set:cpx { er@attrsuffix@ \int_use:N \er@nattrs }
      {
        \tl_if_empty:NF \l__er_type_tl
          {
            \str_if_eq:VnT \er@showtypes { true }
              { \exp_not:N \er@typesuffix { \exp_not:V \l__er_type_tl } }
          }
      }
    \cs_set:cpx { er@attr@ \int_use:N \er@nattrs }
      {
        \str_if_eq:VnTF \l__er_iskey_tl { 1 }
          { \exp_not:N \er@keylabel { \int_use:N \er@nattrs } { \er@shown } }
          {
            \er@shown
            \exp_not:c { er@attrsuffix@ \int_use:N \er@nattrs }
