%  they can't collide with a document's own, and it needs no other package.
\NewDocumentEnvironment{relationalschema}{}{%
  \begin{itemize}\raggedright
  \let\relation\er@rs@relation\let\relationgroup\er@rs@group
  \let\col\er@rs@col\let\pkey\er@rs@pkey\let\fkey\er@rs@fkey\let\pfkey\er@rs@pfkey
}{\end{itemize}}
\def\er@rs@relation#1#2{\item #1~:~\{(#2)\}}
\def\er@rs@group#1{\item[]\textbf{#1}}
\def\er@rs@type#1{\if\relax\detokenize{#1}\relax\else~:~#1\fi}
\def\er@rs@col#1#2{#1\er@rs@type{#2}}
\def\er@rs@pkey#1#2{\underline{#1}\er@rs@type{#2}}
\def\er@rs@fkey#1#2{\textit{#1}\er@rs@type{#2}}
\def\er@rs@pfkey#1#2{\underline{\textit{#1}}\er@rs@type{#2}}

