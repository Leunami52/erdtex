%% <shared:extras> -- maintained in erdiagram.sty, copied by tools/sync_shared.py
\pgfkeys{
  /er/note/.is family, /er/note,
  .unknown/.code = {\er@forward{#1}},
  color/.code    = {\er@addtikz{text=#1}},
  colour/.forward to = /er/note/color,
}
\NewDocumentCommand\er@cmd@note{O{} d() m}{%
  \er@tikz{}\pgfqkeys{/er/note}{#1}\er@usetikz
  \IfNoValueTF{#2}{\node[er note, er@user] {#3};}%
                  {\node[er note, er@user] at (#2) {#3};}}

% \subdomain[color=blue!60, dotted, fill=blue!5]{Label}{(x1,y1) (x2,y2) ...}
%   two points = opposite corners of a rectangle, more = polygon.
%   The label box hangs from the first point (down and to the right).
\pgfkeys{
  /er/subdomain/.is family, /er/subdomain,
  .unknown/.code   = {\er@forward{#1}},
  color/.store in  = \er@sdcolor,
  colour/.forward to = /er/subdomain/color,
  dotted/.code     = {\er@ifeq{#1}{false}{\def\er@sddots{0}}{\def\er@sddots{1}}},
  dotted/.default  = true,
  fill/.store in   = \er@sdfill,
}
\NewDocumentCommand\er@cmd@subdomain{O{} m m}{%
  \begingroup
  \er@tikz{}\edef\er@sdcolor{\er@val{subdomain color}}%
  \def\er@sddots{0}\let\er@sdfill\@empty
  \pgfqkeys{/er/subdomain}{#1}\er@usetikz
  \er@parsevia{#3}%
  \ifnum\er@npts=2
    \edef\er@sdpath{\csname er@pt@1\endcsname rectangle \csname er@pt@2\endcsname}%
  \else
    \def\er@sdpath{}\er@k=0
    \loop\ifnum\er@k<\er@npts \advance\er@k by 1
      \edef\er@sdpath{\er@sdpath\ifnum\er@k>1 -- \fi\csname er@pt@\the\er@k\endcsname}%
    \repeat
    \edef\er@sdpath{\er@sdpath -- cycle}%
  \fi
  \begin{pgfonlayer}{background}
    \er@ifempty{\er@sdfill}{}{%
      \edef\er@do{\noexpand\fill[\er@sdfill, er@user] \er@sdpath;}\er@do}%
    \ifnum\er@sddots=1
      \edef\er@do{\noexpand\fill[pattern=dots, pattern color=\er@sdcolor,
        er@user] \er@sdpath;}\er@do
    \fi
    \edef\er@do{\noexpand\draw[draw=\er@sdcolor,
      line width=\er@val{subdomain line width}, er@user] \er@sdpath;}\er@do
    % label box with a tucked-in (chamfered) bottom-right corner
    \edef\er@first{\csname er@pt@1\endcsname}%
    \expandafter\er@sdlabelnode\expandafter{\er@first}{#2}{(er@sdlabel)}%
    \draw[draw=\er@sdcolor, line width=\er@val{subdomain line width},
          fill=white, line join=round]
      (er@sdlabel.north west) -- (er@sdlabel.north east)
      -- ($(er@sdlabel.south east)+(0,\er@val{subdomain tuck})$)
      -- ($(er@sdlabel.south east)+(-\er@val{subdomain tuck},0)$)
      -- (er@sdlabel.south west) -- cycle;
    \expandafter\er@sdlabelnode\expandafter{\er@first}{#2}{}%
  \end{pgfonlayer}
  \endgroup}

\def\er@sdlabelnode#1#2#3{%
  \node[inner xsep=\er@val{subdomain label hpad},
        inner ysep=\er@val{subdomain label vpad},
        font=\er@val{subdomain label font}, text=\er@sdcolor,
        anchor=north west] #3 at #1 {#2};}

% \grid(x1,y1)(x2,y2): helper grid with coordinate labels (background)
\NewDocumentCommand\er@cmd@grid{r() r()}{\er@grid{#1}{#2}}
\def\er@grid#1#2{%
  \begingroup
  \er@gridcorners#1,#2\@nil
  \begin{pgfonlayer}{background}
    \draw[step=1, \er@val{grid color}, very thin]
      (\er@gxa,\er@gya) grid (\er@gxb,\er@gyb);
    \foreach \er@gx in {\er@gxa,...,\er@gxb}
      \foreach \er@gy in {\er@gya,...,\er@gyb}
        \node[font=\tiny, text=\er@val{grid label color}, inner sep=0pt]
          at (\er@gx,\er@gy) {\er@gx,\er@gy};
  \end{pgfonlayer}
  \endgroup}
\def\er@gridcorners#1,#2,#3,#4\@nil{%
  \pgfmathtruncatemacro\er@gxa{min(#1,#3)}\pgfmathtruncatemacro\er@gxb{max(#1,#3)}%
  \pgfmathtruncatemacro\er@gya{min(#2,#4)}\pgfmathtruncatemacro\er@gyb{max(#2,#4)}}
% automatic grid over the whole picture (environment option "grid")
\def\er@autogrid{%
  \pgfpointanchor{current bounding box}{south west}\pgfgetlastxy\er@ax\er@ay
  \pgfpointanchor{current bounding box}{north east}\pgfgetlastxy\er@bx\er@by
  \pgfmathsetmacro\er@ax{floor(\er@ax/1cm)}\pgfmathsetmacro\er@ay{floor(\er@ay/1cm)}%
  \pgfmathsetmacro\er@bx{ceil(\er@bx/1cm)}\pgfmathsetmacro\er@by{ceil(\er@by/1cm)}%
  \er@grid{\er@ax,\er@ay}{\er@bx,\er@by}}

