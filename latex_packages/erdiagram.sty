        \tl_remove_once:Nn \l__er_label_tl { \} }
        \tl_trim_spaces:N \l__er_label_tl
      }
    \er@findparts
    \er@findposition
    \er@storerow {#2}
    \tl_if_empty:NF \l__er_body_tl
      {
        \cs_set:cpn { er@attrcomposite@ \int_use:N \er@nattrs } { 1 }
        \tl_set:Nx \l_tmpa_tl { \int_use:N \er@nattrs }
        \exp_args:NVV \er@attrlist \l__er_body_tl \l_tmpa_tl
      }
  }
% address{street, town} -> the name, and the parts in \l__er_body_tl.  Not for
% \textit{x}, x_{i} or 1{:}2.
\cs_new_protected:Npn \er@findparts
  {
    \exp_after:wN \er@compa \l__er_label_tl {} \er@nil
    \tl_trim_spaces:N \er@compname
    \tl_if_blank:VF \er@compbody
      {
        % (TeX has stripped the braces of the {} that was appended)
        \tl_if_empty:NT \er@comprest
          {
            \exp_args:Nnx \regex_match:nnF { \\ | [_\^]\s*\Z | \A\s*\Z } { \tl_to_str:N \er@compname }
              {
                \tl_set_eq:NN \l__er_body_tl \er@compbody
                \tl_set_eq:NN \l__er_label_tl \er@compname
