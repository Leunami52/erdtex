% #1: the row, #2: the name
\def\er@underlinekey#1#2{\underline{#2}\csname er@attrsuffix@#1\endcsname}
\let\er@keylabel\er@underlinekey
\def\er@partialkeylabel#1#2{%
  \expandafter\xdef\csname\er@reg{aown@er@kn\the\er@listno @#1}\endcsname{\er@attrowner}%
  \er@latekey{er@kn\the\er@listno @#1}{#2}{\csname er@attrsuffix@#1\endcsname}}
\newcount\er@listno
\ExplSyntaxOn
\cs_new_protected:Npn \er@steps #1 #2 #3 { \int_step_inline:nnn {#1} {#2} {#3} }
\ExplSyntaxOff
\def\er@compa#1#{\er@compb{#1}}
\def\er@compb#1#2#3\er@nil{\def\er@compname{#1}\def\er@compbody{#2}\def\er@comprest{#3}}

% --- one row of a list.  #1: its height relative to the origin of the list.
%  A part hangs below its composite attribute, on a line of its own.
\def\er@drawrow#1{%
  \edef\er@parent{\csname er@attrparent@\the\er@k\endcsname}%
  \ifnum\er@parent=0
    \def\er@base{0pt}%
  \else
    \pgfmathsetlengthmacro\er@base{\csname er@attrtick@\er@parent\endcsname+\er@rowside*\er@val{attr indent}}%
  \fi
  \pgfmathsetlengthmacro\er@x{\er@rowside*\er@atick}%
  \pgfmathsetlengthmacro\er@tickend{\er@base+\er@x}%
  \expandafter\xdef\csname er@attrtick@\the\er@k\endcsname{\er@tickend}%
  \expandafter\xdef\csname er@attrrowy@\the\er@k\endcsname{#1}%
  \draw[er edge] ($(\er@origin)+(\er@base,#1)$) -- ++(\er@x,0pt)
    node[er attr label, anchor=\er@lanchor, er@user] (er@kn\the\er@listno @\the\er@k)
      {\csname er@attr@\the\er@k\endcsname};
  \ifnum\er@parent=0 \else
    \edef\er@last{\csname er@attrlast@\er@parent\endcsname}%
    \ifnum\er@last=\er@k
      \pgfmathsetlengthmacro\er@ya{\csname er@attrrowy@\er@parent\endcsname-0.45*\er@aspread}%
      \draw[er edge] ($(\er@origin)+(\er@base,\er@ya)$) -- ($(\er@origin)+(\er@base,#1)$);
    \fi
  \fi}
% the last row that isn't a part -> \er@lastmain
\def\er@findlastmain{%
  \er@k=0
  \loop\ifnum\er@k<\er@nattrs
    \advance\er@k by 1
    \ifnum\csname er@attrparent@\the\er@k\endcsname=0 \edef\er@lastmain{\the\er@k}\fi
  \repeat}

% --- trunk layout: vertical spine with horizontal ticks ----------------
\def\er@trunk{%
  \er@ifeq{\er@aside}{left}{\def\er@ss{-1}\def\er@lanchor{east}}%
                           {\def\er@ss{1}\def\er@lanchor{west}}%
  \let\er@rowside\er@ss
  \def\er@origin{er@a0}%
  \er@findlastmain
  % the row furthest from the node that is not a part
  \ifnum\er@s=1 \edef\er@j{\the\numexpr\er@nattrs-1\relax}%
  \else \edef\er@j{\the\numexpr\er@lastmain-1\relax}\fi
  \pgfmathsetlengthmacro\er@len{\er@s*(\er@agap+\er@j*\er@aspread)}%
  \draw[er edge] (er@a0) -- ($(er@a0)+(0pt,\er@len)$);
  \er@k=0
  \loop\ifnum\er@k<\er@nattrs
    \advance\er@k by 1
    % reading order is always top to bottom
    \ifnum\er@s=1 \edef\er@j{\the\numexpr\er@nattrs-\er@k\relax}%
    \else \edef\er@j{\the\numexpr\er@k-1\relax}\fi
    \pgfmathsetlengthmacro\er@y{\er@s*(\er@agap+\er@j*\er@aspread)}%
    \er@drawrow{\er@y}%
  \repeat}

% --- bar layout: horizontal stem, vertical bar, ticks -------------------
\def\er@bar{%
  \ifnum\er@s=1 \def\er@lanchor{west}\else\def\er@lanchor{east}\fi
  \let\er@rowside\er@s
  \def\er@origin{er@b0}%
  \pgfmathsetlengthmacro\er@x{\er@s*\er@astem}%
  \path[draw=none] ($(er@a0)+(\er@x,0pt)$) coordinate (er@b0);
  \draw[er edge] (er@a0) -- (er@b0);
  % offset of the first and of the k-th attribute relative to the stem
  \er@ifeq{\er@aalign}{top}{\def\er@off##1{-(##1-1)*\er@aspread}}{%
  \er@ifeq{\er@aalign}{bottom}{\def\er@off##1{(\er@nattrs-##1)*\er@aspread}}{%
    \def\er@off##1{(\er@nattrs-1)*\er@aspread/2-(##1-1)*\er@aspread}}}%
  \er@findlastmain
  \pgfmathsetlengthmacro\er@ya{\er@off{1}}%
  % parts at the end may leave the stem below the last row that isn't one
  \pgfmathsetlengthmacro\er@yb{min(\er@off{\er@lastmain},0pt)}%
  \draw[er edge] ($(er@b0)+(0pt,\er@ya)$) -- ($(er@b0)+(0pt,\er@yb)$);
  \er@k=0
  \loop\ifnum\er@k<\er@nattrs
    \advance\er@k by 1
    \pgfmathsetlengthmacro\er@y{\er@off{\er@k}}%
    \er@drawrow{\er@y}%
  \repeat}

