% things to do at the end of each diagram
\def\er@atend{\er@forlist{chenlists}\er@placechen
  \er@placecards\er@placeconstraints\er@forlist{latekeys}\er@drawlatekey}
% --- attribute lists as ovals (attribute style=chen) ----------------------
%  Placed at the end of the diagram, when all edges are known:  the free directions
%  around the node are given out clockwise from the top, in the order of the list; an
%  oval that would overlap another moves further out.  The parts of a composite
%  attribute fan out behind it.  name@x/y fixes an oval, relative to what it belongs
%  to, in cm.  (desktop app: layout.layout_chen, which must stay the same)
\def\er@deferchen#1#2{%
  \er@gettype{#1}%
  \er@ifeq{\er@type}{isa}{\er@rule{attributes attached to the
    generalisation `#1'}}{}%
  \global\advance\er@listno by 1
  \expandafter\gdef\csname\er@reg{chen@\the\er@listno}\endcsname{{#1}{#2}}%
  \er@remember{chenlists}{\the\er@listno}}
\def\er@placechen#1{%
  \expandafter\expandafter\expandafter\er@placechen@
    \csname\er@reg{chen@#1}\endcsname{#1}}
\def\er@placechen@#1#2#3{%
  \begingroup
  \def\er@owner{#1}\er@listno=#3\relax
  \er@attrseq{#2}%
  \let\er@chused\@empty\let\er@chboxes\@empty
  \expandafter\ifx\csname\er@reg{list@angles@#1}\endcsname\relax\else
    \edef\er@tmpl{\csname\er@reg{list@angles@#1}\endcsname}%
    \@for\er@itemb:=\er@tmpl\do{\expandafter\er@chedge\er@itemb\@nil}%
  \fi
  \pgfpointanchor{#1}{center}%
  \pgfmathsetmacro\er@ox{\the\pgf@x}\pgfmathsetmacro\er@oy{\the\pgf@y}%
  \def\er@chauto{0}%
  \er@steps{1}{\er@nattrs}{\er@chprepare{##1}}%
  % as many free directions as there are ovals to place
  \er@steps{0}{23}{\expandafter\def\csname er@chsel@##1\endcsname{0}}%
  \er@steps{1}{\er@chauto}{\er@chpick}%
  \def\er@chj{0}%
  \er@steps{0}{23}{\er@chgive{##1}}%
  \def\er@chj{0}%
  \er@steps{1}{\er@nattrs}{\er@chrow{##1}}%
  \endgroup}
\def\er@chedge#1/#2\@nil{\edef\er@chused{\er@chused#2,}}
% sizes, the parts to fan out, the ovals with a place of their own
\def\er@chprepare#1{%
  \setbox0=\hbox{\pgfinterruptpicture\er@val{attr font}\csname er@attrname@#1\endcsname
    \csname er@attrsuffix@#1\endcsname\endpgfinterruptpicture}%
  \pgfmathsetmacro\er@tw{\the\wd0/2+2}%
  \pgfmathsetmacro\er@th{(\the\ht0+\the\dp0)/2+2}%
  \ifnum\csname er@attrcomposite@#1\endcsname=1
    \pgfmathsetmacro\er@hw{max(\er@tw,\er@val{attribute minimum width}/2)}%
    \pgfmathsetmacro\er@hh{max(\er@th,\er@val{attribute minimum height}/2)}%
  \else
    \pgfmathsetmacro\er@hw{max(1.41421*\er@tw,\er@val{attribute minimum width}/2)}%
    \pgfmathsetmacro\er@hh{max(1.41421*\er@th,\er@val{attribute minimum height}/2)}%
  \fi
  \expandafter\let\csname er@chhw@#1\endcsname\er@hw
  \expandafter\let\csname er@chhh@#1\endcsname\er@hh
  \edef\er@p{\csname er@attrparent@#1\endcsname}%
  \edef\er@px{\csname er@attrpx@#1\endcsname}%
  \expandafter\ifx\csname er@chparts@\er@p\endcsname\relax
    \expandafter\def\csname er@chparts@\er@p\endcsname{0}%
    \expandafter\def\csname er@chnext@\er@p\endcsname{0}%
  \fi
  \ifx\er@px\@empty
    \ifnum\er@p=0
      \edef\er@chauto{\the\numexpr\er@chauto+1\relax}%
    \else
      \expandafter\edef\csname er@chparts@\er@p\endcsname{%
        \the\numexpr\csname er@chparts@\er@p\endcsname+1\relax}%
    \fi
  \else
    \ifnum\er@p=0
      \pgfmathsetmacro\er@cx{\er@ox+\er@px*28.45274}%
      \pgfmathsetmacro\er@cy{\er@oy+\csname er@attrpy@#1\endcsname*28.45274}%
      \pgfmathsetmacro\er@ang{Mod(atan2(\csname er@attrpy@#1\endcsname,\er@px),360)}%
      \edef\er@chused{\er@chused\er@ang,}%
      \er@chaddbox{#1}%
    \fi
  \fi}
\def\er@chaddbox#1{%
  \edef\er@chboxes{\er@chboxes\er@cx/\er@cy/\csname er@chhw@#1\endcsname
    /\csname er@chhh@#1\endcsname,}}
% the next free direction: the candidate furthest from everything used so far
\def\er@chpick{%
  \def\er@bestscore{-1}\def\er@beststep{0}%
  \er@steps{0}{23}{\er@chtry{##1}}%
  \pgfmathtruncatemacro\er@cand{Mod(90-15*\er@beststep,360)}%
  \edef\er@chused{\er@chused\er@cand,}%
  \expandafter\edef\csname er@chsel@\er@beststep\endcsname{%
    \the\numexpr\csname er@chsel@\er@beststep\endcsname+1\relax}}
\def\er@chtry#1{%
  \pgfmathtruncatemacro\er@cand{Mod(90-15*#1,360)}%
  \def\er@score{180}%
  \@for\er@itemb:=\er@chused\do{\ifx\er@itemb\@empty\else
    \pgfmathsetmacro\er@d{min(Mod(\er@cand-\er@itemb,360),Mod(\er@itemb-\er@cand,360))}%
    \pgfmathsetmacro\er@score{min(\er@score,\er@d)}\fi}%
  \ifdim\er@score pt>\dimexpr\er@bestscore pt+0.01pt\relax
    \let\er@bestscore\er@score\def\er@beststep{#1}\fi}
% clockwise from the top: the j-th oval to place gets \er@chgiven@j
\def\er@chgive#1{%
  \er@steps{1}{\csname er@chsel@#1\endcsname}{%
    \edef\er@chj{\the\numexpr\er@chj+1\relax}%
    \pgfmathtruncatemacro\er@cand{Mod(90-15*#1,360)}%
    \expandafter\let\csname er@chgiven@\er@chj\endcsname\er@cand}}
% the distance from the centre of oval #1 to its border in direction \er@ang
\def\er@chradius#1{%
  \edef\er@hw{\csname er@chhw@#1\endcsname}\edef\er@hh{\csname er@chhh@#1\endcsname}%
  \ifnum\csname er@attrcomposite@#1\endcsname=1
    \pgfmathsetmacro\er@r{\er@hw*\er@hh/max(\er@hh*abs(cos(\er@ang)),\er@hw*abs(sin(\er@ang)))}%
  \else
    \pgfmathsetmacro\er@r{\er@hw*\er@hh/veclen(\er@hh*cos(\er@ang),\er@hw*sin(\er@ang))}%
  \fi}
\def\er@chrow#1{%
  \edef\er@p{\csname er@attrparent@#1\endcsname}%
  \edef\er@px{\csname er@attrpx@#1\endcsname}%
  \ifnum\er@p=0 \def\er@parent{\er@owner}\let\er@bx\er@ox\let\er@by\er@oy
  \else
    \def\er@parent{er@kn\the\er@listno @\er@p}%
    \edef\er@bx{\csname er@chx@\er@p\endcsname}\edef\er@by{\csname er@chy@\er@p\endcsname}%
  \fi
  \ifx\er@px\@empty
    \ifnum\er@p=0
      \edef\er@chj{\the\numexpr\er@chj+1\relax}%
      \edef\er@ang{\csname er@chgiven@\er@chj\endcsname}%
      \pgfpointanchor{\er@owner}{\er@ang}%
      \pgfmathsetmacro\er@sx{\the\pgf@x}\pgfmathsetmacro\er@sy{\the\pgf@y}%
    \else
      \edef\er@j{\csname er@chnext@\er@p\endcsname}%
      \expandafter\edef\csname er@chnext@\er@p\endcsname{\the\numexpr\er@j+1\relax}%
      \pgfmathsetmacro\er@ang{\csname er@chang@\er@p\endcsname
        +(\er@j-(\csname er@chparts@\er@p\endcsname-1)/2)*40}%
      \er@chradius\er@p
      \pgfmathsetmacro\er@sx{\er@bx+\er@r*cos(\er@ang)}%
      \pgfmathsetmacro\er@sy{\er@by+\er@r*sin(\er@ang)}%
    \fi
    \er@chradius{#1}%
    \pgfmathsetmacro\er@t{\er@val{chen dist}+\er@r}%
    \def\er@tries{0}%
    \er@chplace{#1}%
  \else
    \pgfmathsetmacro\er@cx{\er@bx+\er@px*28.45274}%
    \pgfmathsetmacro\er@cy{\er@by+\csname er@attrpy@#1\endcsname*28.45274}%
    \pgfmathsetmacro\er@ang{Mod(atan2(\csname er@attrpy@#1\endcsname,\er@px),360)}%
    \ifnum\er@p=0 \else\er@chaddbox{#1}\fi
  \fi
  \expandafter\let\csname er@chx@#1\endcsname\er@cx
  \expandafter\let\csname er@chy@#1\endcsname\er@cy
  \expandafter\let\csname er@chang@#1\endcsname\er@ang
  \er@chnode{#1}}
% further out as long as it overlaps an oval placed before
\def\er@chplace#1{%
  \pgfmathsetmacro\er@cx{\er@sx+\er@t*cos(\er@ang)}%
  \pgfmathsetmacro\er@cy{\er@sy+\er@t*sin(\er@ang)}%
  \def\er@hit{0}%
  \edef\er@hw{\csname er@chhw@#1\endcsname}\edef\er@hh{\csname er@chhh@#1\endcsname}%
  \@for\er@itemb:=\er@chboxes\do{\ifx\er@itemb\@empty\else
    \expandafter\er@chhit\er@itemb\@nil\fi}%
  \ifnum\er@hit=1
    \ifnum\er@tries<24
      \edef\er@tries{\the\numexpr\er@tries+1\relax}%
      \pgfmathsetmacro\er@t{\er@t+8.53582}%
      \er@chplace{#1}%
    \else\er@chaddbox{#1}\fi
  \else\er@chaddbox{#1}\fi}
\def\er@chhit#1/#2/#3/#4\@nil{%
  \pgfmathtruncatemacro\er@test{and(abs(\er@cx-#1)<\er@hw+#3,abs(\er@cy-#2)<\er@hh+#4)}%
  \ifnum\er@test=1 \def\er@hit{1}\fi}
\def\er@chnode#1{%
  \er@tikz{}%
  \ifnum\csname er@attrderived@#1\endcsname=1 \er@addtikz{dashed}\fi
  \ifnum\csname er@attrmulti@#1\endcsname=1 \er@addtikz{double, double distance=1.5pt}\fi
  \er@usetikz
  \ifnum\csname er@attrcomposite@#1\endcsname=1
    \def\er@astyle{er composite attribute}\else\def\er@astyle{er attribute}\fi
  \edef\er@name{er@kn\the\er@listno @#1}%
  \ifnum\csname er@attrkey@#1\endcsname=1
    \expandafter\xdef\csname\er@reg{aown@\er@name}\endcsname{\er@owner}%
    \def\er@label{\er@latekey{\er@name}{\csname er@attrname@#1\endcsname}%
      {\csname er@attrsuffix@#1\endcsname}}%
  \else
    \def\er@label{\csname er@attrname@#1\endcsname\csname er@attrsuffix@#1\endcsname}%
  \fi
  \node[\er@astyle, er@user] (\er@name) at (\er@cx pt,\er@cy pt) {\er@label};
  \draw[er edge] (\er@parent) -- (\er@name);}
% --- keys that may be partial --------------------------------------------
%  The key of a weak entity type has a dashed underline, unless that depends on
%  E alone: then it's globally unique.  What an entity depends on is often only
%  known after its attributes, so these underlines are drawn at the end of the
%  diagram.  #1: name of the node, #2: the key, #3: what follows it.
\newcount\er@lkn
\def\er@latekey#1#2#3{%
  \sbox0{#2}\sbox2{#3}%
  \global\advance\er@lkn by 1
  \xglobal\colorlet{er@lkc\the\er@lkn}{.}%
  \expandafter\xdef\csname\er@reg{lk@#1}\endcsname{%
    {\the\er@lkn}{\the\wd0}{\the\wd2}{\the\dp0}}%
  \er@remember{latekeys}{#1}%
  \usebox0\usebox2}
% -> \er@kowner: the element owning attribute #1 (through composite attributes)
\def\er@findowner#1{%
  \edef\er@kowner{#1}\count@=0
  \loop
    \advance\count@ by 1
    \expandafter\ifx\csname\er@reg{aown@\er@kowner}\endcsname\relax
      \count@=9
    \else
      \edef\er@kowner{\csname\er@reg{aown@\er@kowner}\endcsname}%
    \fi
  \ifnum\count@<9 \repeat}
\def\er@drawlatekey#1{%
  \expandafter\expandafter\expandafter\er@drawlatekey@
    \csname\er@reg{lk@#1}\endcsname{#1}}
\def\er@drawlatekey@#1#2#3#4#5{%
  \def\er@keydash{solid}%
  \er@findowner{#5}%
  \er@gettype\er@kowner
  \er@ifeq{\er@type}{entity}{\er@ifflag{weak@\er@kowner}{%
    \def\er@keydash{er partial key}%
    % double links, if there are any: over the others it can be the owner of something else
    \expandafter\ifx\csname\er@reg{wdbl@\er@kowner}\endcsname\relax
      \def\er@kdep{wdep}\else\def\er@kdep{wdbl}\fi
    \expandafter\ifx\csname\er@reg{\er@kdep @\er@kowner}\endcsname\relax\else
      \er@ifeq{\csname\er@reg{\er@kdep @\er@kowner}\endcsname}{E}{\def\er@keydash{solid}}{}%
    \fi}{}}{}%
  \pgfmathsetlengthmacro\er@xa{-(#2+#3)/2}%
  \pgfmathsetlengthmacro\er@xb{\er@xa+#2}%
  \pgfmathsetlengthmacro\er@ya{-#4-1.4pt}%
  \draw[line width=0.4pt, draw=er@lkc#1, \er@keydash]
    ($(#5.base)+(\er@xa,\er@ya)$) -- ($(#5.base)+(\er@xb,\er@ya)$);}
\def\er@placeconstraints{\er@forlist{isacons}\er@placeconstraint}
\def\er@placeconstraint#1{%
  \er@ifeq{\er@val{constraint style}}{words}{\er@sidesonlytrue}{\er@sidesonlyfalse}%
  \er@bestdir{#1}\er@sidesonlyfalse
  \node[er constraint, anchor=\er@oppanchor] at (#1.\er@bestpos)
    {\csname\er@reg{cons@#1}\endcsname};}
\def\er@localcommands{%
  \let\entity\er@cmd@entity
  \let\relationship\er@cmd@relationship
  \let\isa\er@cmd@isa
  \let\canbe\er@cmd@canbe
  \let\partof\er@cmd@partof
  \let\attribute\er@cmd@attribute
  \let\attributes\er@cmd@attributes
  \let\link\er@cmd@link
  \let\point\er@cmd@point
  \let\note\er@cmd@note
  \let\subdomain\er@cmd@subdomain
  \let\grid\er@cmd@grid
  \let\setup\er@setup}

%% <shared:environment> -- maintained in erdiagram.sty, copied by tools/sync_shared.py
\newsavebox\er@box
% sans serif: also for a \normalfont in the fonts of labels.  It follows \ersetup, the
% options and \setup, and only takes effect within a diagram.
\def\er@applysans{%
  \er@ifeq{\er@val{sans serif}}{true}%
    {\let\familydefault\sfdefault\def\er@sanson{1}\fontfamily{\familydefault}\selectfont}%
    {\ifx\er@sanson\@empty\else
       \let\familydefault\er@origfamily\let\er@sanson\@empty
       \fontfamily{\familydefault}\selectfont
     \fi}}
\def\er@setup#1{\ersetup{#1}\er@applysans}
\pgfkeys{
  /er/env/.is family, /er/env,
  grid/.code       = {\er@ifeq{#1}{false}{\def\er@envgrid{0}}{\def\er@envgrid{1}}},
  grid/.default    = true,
  width/.store in  = \er@envwidth,
  height/.store in = \er@envheight,
  max width/.store in = \er@envmaxwidth,
  max height/.store in = \er@envmaxheight,
  scale/.store in  = \er@envscale,
  checks/.code     = {\er@ifeq{#1}{false}{\def\er@envchecks{0}}{\def\er@envchecks{1}}},
  checks/.default  = true,
  % style keys (\ersetup) are accepted, everything else goes to TikZ
  .unknown/.code   = {%
    \pgfkeysifdefined{/er/\pgfkeyscurrentname/.@cmd}{\er@envpass{#1}}{%
    \pgfkeysifdefined{/er/\pgfkeyscurrentname}{\er@envpass{#1}}%
      {\er@forward{#1}}}},
}
\def\er@novalue{\pgfkeysnovalue}
\def\er@envpass#1{\def\er@tmpv{#1}%
  \ifx\er@tmpv\er@novalue
    \edef\er@tmp{\noexpand\pgfqkeys{/er}{\pgfkeyscurrentname}}%
  \else
    \edef\er@tmp{\noexpand\pgfqkeys{/er}{\pgfkeyscurrentname={\unexpanded{#1}}}}%
  \fi\er@tmp}
\def\er@begin#1{%
  \global\advance\er@diagramno by 1
  \er@tikz{}\def\er@envgrid{0}\def\er@envchecks{1}%
  \let\er@envwidth\@empty\let\er@envheight\@empty
  \let\er@envmaxwidth\@empty\let\er@envmaxheight\@empty\let\er@envscale\@empty
  \pgfqkeys{/er/env}{#1}%
  \let\er@origfamily\familydefault\let\er@sanson\@empty
  \er@applysans
  \tikzset{er@env/.style/.expanded={\the\er@tikz}}%
  \er@localcommands
  \def\er@resize{0}%
  \er@ifemptyx{\er@envwidth\er@envheight\er@envmaxwidth\er@envmaxheight\er@envscale}{}%
    {\def\er@resize{1}}%
  \ifnum\er@resize=1 \begin{lrbox}{\er@box}\fi
  % "every path" is reset: some packages (e.g. figchild) make every \path
  % visible, which would draw our invisible helper paths
  \begin{tikzpicture}[every path/.style={}, er@env]}
\def\er@end{%
  \er@atend
  \ifnum\er@envgrid=1 \er@autogrid\fi
  \ifnum\er@envchecks=1 \er@finalchecks\fi
  \end{tikzpicture}%
  \ifnum\er@resize=1
    \end{lrbox}%
    \er@fitbox
  \fi}
\newdimen\er@dima
% scale the finished picture: width/height set the size, "max width" and
% "max height" only shrink (the aspect ratio is always kept)
\def\er@fitbox{%
  \dimen@=\ht\er@box \advance\dimen@ by \dp\er@box
  \dimen@ii=\wd\er@box
  \def\er@scale{1}%
  \er@ifempty{\er@envscale}{}{\let\er@scale\er@envscale}%
  \er@ifempty{\er@envmaxwidth}{}{\setlength\er@dima{\er@envmaxwidth}%
    \pgfmathsetmacro\er@scale{min(\er@scale,\the\er@dima/\the\dimen@ii)}}%
  \er@ifempty{\er@envmaxheight}{}{\setlength\er@dima{\er@envmaxheight}%
    \pgfmathsetmacro\er@scale{min(\er@scale,\the\er@dima/\the\dimen@)}}%
  \er@ifempty{\er@envwidth}{}{\setlength\er@dima{\er@envwidth}%
    \pgfmathsetmacro\er@scale{\the\er@dima/\the\dimen@ii}}%
  \er@ifempty{\er@envheight}{}{\setlength\er@dima{\er@envheight}%
    \pgfmathsetmacro\er@scale{\the\er@dima/\the\dimen@}}%
  \scalebox{\er@scale}{\usebox\er@box}}

\NewDocumentEnvironment{erdiagram}{O{}}{\er@begin{#1}}{\er@end}

% \inputerdiagram[<environment options>]{<file>}
%   The file contains only the body of an erdiagram environment.
\NewDocumentCommand\inputerdiagram{O{} m}{%
  \IfFileExists{#2}%
    {\begin{erdiagram}[#1]\input{#2}\end{erdiagram}}%
    {\PackageError{erdiagram}{Diagram file `#2' not found}%
      {Check the path; it is relative to the main document.}}}

%% </shared:environment>

\endinput
