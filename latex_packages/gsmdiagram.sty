%  7.  THE ENVIRONMENT AND FILE INPUT
% ====================================================================
% things to do at the end of each diagram: labels of aggregations and
% groupings with "label pos=auto" go where there is the most room
\def\gsm@atend{\gsm@forlist{conlabels}\gsm@placeconlabel}
\def\gsm@placeconlabel#1{\gsm@bestdir{#1}%
  \node[gsm constructor label, anchor=\gsm@oppanchor] at (#1.\gsm@bestpos)
    {\csname\gsm@reg{conlabel@#1}\endcsname};}
\def\gsm@localcommands{%
  \let\abstract\gsm@cmd@abstract
  \let\representable\gsm@cmd@representable
  \let\subtype\gsm@cmd@subtype
  \let\aggregation\gsm@cmd@aggregation
  \let\grouping\gsm@cmd@grouping
  \let\point\gsm@cmd@point
  \let\attribute\gsm@cmd@attribute
  \let\multiattribute\gsm@cmd@multiattribute
  \let\component\gsm@cmd@component
  \let\generalization\gsm@cmd@generalization
  \let\specialization\gsm@cmd@specialization
  \let\link\gsm@cmd@link
  \let\note\gsm@cmd@note
  \let\subdomain\gsm@cmd@subdomain
  \let\grid\gsm@cmd@grid
  \let\setup\gsm@setup}

%% <shared:environment> -- maintained in erdiagram.sty, copied by tools/sync_shared.py
\newsavebox\gsm@box
% sans serif: also for a \normalfont in the fonts of labels.  It follows \gsmsetup, the
% options and \setup, and only takes effect within a diagram.
\def\gsm@applysans{%
  \gsm@ifeq{\gsm@val{sans serif}}{true}%
    {\let\familydefault\sfdefault\def\gsm@sanson{1}\fontfamily{\familydefault}\selectfont}%
    {\ifx\gsm@sanson\@empty\else
       \let\familydefault\gsm@origfamily\let\gsm@sanson\@empty
       \fontfamily{\familydefault}\selectfont
     \fi}}
\def\gsm@setup#1{\gsmsetup{#1}\gsm@applysans}
\pgfkeys{
  /gsm/env/.is family, /gsm/env,
  grid/.code       = {\gsm@ifeq{#1}{false}{\def\gsm@envgrid{0}}{\def\gsm@envgrid{1}}},
  grid/.default    = true,
  width/.store in  = \gsm@envwidth,
  height/.store in = \gsm@envheight,
  max width/.store in = \gsm@envmaxwidth,
  max height/.store in = \gsm@envmaxheight,
  scale/.store in  = \gsm@envscale,
  checks/.code     = {\gsm@ifeq{#1}{false}{\def\gsm@envchecks{0}}{\def\gsm@envchecks{1}}},
  checks/.default  = true,
  % style keys (\gsmsetup) are accepted, everything else goes to TikZ
  .unknown/.code   = {%
    \pgfkeysifdefined{/gsm/\pgfkeyscurrentname/.@cmd}{\gsm@envpass{#1}}{%
    \pgfkeysifdefined{/gsm/\pgfkeyscurrentname}{\gsm@envpass{#1}}%
      {\gsm@forward{#1}}}},
}
\def\gsm@novalue{\pgfkeysnovalue}
\def\gsm@envpass#1{\def\gsm@tmpv{#1}%
  \ifx\gsm@tmpv\gsm@novalue
    \edef\gsm@tmp{\noexpand\pgfqkeys{/gsm}{\pgfkeyscurrentname}}%
  \else
    \edef\gsm@tmp{\noexpand\pgfqkeys{/gsm}{\pgfkeyscurrentname={\unexpanded{#1}}}}%
  \fi\gsm@tmp}
\def\gsm@begin#1{%
  \global\advance\gsm@diagramno by 1
  \gsm@tikz{}\def\gsm@envgrid{0}\def\gsm@envchecks{1}%
  \let\gsm@envwidth\@empty\let\gsm@envheight\@empty
  \let\gsm@envmaxwidth\@empty\let\gsm@envmaxheight\@empty\let\gsm@envscale\@empty
  \pgfqkeys{/gsm/env}{#1}%
  \let\gsm@origfamily\familydefault\let\gsm@sanson\@empty
  \gsm@applysans
  \tikzset{gsm@env/.style/.expanded={\the\gsm@tikz}}%
  \gsm@localcommands
  \def\gsm@resize{0}%
  \gsm@ifemptyx{\gsm@envwidth\gsm@envheight\gsm@envmaxwidth\gsm@envmaxheight\gsm@envscale}{}%
    {\def\gsm@resize{1}}%
  \ifnum\gsm@resize=1 \begin{lrbox}{\gsm@box}\fi
  % "every path" is reset: some packages (e.g. figchild) make every \path
  % visible, which would draw our invisible helper paths
  \begin{tikzpicture}[every path/.style={}, gsm@env]}
\def\gsm@end{%
  \gsm@atend
  \ifnum\gsm@envgrid=1 \gsm@autogrid\fi
  \ifnum\gsm@envchecks=1 \gsm@finalchecks\fi
  \end{tikzpicture}%
  \ifnum\gsm@resize=1
    \end{lrbox}%
    \gsm@fitbox
  \fi}
\newdimen\gsm@dima
% scale the finished picture: width/height set the size, "max width" and
% "max height" only shrink (the aspect ratio is always kept)
\def\gsm@fitbox{%
  \dimen@=\ht\gsm@box \advance\dimen@ by \dp\gsm@box
  \dimen@ii=\wd\gsm@box
  \def\gsm@scale{1}%
  \gsm@ifempty{\gsm@envscale}{}{\let\gsm@scale\gsm@envscale}%
  \gsm@ifempty{\gsm@envmaxwidth}{}{\setlength\gsm@dima{\gsm@envmaxwidth}%
    \pgfmathsetmacro\gsm@scale{min(\gsm@scale,\the\gsm@dima/\the\dimen@ii)}}%
  \gsm@ifempty{\gsm@envmaxheight}{}{\setlength\gsm@dima{\gsm@envmaxheight}%
    \pgfmathsetmacro\gsm@scale{min(\gsm@scale,\the\gsm@dima/\the\dimen@)}}%
  \gsm@ifempty{\gsm@envwidth}{}{\setlength\gsm@dima{\gsm@envwidth}%
    \pgfmathsetmacro\gsm@scale{\the\gsm@dima/\the\dimen@ii}}%
  \gsm@ifempty{\gsm@envheight}{}{\setlength\gsm@dima{\gsm@envheight}%
    \pgfmathsetmacro\gsm@scale{\the\gsm@dima/\the\dimen@}}%
  \scalebox{\gsm@scale}{\usebox\gsm@box}}

\NewDocumentEnvironment{gsmdiagram}{O{}}{\gsm@begin{#1}}{\gsm@end}

% \inputgsmdiagram[<environment options>]{<file>}
%   The file contains only the body of an gsmdiagram environment.
\NewDocumentCommand\inputgsmdiagram{O{} m}{%
  \IfFileExists{#2}%
    {\begin{gsmdiagram}[#1]\input{#2}\end{gsmdiagram}}%
    {\PackageError{gsmdiagram}{Diagram file `#2' not found}%
      {Check the path; it is relative to the main document.}}}

%% </shared:environment>

\endinput
