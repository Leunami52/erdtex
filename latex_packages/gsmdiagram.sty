%% <shared:extras> -- maintained in erdiagram.sty, copied by tools/sync_shared.py
\pgfkeys{
  /gsm/note/.is family, /gsm/note,
  .unknown/.code = {\gsm@forward{#1}},
  color/.code    = {\gsm@addtikz{text=#1}},
  colour/.forward to = /gsm/note/color,
}
\NewDocumentCommand\gsm@cmd@note{O{} d() m}{%
  \gsm@tikz{}\pgfqkeys{/gsm/note}{#1}\gsm@usetikz
  \IfNoValueTF{#2}{\node[gsm note, gsm@user] {#3};}%
                  {\node[gsm note, gsm@user] at (#2) {#3};}}

% \subdomain[color=blue!60, dotted, fill=blue!5]{Label}{(x1,y1) (x2,y2) ...}
%   two points = opposite corners of a rectangle, more = polygon.
%   The label box hangs from the first point (down and to the right).
\pgfkeys{
  /gsm/subdomain/.is family, /gsm/subdomain,
  .unknown/.code   = {\gsm@forward{#1}},
  color/.store in  = \gsm@sdcolor,
  colour/.forward to = /gsm/subdomain/color,
  dotted/.code     = {\gsm@ifeq{#1}{false}{\def\gsm@sddots{0}}{\def\gsm@sddots{1}}},
  dotted/.default  = true,
  fill/.store in   = \gsm@sdfill,
}
\NewDocumentCommand\gsm@cmd@subdomain{O{} m m}{%
  \begingroup
  \gsm@tikz{}\edef\gsm@sdcolor{\gsm@val{subdomain color}}%
  \def\gsm@sddots{0}\let\gsm@sdfill\@empty
  \pgfqkeys{/gsm/subdomain}{#1}\gsm@usetikz
  \gsm@parsevia{#3}%
  \ifnum\gsm@npts=2
    \edef\gsm@sdpath{\csname gsm@pt@1\endcsname rectangle \csname gsm@pt@2\endcsname}%
  \else
    \def\gsm@sdpath{}\gsm@k=0
    \loop\ifnum\gsm@k<\gsm@npts \advance\gsm@k by 1
      \edef\gsm@sdpath{\gsm@sdpath\ifnum\gsm@k>1 -- \fi\csname gsm@pt@\the\gsm@k\endcsname}%
    \repeat
    \edef\gsm@sdpath{\gsm@sdpath -- cycle}%
  \fi
  \begin{pgfonlayer}{background}
    \gsm@ifempty{\gsm@sdfill}{}{%
      \edef\gsm@do{\noexpand\fill[\gsm@sdfill, gsm@user] \gsm@sdpath;}\gsm@do}%
    \ifnum\gsm@sddots=1
      \edef\gsm@do{\noexpand\fill[pattern=dots, pattern color=\gsm@sdcolor,
        gsm@user] \gsm@sdpath;}\gsm@do
    \fi
    \edef\gsm@do{\noexpand\draw[draw=\gsm@sdcolor,
      line width=\gsm@val{subdomain line width}, gsm@user] \gsm@sdpath;}\gsm@do
    % label box with a tucked-in (chamfered) bottom-right corner
    \edef\gsm@first{\csname gsm@pt@1\endcsname}%
    \expandafter\gsm@sdlabelnode\expandafter{\gsm@first}{#2}{(gsm@sdlabel)}%
    \draw[draw=\gsm@sdcolor, line width=\gsm@val{subdomain line width},
          fill=white, line join=round]
      (gsm@sdlabel.north west) -- (gsm@sdlabel.north east)
      -- ($(gsm@sdlabel.south east)+(0,\gsm@val{subdomain tuck})$)
      -- ($(gsm@sdlabel.south east)+(-\gsm@val{subdomain tuck},0)$)
      -- (gsm@sdlabel.south west) -- cycle;
    \expandafter\gsm@sdlabelnode\expandafter{\gsm@first}{#2}{}%
  \end{pgfonlayer}
  \endgroup}

\def\gsm@sdlabelnode#1#2#3{%
  \node[inner xsep=\gsm@val{subdomain label hpad},
        inner ysep=\gsm@val{subdomain label vpad},
        font=\gsm@val{subdomain label font}, text=\gsm@sdcolor,
        anchor=north west] #3 at #1 {#2};}

% \grid(x1,y1)(x2,y2): helper grid with coordinate labels (background)
\NewDocumentCommand\gsm@cmd@grid{r() r()}{\gsm@grid{#1}{#2}}
\def\gsm@grid#1#2{%
  \begingroup
  \gsm@gridcorners#1,#2\@nil
  \begin{pgfonlayer}{background}
    \draw[step=1, \gsm@val{grid color}, very thin]
      (\gsm@gxa,\gsm@gya) grid (\gsm@gxb,\gsm@gyb);
    \foreach \gsm@gx in {\gsm@gxa,...,\gsm@gxb}
      \foreach \gsm@gy in {\gsm@gya,...,\gsm@gyb}
        \node[font=\tiny, text=\gsm@val{grid label color}, inner sep=0pt]
          at (\gsm@gx,\gsm@gy) {\gsm@gx,\gsm@gy};
  \end{pgfonlayer}
  \endgroup}
\def\gsm@gridcorners#1,#2,#3,#4\@nil{%
  \pgfmathtruncatemacro\gsm@gxa{min(#1,#3)}\pgfmathtruncatemacro\gsm@gxb{max(#1,#3)}%
  \pgfmathtruncatemacro\gsm@gya{min(#2,#4)}\pgfmathtruncatemacro\gsm@gyb{max(#2,#4)}}
% automatic grid over the whole picture (environment option "grid")
\def\gsm@autogrid{%
  \pgfpointanchor{current bounding box}{south west}\pgfgetlastxy\gsm@ax\gsm@ay
  \pgfpointanchor{current bounding box}{north east}\pgfgetlastxy\gsm@bx\gsm@by
  \pgfmathsetmacro\gsm@ax{floor(\gsm@ax/1cm)}\pgfmathsetmacro\gsm@ay{floor(\gsm@ay/1cm)}%
  \pgfmathsetmacro\gsm@bx{ceil(\gsm@bx/1cm)}\pgfmathsetmacro\gsm@by{ceil(\gsm@by/1cm)}%
  \gsm@grid{\gsm@ax,\gsm@ay}{\gsm@bx,\gsm@by}}

