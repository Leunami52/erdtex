== problems
== relational schema
Relational schema
Notation: _name_ primary key, /name/ foreign key, _/name/_ both

A : {(_aId_ : integer, /bId/ : integer)}
B : {(_bId_ : integer, /aId/ : integer)}

Foreign keys
  A.bId -> B.bId
  B.aId -> A.aId

Not enforced by the schema
  each B has, in r, A: at least 1
  each A has, in q, B: at least 1

Notes
  2 data type(s) were guessed from attribute names (set them with 'name : type').

== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- note: 2 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS A CASCADE;
DROP TABLE IF EXISTS B CASCADE;

-- entity type B
CREATE TABLE B (
    bId  INTEGER NOT NULL,
    aId  INTEGER NOT NULL,
    CONSTRAINT pk_B PRIMARY KEY (bId)
);

-- entity type A
CREATE TABLE A (
    aId  INTEGER NOT NULL,
    bId  INTEGER NOT NULL,
    CONSTRAINT pk_A PRIMARY KEY (aId),
    CONSTRAINT fk_A_B FOREIGN KEY (bId) REFERENCES B (bId)
);

-- foreign keys of mutually referencing relations
ALTER TABLE B ADD CONSTRAINT fk_B_A FOREIGN KEY (aId) REFERENCES A (aId) DEFERRABLE INITIALLY DEFERRED;

-- not enforced by this schema (needs triggers or the application):
--   each B has, in r, A: at least 1
--   each A has, in q, B: at least 1

== SQL (SQLite)
-- SQLite schema, generated by ERDTeX
-- note: 2 data type(s) were guessed from attribute names (set them with 'name : type').

PRAGMA foreign_keys = ON;

DROP TABLE IF EXISTS A;
DROP TABLE IF EXISTS B;

-- entity type B
CREATE TABLE B (
    bId  INTEGER NOT NULL,
    aId  INTEGER NOT NULL,
    CONSTRAINT pk_B PRIMARY KEY (bId),
    CONSTRAINT fk_B_A FOREIGN KEY (aId) REFERENCES A (aId) DEFERRABLE INITIALLY DEFERRED
);

-- entity type A
CREATE TABLE A (
    aId  INTEGER NOT NULL,
    bId  INTEGER NOT NULL,
    CONSTRAINT pk_A PRIMARY KEY (aId),
    CONSTRAINT fk_A_B FOREIGN KEY (bId) REFERENCES B (bId)
);

-- not enforced by this schema (needs triggers or the application):
--   each B has, in r, A: at least 1
--   each A has, in q, B: at least 1

