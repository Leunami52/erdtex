== problems
== relational schema
Relational schema
Notation: _name_ primary key, /name/ foreign key, _/name/_ both

Person : {(_SSno_ : integer, Name : string, PostalAddress : string, EmailAddress : string, DateOfBirth : date)}
SeedDonor : {(_/SSno/_ : integer, category : string)}
Botanist : {(_/SSno/_ : integer)}
SeedPacket : {(_SerialNbr_ : string, /SwapNbr/ : string)}
SeedVault : {(_VaultID_ : integer)}
ViabilityRisk : {(_RiskID_ : integer, Name : string, Description : string)}
ActiveDonor : {(_/SSno/_ : integer, SeedType : string)}
PotentialDonor : {(_/SSno/_ : integer)}
SeedSwap : {(_SwapNbr_ : string, Date : date, Location : string, ZipCode : integer)}
PersonCategory : {(_/SSno/_ : integer, _category_ : string)}
fills : {(/BotanistSSno/ : integer, _/ActiveDonorSSno/_ : integer, _/SerialNbr/_ : string)}
SeedSwap_invitedTo_SeedDonor : {(_/SwapNbr/_ : string, _/SSno/_ : integer)}
SeedSwap_attends_SeedDonor : {(_/SwapNbr/_ : string, _/SSno/_ : integer)}
ViabilityRisk_has_ActiveDonor : {(_/RiskID/_ : integer, _/SSno/_ : integer)}
identifies : {(_/SerialNbr/_ : string, _/RiskID/_ : integer, /VaultID/ : integer)}

Foreign keys
  SeedDonor.SSno -> Person.SSno
  Botanist.SSno -> Person.SSno
  SeedPacket.SwapNbr -> SeedSwap.SwapNbr
  ActiveDonor.SSno -> SeedDonor.SSno
  PotentialDonor.SSno -> SeedDonor.SSno
  PersonCategory.SSno -> Person.SSno
  fills.BotanistSSno -> Botanist.SSno
  fills.ActiveDonorSSno -> ActiveDonor.SSno
  fills.SerialNbr -> SeedPacket.SerialNbr
  SeedSwap_invitedTo_SeedDonor.SwapNbr -> SeedSwap.SwapNbr
  SeedSwap_invitedTo_SeedDonor.SSno -> SeedDonor.SSno
  SeedSwap_attends_SeedDonor.SwapNbr -> SeedSwap.SwapNbr
  SeedSwap_attends_SeedDonor.SSno -> SeedDonor.SSno
  ViabilityRisk_has_ActiveDonor.RiskID -> ViabilityRisk.RiskID
  ViabilityRisk_has_ActiveDonor.SSno -> ActiveDonor.SSno
  identifies.SerialNbr -> SeedPacket.SerialNbr
  identifies.RiskID -> ViabilityRisk.RiskID
  identifies.VaultID -> SeedVault.VaultID

Unique (alternate keys)
  fills.(BotanistSSno, SerialNbr)

Allowed values
  SeedDonor.category in {Potential donor, Active donor}
  PersonCategory.category in {Seed donor, Botanist}

Decisions
  Generalisation Person ← Seed donor, Botanist (io): (1) Multiple relations + categorisation relation
  Generalisation Seed donor ← Potential donor, Active donor (cd): (1) Multiple relations + categorisation attribute
  Relationship fills (1:1:cn): Botanist – Active donor – Seed packet: Own relation, key: Active donor, Seed packet

Notes
  15 data type(s) were guessed from attribute names (set them with 'name : type').

== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- decision: Generalisation Person ← Seed donor, Botanist (io): (1) Multiple relations + categorisation relation
-- decision: Generalisation Seed donor ← Potential donor, Active donor (cd): (1) Multiple relations + categorisation attribute
-- decision: Relationship fills (1:1:cn): Botanist – Active donor – Seed packet: Own relation, key: Active donor, Seed packet
-- note: 15 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Identifies CASCADE;
DROP TABLE IF EXISTS ViabilityRisk_has_ActiveDonor CASCADE;
DROP TABLE IF EXISTS SeedSwap_attends_SeedDonor CASCADE;
DROP TABLE IF EXISTS SeedSwap_invitedTo_SeedDonor CASCADE;
DROP TABLE IF EXISTS Fills CASCADE;
DROP TABLE IF EXISTS PersonCategory CASCADE;
DROP TABLE IF EXISTS PotentialDonor CASCADE;
DROP TABLE IF EXISTS ActiveDonor CASCADE;
DROP TABLE IF EXISTS ViabilityRisk CASCADE;
DROP TABLE IF EXISTS SeedVault CASCADE;
DROP TABLE IF EXISTS SeedPacket CASCADE;
DROP TABLE IF EXISTS SeedSwap CASCADE;
DROP TABLE IF EXISTS Botanist CASCADE;
DROP TABLE IF EXISTS SeedDonor CASCADE;
DROP TABLE IF EXISTS Person CASCADE;

-- entity type Person
CREATE TABLE Person (
    SSno           INTEGER NOT NULL,
    Name           VARCHAR(255),
    postalAddress  VARCHAR(255),
    emailAddress   VARCHAR(255),
    dateOfBirth    DATE,
    CONSTRAINT pk_Person PRIMARY KEY (SSno)
);

-- entity type Seed donor, subtype of Person
CREATE TABLE SeedDonor (
    SSno      INTEGER NOT NULL,
    category  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_SeedDonor PRIMARY KEY (SSno),
    CONSTRAINT ck_SeedDonor_category CHECK (category IN ('Potential donor', 'Active donor')),
    CONSTRAINT fk_SeedDonor_Person FOREIGN KEY (SSno) REFERENCES Person (SSno) ON DELETE CASCADE
);

-- entity type Botanist, subtype of Person
CREATE TABLE Botanist (
    SSno  INTEGER NOT NULL,
    CONSTRAINT pk_Botanist PRIMARY KEY (SSno),
    CONSTRAINT fk_Botanist_Person FOREIGN KEY (SSno) REFERENCES Person (SSno) ON DELETE CASCADE
);

-- entity type Seed swap
CREATE TABLE SeedSwap (
    swapNbr   VARCHAR(255) NOT NULL,
    "Date"    DATE,
    Location  VARCHAR(255),
    zipCode   INTEGER,
    CONSTRAINT pk_SeedSwap PRIMARY KEY (swapNbr)
);

-- entity type Seed packet
CREATE TABLE SeedPacket (
    serialNbr  VARCHAR(255) NOT NULL,
    swapNbr    VARCHAR(255) NOT NULL,
    CONSTRAINT pk_SeedPacket PRIMARY KEY (serialNbr),
    CONSTRAINT fk_SeedPacket_SeedSwap FOREIGN KEY (swapNbr) REFERENCES SeedSwap (swapNbr)
);

-- entity type Seed vault
CREATE TABLE SeedVault (
    vaultID  INTEGER NOT NULL,
    CONSTRAINT pk_SeedVault PRIMARY KEY (vaultID)
);

-- entity type Viability risk
CREATE TABLE ViabilityRisk (
    riskID       INTEGER NOT NULL,
    Name         VARCHAR(255),
    Description  VARCHAR(255),
    CONSTRAINT pk_ViabilityRisk PRIMARY KEY (riskID)
);

-- entity type Active donor, subtype of Seed donor
CREATE TABLE ActiveDonor (
    SSno      INTEGER NOT NULL,
    seedType  VARCHAR(255),
    CONSTRAINT pk_ActiveDonor PRIMARY KEY (SSno),
    CONSTRAINT fk_ActiveDonor_SeedDonor FOREIGN KEY (SSno) REFERENCES SeedDonor (SSno) ON DELETE CASCADE
);

-- entity type Potential donor, subtype of Seed donor
CREATE TABLE PotentialDonor (
    SSno  INTEGER NOT NULL,
    CONSTRAINT pk_PotentialDonor PRIMARY KEY (SSno),
    CONSTRAINT fk_PotentialDonor_SeedDonor FOREIGN KEY (SSno) REFERENCES SeedDonor (SSno) ON DELETE CASCADE
);

-- categorisation of Person (overlapping)
CREATE TABLE PersonCategory (
    SSno      INTEGER NOT NULL,
    category  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_PersonCategory PRIMARY KEY (SSno, category),
    CONSTRAINT ck_PersonCategory_category CHECK (category IN ('Seed donor', 'Botanist')),
    CONSTRAINT fk_PersonCategory_Person FOREIGN KEY (SSno) REFERENCES Person (SSno) ON DELETE CASCADE
);

-- relationship fills (3-ary 1:1:cn)
CREATE TABLE Fills (
    BotanistSSno     INTEGER NOT NULL,
    ActiveDonorSSno  INTEGER NOT NULL,
    serialNbr        VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Fills PRIMARY KEY (ActiveDonorSSno, serialNbr),
    CONSTRAINT uq_Fills_BotanistSSno_s_6cf5c7 UNIQUE (BotanistSSno, serialNbr),
    CONSTRAINT fk_Fills_Botanist FOREIGN KEY (BotanistSSno) REFERENCES Botanist (SSno),
    CONSTRAINT fk_Fills_ActiveDonor FOREIGN KEY (ActiveDonorSSno) REFERENCES ActiveDonor (SSno),
    CONSTRAINT fk_Fills_SeedPacket FOREIGN KEY (serialNbr) REFERENCES SeedPacket (serialNbr)
);

-- relationship invited to (complex-complex)
CREATE TABLE SeedSwap_invitedTo_SeedDonor (
    swapNbr  VARCHAR(255) NOT NULL,
    SSno     INTEGER NOT NULL,
    CONSTRAINT pk_SeedSwap_invitedTo_S_17cf1b PRIMARY KEY (swapNbr, SSno),
    CONSTRAINT fk_SeedSwap_invitedTo_S_a3e19a FOREIGN KEY (swapNbr) REFERENCES SeedSwap (swapNbr),
    CONSTRAINT fk_SeedSwap_invitedTo_S_0c11f4 FOREIGN KEY (SSno) REFERENCES SeedDonor (SSno)
);

-- relationship attends (complex-complex)
CREATE TABLE SeedSwap_attends_SeedDonor (
    swapNbr  VARCHAR(255) NOT NULL,
    SSno     INTEGER NOT NULL,
    CONSTRAINT pk_SeedSwap_attends_SeedDonor PRIMARY KEY (swapNbr, SSno),
    CONSTRAINT fk_SeedSwap_attends_See_a6acbb FOREIGN KEY (swapNbr) REFERENCES SeedSwap (swapNbr),
    CONSTRAINT fk_SeedSwap_attends_See_3895c1 FOREIGN KEY (SSno) REFERENCES SeedDonor (SSno)
);

-- relationship has (complex-complex)
CREATE TABLE ViabilityRisk_has_ActiveDonor (
    riskID  INTEGER NOT NULL,
    SSno    INTEGER NOT NULL,
    CONSTRAINT pk_ViabilityRisk_has_Ac_be9aa5 PRIMARY KEY (riskID, SSno),
    CONSTRAINT fk_ViabilityRisk_has_Ac_fab281 FOREIGN KEY (riskID) REFERENCES ViabilityRisk (riskID),
    CONSTRAINT fk_ViabilityRisk_has_Ac_7f1f45 FOREIGN KEY (SSno) REFERENCES ActiveDonor (SSno)
);

-- relationship identifies (3-ary cn:cn:1)
CREATE TABLE Identifies (
    serialNbr  VARCHAR(255) NOT NULL,
    riskID     INTEGER NOT NULL,
    vaultID    INTEGER NOT NULL,
    CONSTRAINT pk_Identifies PRIMARY KEY (serialNbr, riskID),
    CONSTRAINT fk_Identifies_SeedPacket FOREIGN KEY (serialNbr) REFERENCES SeedPacket (serialNbr),
    CONSTRAINT fk_Identifies_ViabilityRisk FOREIGN KEY (riskID) REFERENCES ViabilityRisk (riskID),
    CONSTRAINT fk_Identifies_SeedVault FOREIGN KEY (vaultID) REFERENCES SeedVault (vaultID)
);

