== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- note: 14 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Bewerten CASCADE;
DROP TABLE IF EXISTS Kurse_aufbauen_Kurse CASCADE;
DROP TABLE IF EXISTS Lehrlinge_besuchen_Kurse CASCADE;
DROP TABLE IF EXISTS Gesellen CASCADE;
DROP TABLE IF EXISTS Kurse CASCADE;
DROP TABLE IF EXISTS Ausbilder CASCADE;
DROP TABLE IF EXISTS Lehrlinge CASCADE;

-- entity type Lehrlinge
CREATE TABLE Lehrlinge (
    LehrlingNr  INTEGER NOT NULL,
    Name        VARCHAR(255),
    Lehrjahr    VARCHAR(255),
    CONSTRAINT pk_Lehrlinge PRIMARY KEY (LehrlingNr)
);

-- entity type Ausbilder
CREATE TABLE Ausbilder (
    PersNr  INTEGER NOT NULL,
    Name    VARCHAR(255),
    Stufe   VARCHAR(255),
    Raum    VARCHAR(255),
    CONSTRAINT pk_Ausbilder PRIMARY KEY (PersNr)
);

-- entity type Kurse
CREATE TABLE Kurse (
    KursNr       INTEGER NOT NULL,
    Titel        VARCHAR(255),
    Stunden      VARCHAR(255),
    geleitetVon  INTEGER NOT NULL,
    CONSTRAINT pk_Kurse PRIMARY KEY (KursNr),
    CONSTRAINT fk_Kurse_Ausbilder FOREIGN KEY (geleitetVon) REFERENCES Ausbilder (PersNr)
);

-- entity type Gesellen
CREATE TABLE Gesellen (
    PersNr  INTEGER NOT NULL,
    Name    VARCHAR(255),
    Fach    VARCHAR(255),
    Boss    INTEGER NOT NULL,
    CONSTRAINT pk_Gesellen PRIMARY KEY (PersNr),
    CONSTRAINT fk_Gesellen_Ausbilder FOREIGN KEY (Boss) REFERENCES Ausbilder (PersNr)
);

-- relationship besuchen (complex-complex)
CREATE TABLE Lehrlinge_besuchen_Kurse (
    LehrlingNr  INTEGER NOT NULL,
    KursNr      INTEGER NOT NULL,
    CONSTRAINT pk_Lehrlinge_besuchen_Kurse PRIMARY KEY (LehrlingNr, KursNr),
    CONSTRAINT fk_Lehrlinge_besuchen_K_31a05b FOREIGN KEY (LehrlingNr) REFERENCES Lehrlinge (LehrlingNr),
    CONSTRAINT fk_Lehrlinge_besuchen_K_01ef59 FOREIGN KEY (KursNr) REFERENCES Kurse (KursNr)
);

-- relationship aufbauen (recursive, n:n)
CREATE TABLE Kurse_aufbauen_Kurse (
    Vorgaenger  INTEGER NOT NULL,
    Nachfolger  INTEGER NOT NULL,
    CONSTRAINT pk_Kurse_aufbauen_Kurse PRIMARY KEY (Vorgaenger, Nachfolger),
    CONSTRAINT fk_Kurse_aufbauen_Kurse_Kurse FOREIGN KEY (Vorgaenger) REFERENCES Kurse (KursNr),
    CONSTRAINT fk_Kurse_aufbauen_Kurse_Kur_2 FOREIGN KEY (Nachfolger) REFERENCES Kurse (KursNr)
);

-- relationship bewerten (3-ary n:n:1)
CREATE TABLE Bewerten (
    LehrlingNr  INTEGER NOT NULL,
    KursNr      INTEGER NOT NULL,
    PersNr      INTEGER NOT NULL,
    Note        VARCHAR(255),
    CONSTRAINT pk_Bewerten PRIMARY KEY (LehrlingNr, KursNr),
    CONSTRAINT fk_Bewerten_Lehrlinge FOREIGN KEY (LehrlingNr) REFERENCES Lehrlinge (LehrlingNr),
    CONSTRAINT fk_Bewerten_Kurse FOREIGN KEY (KursNr) REFERENCES Kurse (KursNr),
    CONSTRAINT fk_Bewerten_Ausbilder FOREIGN KEY (PersNr) REFERENCES Ausbilder (PersNr)
);

-- not enforced by this schema (needs triggers or the application):
--   each Lehrlinge has, in besuchen, Kurse: at least 1
--   each Kurse has, in besuchen, Lehrlinge: at least 1
--   each Ausbilder has, in leiten, Kurse: at least 1
--   each Ausbilder has, in helfen, Gesellen: at least 1
--   each Kurse has, in aufbauen, Kurse: at least 1

