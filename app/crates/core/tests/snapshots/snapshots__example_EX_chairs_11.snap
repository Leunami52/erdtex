-- PostgreSQL schema, generated by ERDTeX
-- decision: Relationship manages (1:1): Club – Club chair: Foreign key in Club
-- note: 4 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Club CASCADE;
DROP TABLE IF EXISTS ClubChair CASCADE;

-- entity type Club chair
CREATE TABLE ClubChair (
    memberNo  INTEGER NOT NULL,
    name      VARCHAR(255),
    CONSTRAINT pk_ClubChair PRIMARY KEY (memberNo)
);

-- entity type Club
CREATE TABLE Club (
    clubNo    INTEGER NOT NULL,
    clubName  VARCHAR(255),
    memberNo  INTEGER NOT NULL,
    CONSTRAINT pk_Club PRIMARY KEY (clubNo),
    CONSTRAINT uq_Club_memberNo UNIQUE (memberNo),
    CONSTRAINT fk_Club_ClubChair FOREIGN KEY (memberNo) REFERENCES ClubChair (memberNo)
);

