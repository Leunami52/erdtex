== problems
== relational schema
Relational schema
Notation: _name_ primary key, /name/ foreign key, _/name/_ both

Kurs-Art : {(_Art-Kuerzel_ : string, Art-Name : string)}
Seminar : {(_Seminar-Nr_ : integer, _Lehrjahr_ : string, Titel : string, Std : string, /Art-Kuerzel/ : string)}
Raum : {(_Raum-Id_ : integer, Name : string, Anz.Plaetze : string)}
Einheit : {(_/Seminar-Nr/_ : integer, _/Lehrjahr/_ : string, _EinheitNr_ : integer, EinheitName : string)}
Seminar_istIn_Raum : {(_/Seminar-Nr/_ : integer, _/Lehrjahr/_ : string, _/Raum-Id/_ : integer, _Datum_ : string, _Zeit-von_ : string, Zeit-bis : string)}

Foreign keys
  Seminar.Art-Kuerzel -> Kurs-Art.Art-Kuerzel
  Einheit.(Seminar-Nr, Lehrjahr) -> Seminar.(Seminar-Nr, Lehrjahr)
  Seminar_istIn_Raum.(Seminar-Nr, Lehrjahr) -> Seminar.(Seminar-Nr, Lehrjahr)
  Seminar_istIn_Raum.Raum-Id -> Raum.Raum-Id

Not enforced by the schema
  each Kurs-Art has, in hat, Seminar: at least 1
  each Seminar has, in ist in, Raum: at least 1
  each Raum has, in ist in, Seminar: at least 1
  each Seminar has, in hat, Einheit: at least 1

Notes
  'hat' is weak without E/Id; treated as an identification dependency (Id).
  14 data type(s) were guessed from attribute names (set them with 'name : type').

== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- note: 'hat' is weak without E/Id; treated as an identification dependency (Id).
-- note: 14 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Seminar_istIn_Raum CASCADE;
DROP TABLE IF EXISTS Einheit CASCADE;
DROP TABLE IF EXISTS Raum CASCADE;
DROP TABLE IF EXISTS Seminar CASCADE;
DROP TABLE IF EXISTS KursArt CASCADE;

-- entity type Kurs-Art
CREATE TABLE KursArt (
    artKuerzel  VARCHAR(255) NOT NULL,
    artName     VARCHAR(255),
    CONSTRAINT pk_KursArt PRIMARY KEY (artKuerzel)
);

-- entity type Seminar
CREATE TABLE Seminar (
    seminarNr   INTEGER NOT NULL,
    Lehrjahr    VARCHAR(255) NOT NULL,
    Titel       VARCHAR(255),
    Std         VARCHAR(255),
    artKuerzel  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Seminar PRIMARY KEY (seminarNr, Lehrjahr),
    CONSTRAINT fk_Seminar_KursArt FOREIGN KEY (artKuerzel) REFERENCES KursArt (artKuerzel)
);

-- entity type Raum
CREATE TABLE Raum (
    raumId      INTEGER NOT NULL,
    Name        VARCHAR(255),
    anzPlaetze  VARCHAR(255),
    CONSTRAINT pk_Raum PRIMARY KEY (raumId)
);

-- entity type Einheit (weak)
CREATE TABLE Einheit (
    seminarNr    INTEGER NOT NULL,
    Lehrjahr     VARCHAR(255) NOT NULL,
    EinheitNr    INTEGER NOT NULL,
    EinheitName  VARCHAR(255),
    CONSTRAINT pk_Einheit PRIMARY KEY (seminarNr, Lehrjahr, EinheitNr),
    CONSTRAINT fk_Einheit_Seminar FOREIGN KEY (seminarNr, Lehrjahr) REFERENCES Seminar (seminarNr, Lehrjahr) ON DELETE CASCADE
);

-- relationship ist in (complex-complex)
CREATE TABLE Seminar_istIn_Raum (
    seminarNr  INTEGER NOT NULL,
    Lehrjahr   VARCHAR(255) NOT NULL,
    raumId     INTEGER NOT NULL,
    Datum      VARCHAR(255) NOT NULL,
    zeitVon    VARCHAR(255) NOT NULL,
    zeitBis    VARCHAR(255),
    CONSTRAINT pk_Seminar_istIn_Raum PRIMARY KEY (seminarNr, Lehrjahr, raumId, Datum, zeitVon),
    CONSTRAINT fk_Seminar_istIn_Raum_Seminar FOREIGN KEY (seminarNr, Lehrjahr) REFERENCES Seminar (seminarNr, Lehrjahr),
    CONSTRAINT fk_Seminar_istIn_Raum_Raum FOREIGN KEY (raumId) REFERENCES Raum (raumId)
);

-- not enforced by this schema (needs triggers or the application):
--   each Kurs-Art has, in hat, Seminar: at least 1
--   each Seminar has, in ist in, Raum: at least 1
--   each Raum has, in ist in, Seminar: at least 1
--   each Seminar has, in hat, Einheit: at least 1

