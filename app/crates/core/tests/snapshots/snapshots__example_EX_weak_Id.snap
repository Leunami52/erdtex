== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- note: 7 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS BookingItem CASCADE;
DROP TABLE IF EXISTS Booking CASCADE;

-- entity type Booking
CREATE TABLE Booking (
    bookingNo  INTEGER NOT NULL,
    "date"     DATE,
    customer   VARCHAR(255),
    total      NUMERIC(12,2),
    CONSTRAINT pk_Booking PRIMARY KEY (bookingNo)
);

-- entity type Booking item (weak)
CREATE TABLE BookingItem (
    bookingNo      INTEGER NOT NULL,
    bookingItemNo  INTEGER NOT NULL,
    product        VARCHAR(255),
    price          NUMERIC(12,2),
    CONSTRAINT pk_BookingItem PRIMARY KEY (bookingNo, bookingItemNo),
    CONSTRAINT fk_BookingItem_Booking FOREIGN KEY (bookingNo) REFERENCES Booking (bookingNo) ON DELETE CASCADE
);

-- not enforced by this schema (needs triggers or the application):
--   each Booking has, in contains, Booking item: at least 1

