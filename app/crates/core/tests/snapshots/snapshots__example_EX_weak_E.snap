DROP TABLE IF EXISTS Club CASCADE;
DROP TABLE IF EXISTS Marina CASCADE;

-- entity type Marina
CREATE TABLE Marina (
    marinaID  INTEGER NOT NULL,
    name      VARCHAR(255),
    CONSTRAINT pk_Marina PRIMARY KEY (marinaID)
);

-- entity type Club (weak)
CREATE TABLE Club (
    clubID    INTEGER NOT NULL,
    name      VARCHAR(255),
    marinaID  INTEGER NOT NULL,
    CONSTRAINT pk_Club PRIMARY KEY (clubID),
    CONSTRAINT fk_Club_Marina FOREIGN KEY (marinaID) REFERENCES Marina (marinaID) ON DELETE CASCADE
);

