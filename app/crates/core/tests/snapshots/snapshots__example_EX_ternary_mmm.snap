== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- note: 7 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Vaccination CASCADE;
DROP TABLE IF EXISTS Traveller CASCADE;
DROP TABLE IF EXISTS Nurse CASCADE;
DROP TABLE IF EXISTS Vaccine CASCADE;

-- entity type Vaccine
CREATE TABLE Vaccine (
    vaccineNo  INTEGER NOT NULL,
    label      VARCHAR(255),
    CONSTRAINT pk_Vaccine PRIMARY KEY (vaccineNo)
);

-- entity type Nurse
CREATE TABLE Nurse (
    nurseNo  INTEGER NOT NULL,
    name     VARCHAR(255),
    CONSTRAINT pk_Nurse PRIMARY KEY (nurseNo)
);

-- entity type Traveller
CREATE TABLE Traveller (
    travellerNo  INTEGER NOT NULL,
    name         VARCHAR(255),
    CONSTRAINT pk_Traveller PRIMARY KEY (travellerNo)
);

-- relationship registered (3-ary m:m:m)
CREATE TABLE Vaccination (
    vaccineNo    INTEGER NOT NULL,
    nurseNo      INTEGER NOT NULL,
    travellerNo  INTEGER NOT NULL,
    "date"       DATE,
    CONSTRAINT pk_Vaccination PRIMARY KEY (vaccineNo, nurseNo, travellerNo),
    CONSTRAINT fk_Vaccination_Vaccine FOREIGN KEY (vaccineNo) REFERENCES Vaccine (vaccineNo),
    CONSTRAINT fk_Vaccination_Nurse FOREIGN KEY (nurseNo) REFERENCES Nurse (nurseNo),
    CONSTRAINT fk_Vaccination_Traveller FOREIGN KEY (travellerNo) REFERENCES Traveller (travellerNo)
);

