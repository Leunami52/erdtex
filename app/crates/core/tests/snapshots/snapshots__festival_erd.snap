== problems
== relational schema
Relational schema
Notation: _name_ primary key, /name/ foreign key, _/name/_ both

People:
  Person : {(_PersonID_ : integer, FirstName : string, LastName : string, Born : date, Email : string, category : string)}
  Volunteer : {(_/PersonID/_ : integer, Shifts : integer)}
  CrewMember : {(_/PersonID/_ : integer, Role : string)}
  Musician : {(_/PersonID/_ : integer, Instrument : string)}
  PersonCategory : {(_/PersonID/_ : integer, _category_ : string)}
  PersonPhone : {(_/PersonID/_ : integer, _Phone_ : string)}
Programme:
  Festival : {(_Code_ : string, Name : string)}
  Edition : {(_/Code/_ : string, _Year_ : integer, Motto : string)}
Outside of any box:
  Band : {(_BandID_ : integer, Name : string, Website : string)}
  Venue : {(_VenueID_ : integer, Street : string, City : string)}
  Stage : {(_StageID_ : integer, Capacity : integer, /VenueID/ : integer)}
  Musician_playsIn_Band : {(_/PersonID/_ : integer, _/BandID/_ : integer, Since : date)}
  Band_opensFor_Band : {(_/opener/_ : integer, _/headliner/_ : integer)}
  performs : {(_/BandID/_ : integer, _/Code/_ : string, _/Year/_ : integer, _/StageID/_ : integer, Start : time)}

Foreign keys
  Volunteer.PersonID -> Person.PersonID
  CrewMember.PersonID -> Person.PersonID
  Musician.PersonID -> Person.PersonID
  Edition.Code -> Festival.Code
  Stage.VenueID -> Venue.VenueID
  PersonCategory.PersonID -> Person.PersonID
  Musician_playsIn_Band.PersonID -> Musician.PersonID
  Musician_playsIn_Band.BandID -> Band.BandID
  Band_opensFor_Band.opener -> Band.BandID
  Band_opensFor_Band.headliner -> Band.BandID
  performs.BandID -> Band.BandID
  performs.(Code, Year) -> Edition.(Code, Year)
  performs.StageID -> Stage.StageID
  PersonPhone.PersonID -> Person.PersonID

Unique (alternate keys)
  Person.Email
  Band.Website

Allowed values
  Person.category in {Crew member, Musician}
  PersonCategory.category in {Volunteer}

Views (computing derived attributes)
  PersonView: all of Person, and FullName = FirstName || ' ' || LastName

Not enforced by the schema
  each Musician has, in plays in, Band: at least 1
  each Festival has, in held as, Edition: at least 1
  each Venue has, in part of, Stage: at least 1

Decisions
  Generalisation Person ← Volunteer (io): (1) Multiple relations + categorisation relation
  Generalisation Person ← Crew member, Musician (cd): (1) Multiple relations + categorisation attribute

Notes
  derived attribute Person.Full name is not stored
  12 data type(s) were guessed from attribute names (set them with 'name : type').

== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- decision: Generalisation Person ← Volunteer (io): (1) Multiple relations + categorisation relation
-- decision: Generalisation Person ← Crew member, Musician (cd): (1) Multiple relations + categorisation attribute
-- note: derived attribute Person.Full name is not stored
-- note: 12 data type(s) were guessed from attribute names (set them with 'name : type').

DROP VIEW IF EXISTS PersonView;
DROP TABLE IF EXISTS PersonPhone CASCADE;
DROP TABLE IF EXISTS Performs CASCADE;
DROP TABLE IF EXISTS Band_opensFor_Band CASCADE;
DROP TABLE IF EXISTS Musician_playsIn_Band CASCADE;
DROP TABLE IF EXISTS PersonCategory CASCADE;
DROP TABLE IF EXISTS Stage CASCADE;
DROP TABLE IF EXISTS Venue CASCADE;
DROP TABLE IF EXISTS Edition CASCADE;
DROP TABLE IF EXISTS Festival CASCADE;
DROP TABLE IF EXISTS Band CASCADE;
DROP TABLE IF EXISTS Musician CASCADE;
DROP TABLE IF EXISTS CrewMember CASCADE;
DROP TABLE IF EXISTS Volunteer CASCADE;
DROP TABLE IF EXISTS Person CASCADE;

-- entity type Person
-- box: People
CREATE TABLE Person (
    personID   INTEGER NOT NULL,
    firstName  VARCHAR(255),
    lastName   VARCHAR(255),
    Born       DATE,
    Email      VARCHAR(255),
    category   VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Person PRIMARY KEY (personID),
    CONSTRAINT uq_Person_Email UNIQUE (Email),
    CONSTRAINT ck_Person_category CHECK (category IN ('Crew member', 'Musician'))
);

-- entity type Volunteer, subtype of Person
-- box: People
CREATE TABLE Volunteer (
    personID  INTEGER NOT NULL,
    Shifts    INTEGER,
    CONSTRAINT pk_Volunteer PRIMARY KEY (personID),
    CONSTRAINT fk_Volunteer_Person FOREIGN KEY (personID) REFERENCES Person (personID) ON DELETE CASCADE
);

-- entity type Crew member, subtype of Person
-- box: People
CREATE TABLE CrewMember (
    personID  INTEGER NOT NULL,
    Role      VARCHAR(255),
    CONSTRAINT pk_CrewMember PRIMARY KEY (personID),
    CONSTRAINT fk_CrewMember_Person FOREIGN KEY (personID) REFERENCES Person (personID) ON DELETE CASCADE
);

-- entity type Musician, subtype of Person
-- box: People
CREATE TABLE Musician (
    personID    INTEGER NOT NULL,
    Instrument  VARCHAR(255),
    CONSTRAINT pk_Musician PRIMARY KEY (personID),
    CONSTRAINT fk_Musician_Person FOREIGN KEY (personID) REFERENCES Person (personID) ON DELETE CASCADE
);

-- entity type Band
CREATE TABLE Band (
    bandID   INTEGER NOT NULL,
    Name     VARCHAR(255),
    Website  VARCHAR(255),
    CONSTRAINT pk_Band PRIMARY KEY (bandID),
    CONSTRAINT uq_Band_Website UNIQUE (Website)
);

-- entity type Festival
-- box: Programme
CREATE TABLE Festival (
    Code  VARCHAR(255) NOT NULL,
    Name  VARCHAR(255),
    CONSTRAINT pk_Festival PRIMARY KEY (Code)
);

-- entity type Edition (weak)
-- box: Programme
CREATE TABLE Edition (
    Code   VARCHAR(255) NOT NULL,
    Year   INTEGER NOT NULL,
    Motto  VARCHAR(255),
    CONSTRAINT pk_Edition PRIMARY KEY (Code, Year),
    CONSTRAINT fk_Edition_Festival FOREIGN KEY (Code) REFERENCES Festival (Code) ON DELETE CASCADE
);

-- entity type Venue
CREATE TABLE Venue (
    venueID  INTEGER NOT NULL,
    Street   VARCHAR(255),
    City     VARCHAR(255),
    CONSTRAINT pk_Venue PRIMARY KEY (venueID)
);

-- entity type Stage
CREATE TABLE Stage (
    stageID   INTEGER NOT NULL,
    Capacity  INTEGER,
    venueID   INTEGER NOT NULL,
    CONSTRAINT pk_Stage PRIMARY KEY (stageID),
    CONSTRAINT fk_Stage_Venue FOREIGN KEY (venueID) REFERENCES Venue (venueID)
);

-- categorisation of Person (overlapping)
-- box: People
CREATE TABLE PersonCategory (
    personID  INTEGER NOT NULL,
    category  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_PersonCategory PRIMARY KEY (personID, category),
    CONSTRAINT ck_PersonCategory_category CHECK (category IN ('Volunteer')),
    CONSTRAINT fk_PersonCategory_Person FOREIGN KEY (personID) REFERENCES Person (personID) ON DELETE CASCADE
);

-- relationship plays in (complex-complex)
CREATE TABLE Musician_playsIn_Band (
    personID  INTEGER NOT NULL,
    bandID    INTEGER NOT NULL,
    Since     DATE,
    CONSTRAINT pk_Musician_playsIn_Band PRIMARY KEY (personID, bandID),
    CONSTRAINT fk_Musician_playsIn_Ban_69a50c FOREIGN KEY (personID) REFERENCES Musician (personID),
    CONSTRAINT fk_Musician_playsIn_Band_Band FOREIGN KEY (bandID) REFERENCES Band (bandID)
);

-- relationship opens for (recursive, cn:cn)
CREATE TABLE Band_opensFor_Band (
    opener     INTEGER NOT NULL,
    headliner  INTEGER NOT NULL,
    CONSTRAINT pk_Band_opensFor_Band PRIMARY KEY (opener, headliner),
    CONSTRAINT fk_Band_opensFor_Band_Band FOREIGN KEY (opener) REFERENCES Band (bandID),
    CONSTRAINT fk_Band_opensFor_Band_Band_2 FOREIGN KEY (headliner) REFERENCES Band (bandID)
);

-- relationship performs (3-ary cn:n:cn)
CREATE TABLE Performs (
    bandID   INTEGER NOT NULL,
    Code     VARCHAR(255) NOT NULL,
    Year     INTEGER NOT NULL,
    stageID  INTEGER NOT NULL,
    "Start"  TIME,
    CONSTRAINT pk_Performs PRIMARY KEY (bandID, Code, Year, stageID),
    CONSTRAINT fk_Performs_Band FOREIGN KEY (bandID) REFERENCES Band (bandID),
    CONSTRAINT fk_Performs_Edition FOREIGN KEY (Code, Year) REFERENCES Edition (Code, Year),
    CONSTRAINT fk_Performs_Stage FOREIGN KEY (stageID) REFERENCES Stage (stageID)
);

-- multi-valued attribute Person.Phone
-- box: People
CREATE TABLE PersonPhone (
    personID  INTEGER NOT NULL,
    Phone     VARCHAR(255) NOT NULL,
    CONSTRAINT pk_PersonPhone PRIMARY KEY (personID, Phone),
    CONSTRAINT fk_PersonPhone_Person FOREIGN KEY (personID) REFERENCES Person (personID) ON DELETE CASCADE
);

-- derived attributes; the formulas are written as in the diagram
CREATE VIEW PersonView AS SELECT t.*, (FirstName || ' ' || LastName) AS fullName FROM Person t;

-- not enforced by this schema (needs triggers or the application):
--   each Musician has, in plays in, Band: at least 1
--   each Festival has, in held as, Edition: at least 1
--   each Venue has, in part of, Stage: at least 1

