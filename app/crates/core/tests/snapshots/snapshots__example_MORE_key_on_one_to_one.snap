== problems
== relational schema
Relational schema
Notation: _name_ primary key, /name/ foreign key, _/name/_ both

A : {(_aId_ : integer)}
B : {(_bId_ : integer)}
A_h_B : {(_/aId/_ : integer, /bId/ : integer, _since_ : datetime)}

Foreign keys
  A_h_B.aId -> A.aId
  A_h_B.bId -> B.bId

Unique (alternate keys)
  A_h_B.(bId, since)

Not enforced by the schema
  each A has, in h, B: at least 1
  each B has, in h, A: at least 1

Notes
  'h' has key attributes, so it always gets an own relation.
  3 data type(s) were guessed from attribute names (set them with 'name : type').

== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- note: 'h' has key attributes, so it always gets an own relation.
-- note: 3 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS A_h_B CASCADE;
DROP TABLE IF EXISTS B CASCADE;
DROP TABLE IF EXISTS A CASCADE;

-- entity type A
CREATE TABLE A (
    aId  INTEGER NOT NULL,
    CONSTRAINT pk_A PRIMARY KEY (aId)
);

-- entity type B
CREATE TABLE B (
    bId  INTEGER NOT NULL,
    CONSTRAINT pk_B PRIMARY KEY (bId)
);

-- relationship h (1:1)
CREATE TABLE A_h_B (
    aId    INTEGER NOT NULL,
    bId    INTEGER NOT NULL,
    since  TIMESTAMP NOT NULL,
    CONSTRAINT pk_A_h_B PRIMARY KEY (aId, since),
    CONSTRAINT uq_A_h_B_bId_since UNIQUE (bId, since),
    CONSTRAINT fk_A_h_B_A FOREIGN KEY (aId) REFERENCES A (aId),
    CONSTRAINT fk_A_h_B_B FOREIGN KEY (bId) REFERENCES B (bId)
);

-- not enforced by this schema (needs triggers or the application):
--   each A has, in h, B: at least 1
--   each B has, in h, A: at least 1

