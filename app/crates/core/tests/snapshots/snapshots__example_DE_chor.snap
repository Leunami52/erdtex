== problems
== relational schema
Relational schema
Notation: _name_ primary key, /name/ foreign key, _/name/_ both

Chor : {(_ChorId_ : integer, Name : string)}
Auftritt : {(_AuftrittId_ : integer, Datum : string, Auftrittstitel : string, /OrtId/ : integer)}
Lied : {(_LiedId_ : integer, Titel : string, /TexterId/ : integer)}
Texter : {(_TexterId_ : integer, Name : string)}
Ort : {(_OrtId_ : integer, Bezeichnung : string)}
singt : {(_/ChorId/_ : integer, _/AuftrittId/_ : integer, _/LiedId/_ : integer, Position : string)}

Foreign keys
  Auftritt.OrtId -> Ort.OrtId
  Lied.TexterId -> Texter.TexterId
  singt.ChorId -> Chor.ChorId
  singt.AuftrittId -> Auftritt.AuftrittId
  singt.LiedId -> Lied.LiedId

Not enforced by the schema
  each Texter has, in schreibt, Lied: at least 1
  each Ort has, in findet statt, Auftritt: at least 1

Notes
  12 data type(s) were guessed from attribute names (set them with 'name : type').

== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- note: 12 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Singt CASCADE;
DROP TABLE IF EXISTS Lied CASCADE;
DROP TABLE IF EXISTS Texter CASCADE;
DROP TABLE IF EXISTS Auftritt CASCADE;
DROP TABLE IF EXISTS Ort CASCADE;
DROP TABLE IF EXISTS Chor CASCADE;

-- entity type Chor
CREATE TABLE Chor (
    ChorId  INTEGER NOT NULL,
    Name    VARCHAR(255),
    CONSTRAINT pk_Chor PRIMARY KEY (ChorId)
);

-- entity type Ort
CREATE TABLE Ort (
    OrtId        INTEGER NOT NULL,
    Bezeichnung  VARCHAR(255),
    CONSTRAINT pk_Ort PRIMARY KEY (OrtId)
);

-- entity type Auftritt
CREATE TABLE Auftritt (
    AuftrittId      INTEGER NOT NULL,
    Datum           VARCHAR(255),
    Auftrittstitel  VARCHAR(255),
    OrtId           INTEGER NOT NULL,
    CONSTRAINT pk_Auftritt PRIMARY KEY (AuftrittId),
    CONSTRAINT fk_Auftritt_Ort FOREIGN KEY (OrtId) REFERENCES Ort (OrtId)
);

-- entity type Texter
CREATE TABLE Texter (
    TexterId  INTEGER NOT NULL,
    Name      VARCHAR(255),
    CONSTRAINT pk_Texter PRIMARY KEY (TexterId)
);

-- entity type Lied
CREATE TABLE Lied (
    LiedId    INTEGER NOT NULL,
    Titel     VARCHAR(255),
    TexterId  INTEGER NOT NULL,
    CONSTRAINT pk_Lied PRIMARY KEY (LiedId),
    CONSTRAINT fk_Lied_Texter FOREIGN KEY (TexterId) REFERENCES Texter (TexterId)
);

-- relationship singt (3-ary n:n:n)
CREATE TABLE Singt (
    ChorId      INTEGER NOT NULL,
    AuftrittId  INTEGER NOT NULL,
    LiedId      INTEGER NOT NULL,
    Position    VARCHAR(255),
    CONSTRAINT pk_Singt PRIMARY KEY (ChorId, AuftrittId, LiedId),
    CONSTRAINT fk_Singt_Chor FOREIGN KEY (ChorId) REFERENCES Chor (ChorId),
    CONSTRAINT fk_Singt_Auftritt FOREIGN KEY (AuftrittId) REFERENCES Auftritt (AuftrittId),
    CONSTRAINT fk_Singt_Lied FOREIGN KEY (LiedId) REFERENCES Lied (LiedId)
);

-- not enforced by this schema (needs triggers or the application):
--   each Texter has, in schreibt, Lied: at least 1
--   each Ort has, in findet statt, Auftritt: at least 1

