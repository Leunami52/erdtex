-- entity type Person
CREATE TABLE Person (
    personID   INTEGER NOT NULL,
    firstName  VARCHAR(255),
    lastName   VARCHAR(255),
    CONSTRAINT pk_Person PRIMARY KEY (personID)
);

-- entity type Member, subtype of Person
-- box: HR
CREATE TABLE Member (
    personID           INTEGER NOT NULL,
    socialSecurityNbr  VARCHAR(255),
    houseNbr           VARCHAR(255),
    Street             VARCHAR(255),
    postalCode         INTEGER,
    Region             VARCHAR(255),
    Function           VARCHAR(255),
    Password           VARCHAR(255),
    "Authorization"    VARCHAR(255),
    CONSTRAINT pk_Member PRIMARY KEY (personID),
    CONSTRAINT fk_Member_Person FOREIGN KEY (personID) REFERENCES Person (personID) ON DELETE CASCADE
);

-- entity type Constants
CREATE TABLE Constants (
    ID     INTEGER NOT NULL,
    Name   VARCHAR(255),
    Value  VARCHAR(255),
    CONSTRAINT pk_Constants PRIMARY KEY (ID)
);

-- entity type Inventory mgmt. team
-- box: HR
CREATE TABLE InventoryMgmtTeam (
    teamID  INTEGER NOT NULL,
    Name    VARCHAR(255),
    CONSTRAINT pk_InventoryMgmtTeam PRIMARY KEY (teamID)
);

-- entity type Client
-- box: Customers
CREATE TABLE Client (
    clientID      INTEGER NOT NULL,
    creditRating  VARCHAR(255),
    emailAddress  VARCHAR(255),
    category      VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Client PRIMARY KEY (clientID),
    CONSTRAINT ck_Client_category CHECK (category IN ('Shopper', 'Merchant'))
);

-- entity type Invoice
-- box: Sales
CREATE TABLE Invoice (
    invoiceNbr      VARCHAR(255) NOT NULL,
    dateOfIssue     DATE NOT NULL,
    timeForPayment  NUMERIC(12,2),
    timeOfPayment   NUMERIC(12,2),
    CONSTRAINT pk_Invoice PRIMARY KEY (invoiceNbr, dateOfIssue)
);

-- entity type Purchase order
-- box: Sales
CREATE TABLE PurchaseOrder (
    bookingID             INTEGER NOT NULL,
    deliveryDate          DATE,
    deliveryAddress       VARCHAR(255),
    Password              VARCHAR(255),
    deliveryInstructions  VARCHAR(255),
    invoiceNbr            VARCHAR(255) NOT NULL,
    dateOfIssue           DATE NOT NULL,
    CONSTRAINT pk_PurchaseOrder PRIMARY KEY (bookingID),
    CONSTRAINT uq_PurchaseOrder_invoic_7d6f62 UNIQUE (invoiceNbr, dateOfIssue),
    CONSTRAINT fk_PurchaseOrder_Invoice FOREIGN KEY (invoiceNbr, dateOfIssue) REFERENCES Invoice (invoiceNbr, dateOfIssue)
);

-- entity type Sale unit
-- box: Inventory
CREATE TABLE SaleUnit (
    articleCode              INTEGER NOT NULL,
    Name                     VARCHAR(255),
    wholesalerPurchasePrice  NUMERIC(12,2),
    shopperSalePrice         NUMERIC(12,2),
    merchantSalePrice        NUMERIC(12,2),
    category                 VARCHAR(255) NOT NULL,
    CONSTRAINT pk_SaleUnit PRIMARY KEY (articleCode),
    CONSTRAINT ck_SaleUnit_category CHECK (category IN ('Article', 'Special offer'))
);

-- entity type Log entry
-- box: LoggingSubdomain
CREATE TABLE LogEntry (
    sessionID            INTEGER NOT NULL,
    "Date"               DATE,
    Time                 TIME,
    actionType           VARCHAR(255),
    concernsPersonID     INTEGER NOT NULL,
    performedByPersonID  INTEGER NOT NULL,
    clientID             INTEGER NOT NULL,
    invoiceNbr           VARCHAR(255) NOT NULL,
    dateOfIssue          DATE NOT NULL,
    bookingID            INTEGER NOT NULL,
    articleCode          INTEGER NOT NULL,
    CONSTRAINT pk_LogEntry PRIMARY KEY (sessionID),
    CONSTRAINT fk_LogEntry_Person FOREIGN KEY (concernsPersonID) REFERENCES Person (personID),
    CONSTRAINT fk_LogEntry_Person_2 FOREIGN KEY (performedByPersonID) REFERENCES Person (personID),
    CONSTRAINT fk_LogEntry_Client FOREIGN KEY (clientID) REFERENCES Client (clientID),
    CONSTRAINT fk_LogEntry_Invoice FOREIGN KEY (invoiceNbr, dateOfIssue) REFERENCES Invoice (invoiceNbr, dateOfIssue),
    CONSTRAINT fk_LogEntry_PurchaseOrder FOREIGN KEY (bookingID) REFERENCES PurchaseOrder (bookingID),
    CONSTRAINT fk_LogEntry_SaleUnit FOREIGN KEY (articleCode) REFERENCES SaleUnit (articleCode)
);

-- entity type Special offer, subtype of Sale unit
-- box: Inventory
CREATE TABLE SpecialOffer (
    articleCode         INTEGER NOT NULL,
    includedItemsCount  INTEGER,
    CONSTRAINT pk_SpecialOffer PRIMARY KEY (articleCode),
    CONSTRAINT fk_SpecialOffer_SaleUnit FOREIGN KEY (articleCode) REFERENCES SaleUnit (articleCode) ON DELETE CASCADE
);

-- entity type Article, subtype of Sale unit
-- box: Inventory
CREATE TABLE Article (
    articleCode  INTEGER NOT NULL,
    CONSTRAINT pk_Article PRIMARY KEY (articleCode),
    CONSTRAINT fk_Article_SaleUnit FOREIGN KEY (articleCode) REFERENCES SaleUnit (articleCode) ON DELETE CASCADE
);

-- entity type Sale inventory item
-- box: Inventory
CREATE TABLE SaleInventoryItem (
    itemID      INTEGER NOT NULL,
    Name        VARCHAR(255),
    stockCount  INTEGER,
    Weight      REAL,
    "Size"      REAL,
    CONSTRAINT pk_SaleInventoryItem PRIMARY KEY (itemID)
);

-- entity type Shopper, subtype of Person, subtype of Client
-- box: Customers
CREATE TABLE Shopper (
    personID  INTEGER NOT NULL,
    aaa       VARCHAR(255),
    clientID  INTEGER NOT NULL,
    CONSTRAINT pk_Shopper PRIMARY KEY (personID),
    CONSTRAINT uq_Shopper_clientID UNIQUE (clientID),
    CONSTRAINT fk_Shopper_Person FOREIGN KEY (personID) REFERENCES Person (personID) ON DELETE CASCADE,
    CONSTRAINT fk_Shopper_Client FOREIGN KEY (clientID) REFERENCES Client (clientID) ON DELETE CASCADE
);

-- entity type Merchant, subtype of Client
-- box: Customers
CREATE TABLE Merchant (
    clientID       INTEGER NOT NULL,
    merchantID     INTEGER NOT NULL,
    sectorOfTrade  VARCHAR(255),
    CONSTRAINT pk_Merchant PRIMARY KEY (clientID),
    CONSTRAINT uq_Merchant_merchantID UNIQUE (merchantID),
    CONSTRAINT fk_Merchant_Client FOREIGN KEY (clientID) REFERENCES Client (clientID) ON DELETE CASCADE
);

-- entity type Credit card (weak)
-- box: Customers
CREATE TABLE CreditCard (
    cardNbr       VARCHAR(255) NOT NULL,
    validityDate  DATE,
    clientID      INTEGER NOT NULL,
    CONSTRAINT pk_CreditCard PRIMARY KEY (cardNbr),
    CONSTRAINT fk_CreditCard_Client FOREIGN KEY (clientID) REFERENCES Client (clientID) ON DELETE CASCADE
);

-- entity type Phone contact (weak)
-- box: Customers
CREATE TABLE PhoneContact (
    contactID  INTEGER NOT NULL,
    phoneNbr   VARCHAR(255),
    clientID   INTEGER NOT NULL,
    CONSTRAINT pk_PhoneContact PRIMARY KEY (contactID),
    CONSTRAINT fk_PhoneContact_Client FOREIGN KEY (clientID) REFERENCES Client (clientID) ON DELETE CASCADE
);

-- entity type Payment option (weak)
-- box: Sales
CREATE TABLE PaymentOption (
    optionID  INTEGER NOT NULL,
    category  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_PaymentOption PRIMARY KEY (optionID),
    CONSTRAINT ck_PaymentOption_category CHECK (category IN ('Credit card opt.', 'Pay on delivery opt.'))
);

-- entity type Credit card opt., subtype of Payment option
-- box: Sales
CREATE TABLE CreditCardOpt (
    optionID  INTEGER NOT NULL,
    cardNbr   VARCHAR(255) NOT NULL,
    CONSTRAINT pk_CreditCardOpt PRIMARY KEY (optionID),
    CONSTRAINT fk_CreditCardOpt_PaymentOption FOREIGN KEY (optionID) REFERENCES PaymentOption (optionID) ON DELETE CASCADE,
    CONSTRAINT fk_CreditCardOpt_CreditCard FOREIGN KEY (cardNbr) REFERENCES CreditCard (cardNbr)
);

-- entity type Pay on delivery opt., subtype of Payment option
-- box: Sales
CREATE TABLE PayOnDeliveryOpt (
    optionID   INTEGER NOT NULL,
    contactID  INTEGER NOT NULL,
    CONSTRAINT pk_PayOnDeliveryOpt PRIMARY KEY (optionID),
    CONSTRAINT fk_PayOnDeliveryOpt_Pay_30a94c FOREIGN KEY (optionID) REFERENCES PaymentOption (optionID) ON DELETE CASCADE,
    CONSTRAINT fk_PayOnDeliveryOpt_Pho_78ff3e FOREIGN KEY (contactID) REFERENCES PhoneContact (contactID)
);

-- entity type Sales discount (weak)
-- box: Sales
CREATE TABLE SalesDiscount (
    bookingID         INTEGER NOT NULL,
    discountPosition  VARCHAR(255) NOT NULL,
    Amount            NUMERIC(12,2),
    typeAbsRel        VARCHAR(255),
    CONSTRAINT pk_SalesDiscount PRIMARY KEY (bookingID, discountPosition),
    CONSTRAINT fk_SalesDiscount_PurchaseOrder FOREIGN KEY (bookingID) REFERENCES PurchaseOrder (bookingID) ON DELETE CASCADE
);

-- entity type Booking item (weak)
-- box: Sales
CREATE TABLE BookingItem (
    bookingID            INTEGER NOT NULL,
    positionNbr          VARCHAR(255) NOT NULL,
    Quantity             INTEGER,
    unitPriceAtPurchase  VARCHAR(255),
    articleCode          INTEGER NOT NULL,
    CONSTRAINT pk_BookingItem PRIMARY KEY (bookingID, positionNbr),
    CONSTRAINT fk_BookingItem_PurchaseOrder FOREIGN KEY (bookingID) REFERENCES PurchaseOrder (bookingID) ON DELETE CASCADE,
    CONSTRAINT fk_BookingItem_SaleUnit FOREIGN KEY (articleCode) REFERENCES SaleUnit (articleCode)
);

-- entity type Log detail (weak)
-- box: LoggingSubdomain
CREATE TABLE LogDetail (
    detailSq   VARCHAR(255) NOT NULL,
    fieldName  VARCHAR(255),
    oldValue   VARCHAR(255),
    newValue   VARCHAR(255),
    sessionID  INTEGER NOT NULL,
    CONSTRAINT pk_LogDetail PRIMARY KEY (detailSq),
    CONSTRAINT fk_LogDetail_LogEntry FOREIGN KEY (sessionID) REFERENCES LogEntry (sessionID) ON DELETE CASCADE
);

-- entity type Special condition
-- box: Inventory
CREATE TABLE SpecialCondition (
    conditionID     INTEGER NOT NULL,
    Description     VARCHAR(255),
    conditionType   VARCHAR(255),
    conditionValue  VARCHAR(255),
    CONSTRAINT pk_SpecialCondition PRIMARY KEY (conditionID)
);

-- categorisation of Person (overlapping)
CREATE TABLE PersonCategory (
    personID  INTEGER NOT NULL,
    category  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_PersonCategory PRIMARY KEY (personID, category),
    CONSTRAINT ck_PersonCategory_category CHECK (category IN ('Member', 'Shopper')),
    CONSTRAINT fk_PersonCategory_Person FOREIGN KEY (personID) REFERENCES Person (personID) ON DELETE CASCADE
);

-- relationship part of (complex-complex)
-- box: HR
CREATE TABLE Member_partOf_InventoryMgmtTeam (
    personID  INTEGER NOT NULL,
    teamID    INTEGER NOT NULL,
    CONSTRAINT pk_Member_partOf_Invent_b8482f PRIMARY KEY (personID, teamID),
    CONSTRAINT fk_Member_partOf_Invent_6f1718 FOREIGN KEY (personID) REFERENCES Member (personID),
    CONSTRAINT fk_Member_partOf_Invent_fc13a9 FOREIGN KEY (teamID) REFERENCES InventoryMgmtTeam (teamID)
);

-- relationship updates (complex-complex)
-- box: HR
CREATE TABLE InventoryMgmtTeam_updates_SaleInventoryItem (
    teamID  INTEGER NOT NULL,
    itemID  INTEGER NOT NULL,
    CONSTRAINT pk_InventoryMgmtTeam_up_4a4c27 PRIMARY KEY (teamID, itemID),
    CONSTRAINT fk_InventoryMgmtTeam_up_5c7207 FOREIGN KEY (teamID) REFERENCES InventoryMgmtTeam (teamID),
    CONSTRAINT fk_InventoryMgmtTeam_up_5fc8ef FOREIGN KEY (itemID) REFERENCES SaleInventoryItem (itemID)
);

-- relationship part of (complex-complex)
-- box: Inventory
CREATE TABLE SaleInventoryItem_partOf_SaleUnit (
    itemID       INTEGER NOT NULL,
    articleCode  INTEGER NOT NULL,
    CONSTRAINT pk_SaleInventoryItem_pa_8ee06d PRIMARY KEY (itemID, articleCode),
    CONSTRAINT fk_SaleInventoryItem_pa_883bf3 FOREIGN KEY (itemID) REFERENCES SaleInventoryItem (itemID),
    CONSTRAINT fk_SaleInventoryItem_pa_77c36e FOREIGN KEY (articleCode) REFERENCES SaleUnit (articleCode)
);

-- relationship requires (complex-complex)
-- box: Inventory
CREATE TABLE SpecialOffer_requires_SpecialCondition (
    articleCode  INTEGER NOT NULL,
    conditionID  INTEGER NOT NULL,
    CONSTRAINT pk_SpecialOffer_require_ee3b4c PRIMARY KEY (articleCode, conditionID),
    CONSTRAINT fk_SpecialOffer_require_78f858 FOREIGN KEY (articleCode) REFERENCES SpecialOffer (articleCode),
    CONSTRAINT fk_SpecialOffer_require_47417b FOREIGN KEY (conditionID) REFERENCES SpecialCondition (conditionID)
);

-- relationship chooses (3-ary 1:1:1)
-- box: Sales
CREATE TABLE Chooses (
    bookingID  INTEGER NOT NULL,
    optionID   INTEGER NOT NULL,
    clientID   INTEGER NOT NULL,
    CONSTRAINT pk_Chooses PRIMARY KEY (optionID, clientID),
    CONSTRAINT uq_Chooses_bookingID_clientID UNIQUE (bookingID, clientID),
    CONSTRAINT uq_Chooses_bookingID_optionID UNIQUE (bookingID, optionID),
    CONSTRAINT fk_Chooses_PurchaseOrder FOREIGN KEY (bookingID) REFERENCES PurchaseOrder (bookingID),
    CONSTRAINT fk_Chooses_PaymentOption FOREIGN KEY (optionID) REFERENCES PaymentOption (optionID),
    CONSTRAINT fk_Chooses_Client FOREIGN KEY (clientID) REFERENCES Client (clientID)
);

