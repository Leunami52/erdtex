== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- note: 'held in' has key attributes, so it always gets an own relation.
-- note: 3 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Workshop_heldIn_Room CASCADE;
DROP TABLE IF EXISTS Room CASCADE;
DROP TABLE IF EXISTS Workshop CASCADE;

-- entity type Workshop
CREATE TABLE Workshop (
    workshopId  INTEGER NOT NULL,
    CONSTRAINT pk_Workshop PRIMARY KEY (workshopId)
);

-- entity type Room
CREATE TABLE Room (
    roomId  INTEGER NOT NULL,
    CONSTRAINT pk_Room PRIMARY KEY (roomId)
);

-- relationship held in (single-complex)
CREATE TABLE Workshop_heldIn_Room (
    workshopId  INTEGER NOT NULL,
    roomId      INTEGER NOT NULL,
    "date"      DATE NOT NULL,
    CONSTRAINT pk_Workshop_heldIn_Room PRIMARY KEY (workshopId, "date"),
    CONSTRAINT fk_Workshop_heldIn_Room_ceb23e FOREIGN KEY (workshopId) REFERENCES Workshop (workshopId),
    CONSTRAINT fk_Workshop_heldIn_Room_Room FOREIGN KEY (roomId) REFERENCES Room (roomId)
);

-- not enforced by this schema (needs triggers or the application):
--   each Workshop has, in held in, Room: at least 1
--   each Room has, in held in, Workshop: at least 1

