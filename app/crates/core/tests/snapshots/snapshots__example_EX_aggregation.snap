== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- decision: Relationship part of (1:1): Sailboat – Hull: Foreign key in Sailboat
-- note: 6 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Sail CASCADE;
DROP TABLE IF EXISTS Sailboat CASCADE;
DROP TABLE IF EXISTS Hull CASCADE;

-- entity type Hull
CREATE TABLE Hull (
    hullNo  INTEGER NOT NULL,
    type    VARCHAR(255),
    CONSTRAINT pk_Hull PRIMARY KEY (hullNo)
);

-- entity type Sailboat
CREATE TABLE Sailboat (
    boatNo  INTEGER NOT NULL,
    label   VARCHAR(255),
    hullNo  INTEGER NOT NULL,
    CONSTRAINT pk_Sailboat PRIMARY KEY (boatNo),
    CONSTRAINT uq_Sailboat_hullNo UNIQUE (hullNo),
    CONSTRAINT fk_Sailboat_Hull FOREIGN KEY (hullNo) REFERENCES Hull (hullNo)
);

-- entity type Sail
CREATE TABLE Sail (
    sailNo    INTEGER NOT NULL,
    diameter  DOUBLE PRECISION,
    boatNo    INTEGER NOT NULL,
    CONSTRAINT pk_Sail PRIMARY KEY (sailNo),
    CONSTRAINT fk_Sail_Sailboat FOREIGN KEY (boatNo) REFERENCES Sailboat (boatNo)
);

-- not enforced by this schema (needs triggers or the application):
--   each Sailboat has, in part of, Sail: at least 1
--   each Hull has, in part of, Sailboat: at least 1

