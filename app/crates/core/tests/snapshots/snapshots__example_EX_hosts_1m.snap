DROP TABLE IF EXISTS Member CASCADE;
DROP TABLE IF EXISTS Club CASCADE;

-- entity type Club
CREATE TABLE Club (
    clubNo  INTEGER NOT NULL,
    name    VARCHAR(255),
    CONSTRAINT pk_Club PRIMARY KEY (clubNo)
);

-- entity type Member
CREATE TABLE Member (
    memberNo  INTEGER NOT NULL,
    name      VARCHAR(255),
    clubNo    INTEGER NOT NULL,
    CONSTRAINT pk_Member PRIMARY KEY (memberNo),
    CONSTRAINT fk_Member_Club FOREIGN KEY (clubNo) REFERENCES Club (clubNo)
);

