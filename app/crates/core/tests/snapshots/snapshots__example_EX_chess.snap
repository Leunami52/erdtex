== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- decision: Relationship plays Chess (1:1:m:m): Entrant – Entrant – Championship – Round: Own relation, key: Entrant, Championship, Round
-- note: 6 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS PlaysChess CASCADE;
DROP TABLE IF EXISTS Round CASCADE;
DROP TABLE IF EXISTS Championship CASCADE;
DROP TABLE IF EXISTS Entrant CASCADE;

-- entity type Entrant
CREATE TABLE Entrant (
    entrantNo  INTEGER NOT NULL,
    name       VARCHAR(255),
    CONSTRAINT pk_Entrant PRIMARY KEY (entrantNo)
);

-- entity type Championship
CREATE TABLE Championship (
    championshipNo  INTEGER NOT NULL,
    name            VARCHAR(255),
    CONSTRAINT pk_Championship PRIMARY KEY (championshipNo)
);

-- entity type Round
CREATE TABLE Round (
    round  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Round PRIMARY KEY (round)
);

-- relationship plays Chess (4-ary 1:1:m:m)
CREATE TABLE PlaysChess (
    entrantNo_1     INTEGER NOT NULL,
    entrantNo_2     INTEGER NOT NULL,
    championshipNo  INTEGER NOT NULL,
    round           VARCHAR(255) NOT NULL,
    result          VARCHAR(255),
    CONSTRAINT pk_PlaysChess PRIMARY KEY (entrantNo_2, championshipNo, round),
    CONSTRAINT uq_PlaysChess_entrantNo_daaaf4 UNIQUE (entrantNo_1, championshipNo, round),
    CONSTRAINT fk_PlaysChess_Entrant FOREIGN KEY (entrantNo_1) REFERENCES Entrant (entrantNo),
    CONSTRAINT fk_PlaysChess_Entrant_2 FOREIGN KEY (entrantNo_2) REFERENCES Entrant (entrantNo),
    CONSTRAINT fk_PlaysChess_Championship FOREIGN KEY (championshipNo) REFERENCES Championship (championshipNo),
    CONSTRAINT fk_PlaysChess_Round FOREIGN KEY (round) REFERENCES Round (round)
);

