== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- note: 6 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Region_export_Article CASCADE;
DROP TABLE IF EXISTS Article CASCADE;
DROP TABLE IF EXISTS Region CASCADE;

-- entity type Region
CREATE TABLE Region (
    regionReference  VARCHAR(255) NOT NULL,
    name             VARCHAR(255),
    acreage          INTEGER,
    CONSTRAINT pk_Region PRIMARY KEY (regionReference)
);

-- entity type Article
CREATE TABLE Article (
    articleNo  INTEGER NOT NULL,
    name       VARCHAR(255),
    CONSTRAINT pk_Article PRIMARY KEY (articleNo)
);

-- relationship export (complex-complex)
CREATE TABLE Region_export_Article (
    regionReference  VARCHAR(255) NOT NULL,
    articleNo        INTEGER NOT NULL,
    value            VARCHAR(255),
    CONSTRAINT pk_Region_export_Article PRIMARY KEY (regionReference, articleNo),
    CONSTRAINT fk_Region_export_Articl_deca2e FOREIGN KEY (regionReference) REFERENCES Region (regionReference),
    CONSTRAINT fk_Region_export_Articl_d87c95 FOREIGN KEY (articleNo) REFERENCES Article (articleNo)
);

-- not enforced by this schema (needs triggers or the application):
--   each Region has, in export, Article: at least 1
--   each Article has, in export, Region: at least 1

