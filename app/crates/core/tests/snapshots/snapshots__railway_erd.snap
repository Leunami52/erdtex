== problems
== relational schema
Relational schema
Notation: _name_ primary key, /name/ foreign key, _/name/_ both

Person : {(_PID_ : integer, name : string, address : string, dateOfBirth : date)}
Member : {(_/PID/_ : integer, empID : integer, salary : decimal, category : string)}
Commuter : {(_/PID/_ : integer, gender : string, vegetarian : string)}
Engineer : {(_/PID/_ : integer, drivingHours : float, license : string)}
Technician : {(_/PID/_ : integer, Permit : string)}
Station : {(_StID_ : integer, name : string, location : string)}
Train : {(_TID_ : integer, departureTime : time, arrivalTime : time, interval : string, /departureStID/ : integer, /arrivalStID/ : integer)}
Journey : {(_/TID/_ : integer, _date_ : date, /PID/ : integer, /serID/ : integer)}
LocomotiveType : {(_manufacturer_ : string, _type_ : string, length : float, speed : float, seats : integer, maintenancePeriod : string, range : float)}
Locomotive : {(_serID_ : integer, purchaseDate : date, trainHrs : float, lastMaintenance : string, extensionType : string, /manufacturer/ : string, /type/ : string)}
PersonCategory : {(_/PID/_ : integer, _category_ : string)}
Commuter_book_Journey : {(_/PID/_ : integer, _/TID/_ : integer, _/date/_ : date, class : string, seat : string, price : decimal)}
Engineer_qualified_LocomotiveType : {(_/PID/_ : integer, _/manufacturer/_ : string, _/type/_ : string)}
Technician_qualified_LocomotiveType : {(_/PID/_ : integer, _/manufacturer/_ : string, _/type/_ : string)}
Locomotive_maintain_Technician : {(_/serID/_ : integer, _/PID/_ : integer, from : datetime, to : datetime)}

Foreign keys
  Member.PID -> Person.PID
  Commuter.PID -> Person.PID
  Engineer.PID -> Member.PID
  Technician.PID -> Member.PID
  Train.departureStID -> Station.StID
  Train.arrivalStID -> Station.StID
  Journey.TID -> Train.TID
  Journey.PID -> Engineer.PID
  Journey.serID -> Locomotive.serID
  Locomotive.(manufacturer, type) -> LocomotiveType.(manufacturer, type)
  PersonCategory.PID -> Person.PID
  Commuter_book_Journey.PID -> Commuter.PID
  Commuter_book_Journey.(TID, date) -> Journey.(TID, date)
  Engineer_qualified_LocomotiveType.PID -> Engineer.PID
  Engineer_qualified_LocomotiveType.(manufacturer, type) -> LocomotiveType.(manufacturer, type)
  Technician_qualified_LocomotiveType.PID -> Technician.PID
  Technician_qualified_LocomotiveType.(manufacturer, type) -> LocomotiveType.(manufacturer, type)
  Locomotive_maintain_Technician.serID -> Locomotive.serID
  Locomotive_maintain_Technician.PID -> Technician.PID

Unique (alternate keys)
  Member.empID

Allowed values
  Member.category in {Engineer, Technician}
  PersonCategory.category in {Member, Commuter}

Not enforced by the schema
  each Station has, in departure, Train: at least 1
  each Station has, in arrival, Train: at least 1
  each Train has, in execute, Journey: at least 1
  each Commuter has, in book, Journey: at least 1
  each Journey has, in book, Commuter: at least 1
  each Engineer has, in operates, Journey: at least 1
  each Engineer has, in qualified, Locomotive type: at least 1
  each Locomotive type has, in qualified, Engineer: at least 1
  each Technician has, in qualified, Locomotive type: at least 1
  each Locomotive type has, in qualified, Technician: at least 1
  each Locomotive has, in transport, Journey: at least 1
  each Locomotive type has, in assign to, Locomotive: at least 1
  each Locomotive has, in maintain, Technician: at least 1
  each Technician has, in maintain, Locomotive: at least 1

Decisions
  Generalisation Person ← Member, Commuter (co): (1) Multiple relations + categorisation relation
  Generalisation Member ← Engineer, Technician (id): (1) Multiple relations + categorisation attribute

Notes
  36 data type(s) were guessed from attribute names (set them with 'name : type').

== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- decision: Generalisation Person ← Member, Commuter (co): (1) Multiple relations + categorisation relation
-- decision: Generalisation Member ← Engineer, Technician (id): (1) Multiple relations + categorisation attribute
-- note: 36 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Locomotive_maintain_Technician CASCADE;
DROP TABLE IF EXISTS Technician_qualified_LocomotiveType CASCADE;
DROP TABLE IF EXISTS Engineer_qualified_LocomotiveType CASCADE;
DROP TABLE IF EXISTS Commuter_book_Journey CASCADE;
DROP TABLE IF EXISTS PersonCategory CASCADE;
DROP TABLE IF EXISTS Journey CASCADE;
DROP TABLE IF EXISTS Locomotive CASCADE;
DROP TABLE IF EXISTS LocomotiveType CASCADE;
DROP TABLE IF EXISTS Train CASCADE;
DROP TABLE IF EXISTS Station CASCADE;
DROP TABLE IF EXISTS Technician CASCADE;
DROP TABLE IF EXISTS Engineer CASCADE;
DROP TABLE IF EXISTS Commuter CASCADE;
DROP TABLE IF EXISTS Member CASCADE;
DROP TABLE IF EXISTS Person CASCADE;

-- entity type Person
CREATE TABLE Person (
    PID          INTEGER NOT NULL,
    name         VARCHAR(255),
    address      VARCHAR(255),
    dateOfBirth  DATE,
    CONSTRAINT pk_Person PRIMARY KEY (PID)
);

-- entity type Member, subtype of Person
CREATE TABLE Member (
    PID       INTEGER NOT NULL,
    empID     INTEGER NOT NULL,
    salary    NUMERIC(12,2),
    category  VARCHAR(255),
    CONSTRAINT pk_Member PRIMARY KEY (PID),
    CONSTRAINT uq_Member_empID UNIQUE (empID),
    CONSTRAINT ck_Member_category CHECK (category IN ('Engineer', 'Technician')),
    CONSTRAINT fk_Member_Person FOREIGN KEY (PID) REFERENCES Person (PID) ON DELETE CASCADE
);

-- entity type Commuter, subtype of Person
CREATE TABLE Commuter (
    PID         INTEGER NOT NULL,
    gender      VARCHAR(255),
    vegetarian  VARCHAR(255),
    CONSTRAINT pk_Commuter PRIMARY KEY (PID),
    CONSTRAINT fk_Commuter_Person FOREIGN KEY (PID) REFERENCES Person (PID) ON DELETE CASCADE
);

-- entity type Engineer, subtype of Member
CREATE TABLE Engineer (
    PID           INTEGER NOT NULL,
    drivingHours  DOUBLE PRECISION,
    license       VARCHAR(255),
    CONSTRAINT pk_Engineer PRIMARY KEY (PID),
    CONSTRAINT fk_Engineer_Member FOREIGN KEY (PID) REFERENCES Member (PID) ON DELETE CASCADE
);

-- entity type Technician, subtype of Member
CREATE TABLE Technician (
    PID     INTEGER NOT NULL,
    Permit  VARCHAR(255),
    CONSTRAINT pk_Technician PRIMARY KEY (PID),
    CONSTRAINT fk_Technician_Member FOREIGN KEY (PID) REFERENCES Member (PID) ON DELETE CASCADE
);

-- entity type Station
CREATE TABLE Station (
    StID      INTEGER NOT NULL,
    name      VARCHAR(255),
    location  VARCHAR(255),
    CONSTRAINT pk_Station PRIMARY KEY (StID)
);

-- entity type Train
CREATE TABLE Train (
    TID            INTEGER NOT NULL,
    departureTime  TIME,
    arrivalTime    TIME,
    interval       VARCHAR(255),
    departureStID  INTEGER NOT NULL,
    arrivalStID    INTEGER NOT NULL,
    CONSTRAINT pk_Train PRIMARY KEY (TID),
    CONSTRAINT fk_Train_Station FOREIGN KEY (departureStID) REFERENCES Station (StID),
    CONSTRAINT fk_Train_Station_2 FOREIGN KEY (arrivalStID) REFERENCES Station (StID)
);

-- entity type Locomotive type
CREATE TABLE LocomotiveType (
    manufacturer       VARCHAR(255) NOT NULL,
    type               VARCHAR(255) NOT NULL,
    length             DOUBLE PRECISION,
    speed              DOUBLE PRECISION,
    seats              INTEGER,
    maintenancePeriod  VARCHAR(255),
    range              DOUBLE PRECISION,
    CONSTRAINT pk_LocomotiveType PRIMARY KEY (manufacturer, type)
);

-- entity type Locomotive
CREATE TABLE Locomotive (
    serID            INTEGER NOT NULL,
    purchaseDate     DATE,
    trainHrs         DOUBLE PRECISION,
    lastMaintenance  VARCHAR(255),
    extensionType    VARCHAR(255),
    manufacturer     VARCHAR(255) NOT NULL,
    type             VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Locomotive PRIMARY KEY (serID),
    CONSTRAINT fk_Locomotive_LocomotiveType FOREIGN KEY (manufacturer, type) REFERENCES LocomotiveType (manufacturer, type)
);

-- entity type Journey (weak)
CREATE TABLE Journey (
    TID     INTEGER NOT NULL,
    "date"  DATE NOT NULL,
    PID     INTEGER NOT NULL,
    serID   INTEGER NOT NULL,
    CONSTRAINT pk_Journey PRIMARY KEY (TID, "date"),
    CONSTRAINT fk_Journey_Train FOREIGN KEY (TID) REFERENCES Train (TID) ON DELETE CASCADE,
    CONSTRAINT fk_Journey_Engineer FOREIGN KEY (PID) REFERENCES Engineer (PID),
    CONSTRAINT fk_Journey_Locomotive FOREIGN KEY (serID) REFERENCES Locomotive (serID)
);

-- categorisation of Person (overlapping)
CREATE TABLE PersonCategory (
    PID       INTEGER NOT NULL,
    category  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_PersonCategory PRIMARY KEY (PID, category),
    CONSTRAINT ck_PersonCategory_category CHECK (category IN ('Member', 'Commuter')),
    CONSTRAINT fk_PersonCategory_Person FOREIGN KEY (PID) REFERENCES Person (PID) ON DELETE CASCADE
);

-- relationship book (complex-complex)
CREATE TABLE Commuter_book_Journey (
    PID     INTEGER NOT NULL,
    TID     INTEGER NOT NULL,
    "date"  DATE NOT NULL,
    class   VARCHAR(255),
    seat    VARCHAR(255),
    price   NUMERIC(12,2),
    CONSTRAINT pk_Commuter_book_Journey PRIMARY KEY (PID, TID, "date"),
    CONSTRAINT fk_Commuter_book_Journe_cee1cf FOREIGN KEY (PID) REFERENCES Commuter (PID),
    CONSTRAINT fk_Commuter_book_Journe_8c71b9 FOREIGN KEY (TID, "date") REFERENCES Journey (TID, "date")
);

-- relationship qualified (complex-complex)
CREATE TABLE Engineer_qualified_LocomotiveType (
    PID           INTEGER NOT NULL,
    manufacturer  VARCHAR(255) NOT NULL,
    type          VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Engineer_qualified_L_65ed24 PRIMARY KEY (PID, manufacturer, type),
    CONSTRAINT fk_Engineer_qualified_L_8d2aaf FOREIGN KEY (PID) REFERENCES Engineer (PID),
    CONSTRAINT fk_Engineer_qualified_L_faf279 FOREIGN KEY (manufacturer, type) REFERENCES LocomotiveType (manufacturer, type)
);

-- relationship qualified (complex-complex)
CREATE TABLE Technician_qualified_LocomotiveType (
    PID           INTEGER NOT NULL,
    manufacturer  VARCHAR(255) NOT NULL,
    type          VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Technician_qualified_c03ac2 PRIMARY KEY (PID, manufacturer, type),
    CONSTRAINT fk_Technician_qualified_66c060 FOREIGN KEY (PID) REFERENCES Technician (PID),
    CONSTRAINT fk_Technician_qualified_2d5ea0 FOREIGN KEY (manufacturer, type) REFERENCES LocomotiveType (manufacturer, type)
);

-- relationship maintain (complex-complex)
CREATE TABLE Locomotive_maintain_Technician (
    serID   INTEGER NOT NULL,
    PID     INTEGER NOT NULL,
    "from"  TIMESTAMP,
    "to"    TIMESTAMP,
    CONSTRAINT pk_Locomotive_maintain__c9c422 PRIMARY KEY (serID, PID),
    CONSTRAINT fk_Locomotive_maintain__b06bf1 FOREIGN KEY (serID) REFERENCES Locomotive (serID),
    CONSTRAINT fk_Locomotive_maintain__43f8e6 FOREIGN KEY (PID) REFERENCES Technician (PID)
);

-- not enforced by this schema (needs triggers or the application):
--   each Station has, in departure, Train: at least 1
--   each Station has, in arrival, Train: at least 1
--   each Train has, in execute, Journey: at least 1
--   each Commuter has, in book, Journey: at least 1
--   each Journey has, in book, Commuter: at least 1
--   each Engineer has, in operates, Journey: at least 1
--   each Engineer has, in qualified, Locomotive type: at least 1
--   each Locomotive type has, in qualified, Engineer: at least 1
--   each Technician has, in qualified, Locomotive type: at least 1
--   each Locomotive type has, in qualified, Technician: at least 1
--   each Locomotive has, in transport, Journey: at least 1
