== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- decision: Relationship pass (1:m:1): Judge – Audition – Applicant: Own relation, key: Audition, Applicant
-- note: 8 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Pass CASCADE;
DROP TABLE IF EXISTS Applicant CASCADE;
DROP TABLE IF EXISTS Audition CASCADE;
DROP TABLE IF EXISTS Judge CASCADE;

-- entity type Judge
CREATE TABLE Judge (
    judgeNo  INTEGER NOT NULL,
    name     VARCHAR(255),
    CONSTRAINT pk_Judge PRIMARY KEY (judgeNo)
);

-- entity type Audition
CREATE TABLE Audition (
    auditionNo  INTEGER NOT NULL,
    courses     VARCHAR(255),
    "date"      DATE,
    grade       VARCHAR(255),
    CONSTRAINT pk_Audition PRIMARY KEY (auditionNo)
);

-- entity type Applicant
CREATE TABLE Applicant (
    traineeID  INTEGER NOT NULL,
    name       VARCHAR(255),
    CONSTRAINT pk_Applicant PRIMARY KEY (traineeID)
);

-- relationship pass (3-ary 1:m:1)
CREATE TABLE Pass (
    judgeNo     INTEGER NOT NULL,
    auditionNo  INTEGER NOT NULL,
    traineeID   INTEGER NOT NULL,
    CONSTRAINT pk_Pass PRIMARY KEY (auditionNo, traineeID),
    CONSTRAINT uq_Pass_judgeNo_auditionNo UNIQUE (judgeNo, auditionNo),
    CONSTRAINT fk_Pass_Judge FOREIGN KEY (judgeNo) REFERENCES Judge (judgeNo),
    CONSTRAINT fk_Pass_Audition FOREIGN KEY (auditionNo) REFERENCES Audition (auditionNo),
    CONSTRAINT fk_Pass_Applicant FOREIGN KEY (traineeID) REFERENCES Applicant (traineeID)
);

