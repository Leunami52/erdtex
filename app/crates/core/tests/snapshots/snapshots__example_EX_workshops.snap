== relational schema
Relational schema
Notation: _name_ primary key, /name/ foreign key, _/name/_ both

Trainee : {(_traineeID_ : integer, name : string, semester : integer)}
Workshop : {(_workshopID_ : integer, title : string, hours : float, /persID/ : integer)}
Technician : {(_/persID/_ : integer, specialty : string, /InstructorPersID/ : integer)}
Instructor : {(_/persID/_ : integer, position : string, room : integer)}
Personnel : {(_persID_ : integer, name : string, salary : decimal, jobCategory : string)}
Trainee_attend_Workshop : {(_/traineeID/_ : integer, _/workshopID/_ : integer)}
Workshop_require_Workshop : {(_/previous/_ : integer, _/next/_ : integer)}
exam : {(_/traineeID/_ : integer, _/workshopID/_ : integer, /persID/ : integer, mark : string)}

Foreign keys
  Workshop.persID -> Instructor.persID
  Technician.persID -> Personnel.persID
  Technician.InstructorPersID -> Instructor.persID
  Instructor.persID -> Personnel.persID
  Trainee_attend_Workshop.traineeID -> Trainee.traineeID
  Trainee_attend_Workshop.workshopID -> Workshop.workshopID
  Workshop_require_Workshop.previous -> Workshop.workshopID
  Workshop_require_Workshop.next -> Workshop.workshopID
  exam.traineeID -> Trainee.traineeID
  exam.workshopID -> Workshop.workshopID
  exam.persID -> Instructor.persID

Allowed values
  Personnel.jobCategory in {Technician, Instructor}

Not enforced by the schema
  each Trainee has, in attend, Workshop: at least 1
  each Workshop has, in attend, Trainee: at least 1
  each Instructor has, in give, Workshop: at least 1
  each Instructor has, in assists, Technician: at least 1

Decisions
  Generalisation Personnel ← Technician, Instructor (id): (1) Multiple relations + categorisation attribute

Notes
  13 data type(s) were guessed from attribute names (set them with 'name : type').

== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- decision: Generalisation Personnel ← Technician, Instructor (id): (1) Multiple relations + categorisation attribute
-- note: 13 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Exam CASCADE;
DROP TABLE IF EXISTS Workshop_require_Workshop CASCADE;
DROP TABLE IF EXISTS Trainee_attend_Workshop CASCADE;
DROP TABLE IF EXISTS Technician CASCADE;
DROP TABLE IF EXISTS Workshop CASCADE;
DROP TABLE IF EXISTS Instructor CASCADE;
DROP TABLE IF EXISTS Personnel CASCADE;
DROP TABLE IF EXISTS Trainee CASCADE;

-- entity type Trainee
CREATE TABLE Trainee (
    traineeID  INTEGER NOT NULL,
    name       VARCHAR(255),
    semester   INTEGER,
    CONSTRAINT pk_Trainee PRIMARY KEY (traineeID)
);

-- entity type Personnel
CREATE TABLE Personnel (
    persID       INTEGER NOT NULL,
    name         VARCHAR(255),
    salary       NUMERIC(12,2),
    jobCategory  VARCHAR(255),
    CONSTRAINT pk_Personnel PRIMARY KEY (persID),
    CONSTRAINT ck_Personnel_jobCategory CHECK (jobCategory IN ('Technician', 'Instructor'))
);

-- entity type Instructor, subtype of Personnel
CREATE TABLE Instructor (
    persID    INTEGER NOT NULL,
    position  VARCHAR(255),
    room      INTEGER,
    CONSTRAINT pk_Instructor PRIMARY KEY (persID),
    CONSTRAINT fk_Instructor_Personnel FOREIGN KEY (persID) REFERENCES Personnel (persID) ON DELETE CASCADE
);

-- entity type Workshop
CREATE TABLE Workshop (
    workshopID  INTEGER NOT NULL,
    title       VARCHAR(255),
    hours       DOUBLE PRECISION,
    persID      INTEGER NOT NULL,
    CONSTRAINT pk_Workshop PRIMARY KEY (workshopID),
    CONSTRAINT fk_Workshop_Instructor FOREIGN KEY (persID) REFERENCES Instructor (persID)
);

-- entity type Technician, subtype of Personnel
CREATE TABLE Technician (
    persID            INTEGER NOT NULL,
    specialty         VARCHAR(255),
    InstructorPersID  INTEGER NOT NULL,
    CONSTRAINT pk_Technician PRIMARY KEY (persID),
    CONSTRAINT fk_Technician_Personnel FOREIGN KEY (persID) REFERENCES Personnel (persID) ON DELETE CASCADE,
    CONSTRAINT fk_Technician_Instructor FOREIGN KEY (InstructorPersID) REFERENCES Instructor (persID)
);

-- relationship attend (complex-complex)
CREATE TABLE Trainee_attend_Workshop (
    traineeID   INTEGER NOT NULL,
    workshopID  INTEGER NOT NULL,
    CONSTRAINT pk_Trainee_attend_Workshop PRIMARY KEY (traineeID, workshopID),
    CONSTRAINT fk_Trainee_attend_Works_39af98 FOREIGN KEY (traineeID) REFERENCES Trainee (traineeID),
    CONSTRAINT fk_Trainee_attend_Works_e9b4b6 FOREIGN KEY (workshopID) REFERENCES Workshop (workshopID)
);

-- relationship require (recursive, nc:mc)
CREATE TABLE Workshop_require_Workshop (
    previous  INTEGER NOT NULL,
    next      INTEGER NOT NULL,
    CONSTRAINT pk_Workshop_require_Workshop PRIMARY KEY (previous, next),
    CONSTRAINT fk_Workshop_require_Wor_cc2a1c FOREIGN KEY (previous) REFERENCES Workshop (workshopID),
    CONSTRAINT fk_Workshop_require_Wor_cc2_2 FOREIGN KEY (next) REFERENCES Workshop (workshopID)
);

-- relationship exam (3-ary m:m:1)
CREATE TABLE Exam (
    traineeID   INTEGER NOT NULL,
    workshopID  INTEGER NOT NULL,
    persID      INTEGER NOT NULL,
    mark        VARCHAR(255),
    CONSTRAINT pk_Exam PRIMARY KEY (traineeID, workshopID),
    CONSTRAINT fk_Exam_Trainee FOREIGN KEY (traineeID) REFERENCES Trainee (traineeID),
    CONSTRAINT fk_Exam_Workshop FOREIGN KEY (workshopID) REFERENCES Workshop (workshopID),
    CONSTRAINT fk_Exam_Instructor FOREIGN KEY (persID) REFERENCES Instructor (persID)
);

-- not enforced by this schema (needs triggers or the application):
--   each Trainee has, in attend, Workshop: at least 1
--   each Workshop has, in attend, Trainee: at least 1
--   each Instructor has, in give, Workshop: at least 1
--   each Instructor has, in assists, Technician: at least 1

