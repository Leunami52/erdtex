== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX

DROP TABLE IF EXISTS Trainee_attends_Workshop CASCADE;
DROP TABLE IF EXISTS Workshop CASCADE;
DROP TABLE IF EXISTS Trainee CASCADE;

-- entity type Trainee
CREATE TABLE Trainee (
    traineeID  INTEGER NOT NULL,
    CONSTRAINT pk_Trainee PRIMARY KEY (traineeID)
);

-- entity type Workshop
CREATE TABLE Workshop (
    workshopID  INTEGER NOT NULL,
    CONSTRAINT pk_Workshop PRIMARY KEY (workshopID)
);

-- relationship attends (complex-complex)
CREATE TABLE Trainee_attends_Workshop (
    traineeID   INTEGER NOT NULL,
    workshopID  INTEGER NOT NULL,
    CONSTRAINT pk_Trainee_attends_Workshop PRIMARY KEY (traineeID, workshopID),
    CONSTRAINT fk_Trainee_attends_Work_e99473 FOREIGN KEY (traineeID) REFERENCES Trainee (traineeID),
    CONSTRAINT fk_Trainee_attends_Work_91cbe0 FOREIGN KEY (workshopID) REFERENCES Workshop (workshopID)
);

-- not enforced by this schema (needs triggers or the application):
