<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-erdiagram">
    <comment>ER diagram (erdiagram)</comment>
    <sub-class-of type="text/plain"/>
    <icon name="erdtex"/>
    <glob pattern="*.erd"/>
  </mime-type>
  <mime-type type="text/x-gsmdiagram">
    <comment>GSM diagram (gsmdiagram)</comment>
    <sub-class-of type="text/plain"/>
    <icon name="erdtex"/>
    <glob pattern="*.gsmd"/>
  </mime-type>
</mime-info>
