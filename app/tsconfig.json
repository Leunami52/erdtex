{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "paths": { "#platform": ["./frontend/src/lib/platform/desktop.ts"] }
  },
  "include": ["frontend/src/**/*.ts", "frontend/src/**/*.svelte"]
}
