== problems
== relational schema
Relational schema
Notation: _name_ primary key, /name/ foreign key, _/name/_ both

City : {(_CityName_ : string, _StateName_ : string)}
Terminal : {(_Name_ : string, BerthsCount : integer, /CityName/ : string, /StateName/ : string)}
Ferry : {(_FerryNbr_ : string, LoadCapacity : float, Description : string)}
Captain : {(_CaptainNbr_ : string, Name : string, DateOfBirth : date)}
Crossing : {(_CrossingID_ : integer, /FerryNbr/ : string, /terminalName/ : string, ScheduledTime : time, ActualTime : time, /terminalTerminalName/ : string, arrivesScheduledTime : time, arrivesActualTime : time, /CaptainNbr/ : string)}
Berth : {(_BerthNbr_ : string, /Name/ : string)}
Captain_responsibleFor_Ferry : {(/CaptainNbr/ : string, _/FerryNbr/_ : string, _DateBegin_ : date, DateEnd : date)}
Berth_loadsAt_Crossing : {(_/BerthNbr/_ : string, _/CrossingID/_ : integer)}
Berth_unloadsAt_Crossing : {(_/BerthNbr/_ : string, _/CrossingID/_ : integer)}

Foreign keys
  Terminal.(CityName, StateName) -> City.(CityName, StateName)
  Crossing.FerryNbr -> Ferry.FerryNbr
  Crossing.terminalName -> Terminal.Name
  Crossing.terminalTerminalName -> Terminal.Name
  Crossing.CaptainNbr -> Captain.CaptainNbr
  Berth.Name -> Terminal.Name
  Captain_responsibleFor_Ferry.CaptainNbr -> Captain.CaptainNbr
  Captain_responsibleFor_Ferry.FerryNbr -> Ferry.FerryNbr
  Berth_loadsAt_Crossing.BerthNbr -> Berth.BerthNbr
  Berth_loadsAt_Crossing.CrossingID -> Crossing.CrossingID
  Berth_unloadsAt_Crossing.BerthNbr -> Berth.BerthNbr
  Berth_unloadsAt_Crossing.CrossingID -> Crossing.CrossingID

Not enforced by the schema
  each Ferry has, in responsible for, Captain: at least 1
  each Crossing has, in loads at, Berth: at least 1
  each Crossing has, in unloads at, Berth: at least 1

Notes
  'responsible for' has key attributes, so it always gets an own relation.
  18 data type(s) were guessed from attribute names (set them with 'name : type').

== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- note: 'responsible for' has key attributes, so it always gets an own relation.
-- note: 18 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Berth_unloadsAt_Crossing CASCADE;
DROP TABLE IF EXISTS Berth_loadsAt_Crossing CASCADE;
DROP TABLE IF EXISTS Captain_responsibleFor_Ferry CASCADE;
DROP TABLE IF EXISTS Berth CASCADE;
DROP TABLE IF EXISTS Crossing CASCADE;
DROP TABLE IF EXISTS Captain CASCADE;
DROP TABLE IF EXISTS Ferry CASCADE;
DROP TABLE IF EXISTS Terminal CASCADE;
DROP TABLE IF EXISTS City CASCADE;

-- entity type City
CREATE TABLE City (
    cityName   VARCHAR(255) NOT NULL,
    stateName  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_City PRIMARY KEY (cityName, stateName)
);

-- entity type Terminal
CREATE TABLE Terminal (
    Name         VARCHAR(255) NOT NULL,
    berthsCount  INTEGER,
    cityName     VARCHAR(255) NOT NULL,
    stateName    VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Terminal PRIMARY KEY (Name),
    CONSTRAINT fk_Terminal_City FOREIGN KEY (cityName, stateName) REFERENCES City (cityName, stateName)
);

-- entity type Ferry
CREATE TABLE Ferry (
    ferryNbr      VARCHAR(255) NOT NULL,
    loadCapacity  DOUBLE PRECISION,
    Description   VARCHAR(255),
    CONSTRAINT pk_Ferry PRIMARY KEY (ferryNbr)
);

-- entity type Captain
CREATE TABLE Captain (
    captainNbr   VARCHAR(255) NOT NULL,
    Name         VARCHAR(255),
    dateOfBirth  DATE,
    CONSTRAINT pk_Captain PRIMARY KEY (captainNbr)
);

-- entity type Crossing (weak)
CREATE TABLE Crossing (
    crossingID            INTEGER NOT NULL,
    ferryNbr              VARCHAR(255) NOT NULL,
    terminalName          VARCHAR(255) NOT NULL,
    scheduledTime         TIME,
    actualTime            TIME,
    terminalTerminalName  VARCHAR(255) NOT NULL,
    arrivesScheduledTime  TIME,
    arrivesActualTime     TIME,
    captainNbr            VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Crossing PRIMARY KEY (crossingID),
    CONSTRAINT fk_Crossing_Ferry FOREIGN KEY (ferryNbr) REFERENCES Ferry (ferryNbr) ON DELETE CASCADE,
    CONSTRAINT fk_Crossing_Terminal FOREIGN KEY (terminalName) REFERENCES Terminal (Name) ON DELETE CASCADE,
    CONSTRAINT fk_Crossing_Terminal_2 FOREIGN KEY (terminalTerminalName) REFERENCES Terminal (Name) ON DELETE CASCADE,
    CONSTRAINT fk_Crossing_Captain FOREIGN KEY (captainNbr) REFERENCES Captain (captainNbr) ON DELETE CASCADE
);

-- entity type Berth (weak)
CREATE TABLE Berth (
    berthNbr  VARCHAR(255) NOT NULL,
    Name      VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Berth PRIMARY KEY (berthNbr),
    CONSTRAINT fk_Berth_Terminal FOREIGN KEY (Name) REFERENCES Terminal (Name) ON DELETE CASCADE
);

-- relationship responsible for (single-complex)
CREATE TABLE Captain_responsibleFor_Ferry (
    captainNbr  VARCHAR(255) NOT NULL,
    ferryNbr    VARCHAR(255) NOT NULL,
    dateBegin   DATE NOT NULL,
    dateEnd     DATE,
    CONSTRAINT pk_Captain_responsibleF_7c5a00 PRIMARY KEY (ferryNbr, dateBegin),
    CONSTRAINT fk_Captain_responsibleF_cc16be FOREIGN KEY (captainNbr) REFERENCES Captain (captainNbr),
    CONSTRAINT fk_Captain_responsibleF_3cec00 FOREIGN KEY (ferryNbr) REFERENCES Ferry (ferryNbr)
);

-- relationship loads at (complex-complex)
CREATE TABLE Berth_loadsAt_Crossing (
    berthNbr    VARCHAR(255) NOT NULL,
    crossingID  INTEGER NOT NULL,
    CONSTRAINT pk_Berth_loadsAt_Crossing PRIMARY KEY (berthNbr, crossingID),
    CONSTRAINT fk_Berth_loadsAt_Crossi_fbc2ef FOREIGN KEY (berthNbr) REFERENCES Berth (berthNbr),
    CONSTRAINT fk_Berth_loadsAt_Crossi_622d80 FOREIGN KEY (crossingID) REFERENCES Crossing (crossingID)
);

-- relationship unloads at (complex-complex)
CREATE TABLE Berth_unloadsAt_Crossing (
    berthNbr    VARCHAR(255) NOT NULL,
    crossingID  INTEGER NOT NULL,
    CONSTRAINT pk_Berth_unloadsAt_Crossing PRIMARY KEY (berthNbr, crossingID),
    CONSTRAINT fk_Berth_unloadsAt_Cros_0f9a5c FOREIGN KEY (berthNbr) REFERENCES Berth (berthNbr),
    CONSTRAINT fk_Berth_unloadsAt_Cros_ce8a46 FOREIGN KEY (crossingID) REFERENCES Crossing (crossingID)
);

