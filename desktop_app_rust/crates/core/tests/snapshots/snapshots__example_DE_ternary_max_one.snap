== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- decision: Relationship r ((0,*):(0,*):(1,1)): A – B – C: Own relation, key: C
-- note: 3 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS R CASCADE;
DROP TABLE IF EXISTS C CASCADE;
DROP TABLE IF EXISTS B CASCADE;
DROP TABLE IF EXISTS A CASCADE;

-- entity type A
CREATE TABLE A (
    aId  INTEGER NOT NULL,
    CONSTRAINT pk_A PRIMARY KEY (aId)
);

-- entity type B
CREATE TABLE B (
    bId  INTEGER NOT NULL,
    CONSTRAINT pk_B PRIMARY KEY (bId)
);

-- entity type C
CREATE TABLE C (
    cId  INTEGER NOT NULL,
    CONSTRAINT pk_C PRIMARY KEY (cId)
);

-- relationship r (3-ary (0,*):(0,*):(1,1))
CREATE TABLE R (
    aId  INTEGER NOT NULL,
    bId  INTEGER NOT NULL,
    cId  INTEGER NOT NULL,
    CONSTRAINT pk_R PRIMARY KEY (cId),
    CONSTRAINT fk_R_A FOREIGN KEY (aId) REFERENCES A (aId),
    CONSTRAINT fk_R_B FOREIGN KEY (bId) REFERENCES B (bId),
    CONSTRAINT fk_R_C FOREIGN KEY (cId) REFERENCES C (cId)
);

-- not enforced by this schema (needs triggers or the application):
--   each C takes part in r: at least 1

