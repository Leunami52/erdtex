== problems
== relational schema
Relational schema
Notation: _name_ primary key, /name/ foreign key, _/name/_ both

Member : {(_memberNo_ : integer, name : string, category : string)}
Coach : {(_/memberNo/_ : integer, experience : string)}
Referee : {(_/memberNo/_ : integer, licence : string)}
Groundskeeper : {(_/memberNo/_ : integer, machines : string)}

Foreign keys
  Coach.memberNo -> Member.memberNo
  Referee.memberNo -> Member.memberNo
  Groundskeeper.memberNo -> Member.memberNo

Allowed values
  Member.category in {Coach, Referee, Groundskeeper}

Decisions
  Generalisation Member ← Coach, Referee, Groundskeeper (cd): (1) Multiple relations + categorisation attribute

Notes
  5 data type(s) were guessed from attribute names (set them with 'name : type').

== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- decision: Generalisation Member ← Coach, Referee, Groundskeeper (cd): (1) Multiple relations + categorisation attribute
-- note: 5 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Groundskeeper CASCADE;
DROP TABLE IF EXISTS Referee CASCADE;
DROP TABLE IF EXISTS Coach CASCADE;
DROP TABLE IF EXISTS Member CASCADE;

-- entity type Member
CREATE TABLE Member (
    memberNo  INTEGER NOT NULL,
    name      VARCHAR(255),
    category  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Member PRIMARY KEY (memberNo),
    CONSTRAINT ck_Member_category CHECK (category IN ('Coach', 'Referee', 'Groundskeeper'))
);

-- entity type Coach, subtype of Member
CREATE TABLE Coach (
    memberNo    INTEGER NOT NULL,
    experience  VARCHAR(255),
    CONSTRAINT pk_Coach PRIMARY KEY (memberNo),
    CONSTRAINT fk_Coach_Member FOREIGN KEY (memberNo) REFERENCES Member (memberNo) ON DELETE CASCADE
);

-- entity type Referee, subtype of Member
CREATE TABLE Referee (
    memberNo  INTEGER NOT NULL,
    licence   VARCHAR(255),
    CONSTRAINT pk_Referee PRIMARY KEY (memberNo),
    CONSTRAINT fk_Referee_Member FOREIGN KEY (memberNo) REFERENCES Member (memberNo) ON DELETE CASCADE
);

-- entity type Groundskeeper, subtype of Member
CREATE TABLE Groundskeeper (
    memberNo  INTEGER NOT NULL,
    machines  VARCHAR(255),
    CONSTRAINT pk_Groundskeeper PRIMARY KEY (memberNo),
    CONSTRAINT fk_Groundskeeper_Member FOREIGN KEY (memberNo) REFERENCES Member (memberNo) ON DELETE CASCADE
);

