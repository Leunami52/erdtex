== problems
== relational schema
Relational schema
Notation: _name_ primary key, /name/ foreign key, _/name/_ both

Werkstatt : {(_Name_ : string, Website : string, /PersonID/ : integer)}
Meister*in : {(_/PersonID/_ : integer, PersNr : integer)}
Projekt : {(_ProjektID_ : integer, Titel : string, Startjahr : string)}
Person : {(_PersonID_ : integer, Name : string, E-Mail : string)}
Bienenvolk : {(_VolkID_ : integer, Name : string, Art : string, GebDatum : string, /PersonID/ : integer)}
Imker*in : {(_/PersonID/_ : integer, Adresse : string)}
Termin : {(_TerminID_ : integer, Datum : string, /PersonID/ : integer, /ProjektID/ : integer, /VolkID/ : integer)}
Versuch : {(_/TerminID/_ : integer, _Nummer_ : string, Bedingung : string, Ergebnis : string)}
PersonCategory : {(_/PersonID/_ : integer, _category_ : string)}
Meister*in_arbeitetAn_Projekt : {(_/PersonID/_ : integer, _/ProjektID/_ : integer)}
Projekt_bautAuf_Projekt : {(_/Nachfolgerin/_ : integer, /Vorgaengerin/ : integer)}
Werkstatt_beschäftigt_Meister*in : {(_/Name/_ : string, _/PersonID/_ : integer, von : string, bis : string)}

Foreign keys
  Werkstatt.PersonID -> Meister*in.PersonID
  Meister*in.PersonID -> Person.PersonID
  Bienenvolk.PersonID -> Imker*in.PersonID
  Imker*in.PersonID -> Person.PersonID
  Termin.PersonID -> Meister*in.PersonID
  Termin.ProjektID -> Projekt.ProjektID
  Termin.VolkID -> Bienenvolk.VolkID
  Versuch.TerminID -> Termin.TerminID
  PersonCategory.PersonID -> Person.PersonID
  Meister*in_arbeitetAn_Projekt.PersonID -> Meister*in.PersonID
  Meister*in_arbeitetAn_Projekt.ProjektID -> Projekt.ProjektID
  Projekt_bautAuf_Projekt.Nachfolgerin -> Projekt.ProjektID
  Projekt_bautAuf_Projekt.Vorgaengerin -> Projekt.ProjektID
  Werkstatt_beschäftigt_Meister*in.Name -> Werkstatt.Name
  Werkstatt_beschäftigt_Meister*in.PersonID -> Meister*in.PersonID

Unique (alternate keys)
  Werkstatt.PersonID

Allowed values
  PersonCategory.category in {Meister*in, Imker*in}

Not enforced by the schema
  each Meister*in has, in wird betreut von, Werkstatt: at least 1
  each Meister*in has, in arbeitet an, Projekt: at least 1
  each Projekt has, in arbeitet an, Meister*in: at least 1
  each Projekt has, in baut auf, Projekt: at least 1
  each Werkstatt has, in beschäftigt, Meister*in: at least 1
  each Meister*in has, in beschäftigt, Werkstatt: at least 1
  each Meister*in has, in durchführt, Termin: at least 1
  each Projekt has, in in, Termin: at least 1
  each Imker*in has, in pflegt, Bienenvolk: at least 1
  each Bienenvolk has, in mit, Termin: at least 1
  each Termin has, in besteht aus, Versuch: at least 1

Decisions
  Generalisation Person ← Meister*in, Imker*in (co): (1) Multiple relations + categorisation relation
  Relationship wird betreut von (1:1): Werkstatt – Meister*in: Foreign key in Werkstatt
  Relationship baut auf (n:1): Projekt (Nachfolgerin) – Projekt (Vorgaengerin): Own relation with renamed keys

Notes
  'besteht aus' is weak without E/Id; treated as an identification dependency (Id).
  21 data type(s) were guessed from attribute names (set them with 'name : type').

== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- decision: Generalisation Person ← Meister*in, Imker*in (co): (1) Multiple relations + categorisation relation
-- decision: Relationship wird betreut von (1:1): Werkstatt – Meister*in: Foreign key in Werkstatt
-- decision: Relationship baut auf (n:1): Projekt (Nachfolgerin) – Projekt (Vorgaengerin): Own relation with renamed keys
-- note: 'besteht aus' is weak without E/Id; treated as an identification dependency (Id).
-- note: 21 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Werkstatt_beschaeftigt_MeisterIn CASCADE;
DROP TABLE IF EXISTS Projekt_bautAuf_Projekt CASCADE;
DROP TABLE IF EXISTS MeisterIn_arbeitetAn_Projekt CASCADE;
DROP TABLE IF EXISTS PersonCategory CASCADE;
DROP TABLE IF EXISTS Versuch CASCADE;
DROP TABLE IF EXISTS Termin CASCADE;
DROP TABLE IF EXISTS Bienenvolk CASCADE;
DROP TABLE IF EXISTS ImkerIn CASCADE;
DROP TABLE IF EXISTS Projekt CASCADE;
DROP TABLE IF EXISTS Werkstatt CASCADE;
DROP TABLE IF EXISTS MeisterIn CASCADE;
DROP TABLE IF EXISTS Person CASCADE;

-- entity type Person
CREATE TABLE Person (
    PersonID  INTEGER NOT NULL,
    Name      VARCHAR(255),
    EMail     VARCHAR(255),
    CONSTRAINT pk_Person PRIMARY KEY (PersonID)
);

-- entity type Meister*in, subtype of Person
CREATE TABLE MeisterIn (
    PersonID  INTEGER NOT NULL,
    PersNr    INTEGER,
    CONSTRAINT pk_MeisterIn PRIMARY KEY (PersonID),
    CONSTRAINT fk_MeisterIn_Person FOREIGN KEY (PersonID) REFERENCES Person (PersonID) ON DELETE CASCADE
);

-- entity type Werkstatt
CREATE TABLE Werkstatt (
    Name      VARCHAR(255) NOT NULL,
    Website   VARCHAR(255),
    PersonID  INTEGER NOT NULL,
    CONSTRAINT pk_Werkstatt PRIMARY KEY (Name),
    CONSTRAINT uq_Werkstatt_PersonID UNIQUE (PersonID),
    CONSTRAINT fk_Werkstatt_MeisterIn FOREIGN KEY (PersonID) REFERENCES MeisterIn (PersonID)
);

-- entity type Projekt
CREATE TABLE Projekt (
    ProjektID  INTEGER NOT NULL,
    Titel      VARCHAR(255),
    Startjahr  VARCHAR(255),
    CONSTRAINT pk_Projekt PRIMARY KEY (ProjektID)
);

-- entity type Imker*in, subtype of Person
CREATE TABLE ImkerIn (
    PersonID  INTEGER NOT NULL,
    Adresse   VARCHAR(255),
    CONSTRAINT pk_ImkerIn PRIMARY KEY (PersonID),
    CONSTRAINT fk_ImkerIn_Person FOREIGN KEY (PersonID) REFERENCES Person (PersonID) ON DELETE CASCADE
);

-- entity type Bienenvolk
CREATE TABLE Bienenvolk (
    VolkID    INTEGER NOT NULL,
    Name      VARCHAR(255),
    Art       VARCHAR(255),
    GebDatum  VARCHAR(255),
    PersonID  INTEGER NOT NULL,
    CONSTRAINT pk_Bienenvolk PRIMARY KEY (VolkID),
    CONSTRAINT fk_Bienenvolk_ImkerIn FOREIGN KEY (PersonID) REFERENCES ImkerIn (PersonID)
);

-- entity type Termin
CREATE TABLE Termin (
    TerminID   INTEGER NOT NULL,
    Datum      VARCHAR(255),
    PersonID   INTEGER NOT NULL,
    ProjektID  INTEGER NOT NULL,
    VolkID     INTEGER NOT NULL,
    CONSTRAINT pk_Termin PRIMARY KEY (TerminID),
    CONSTRAINT fk_Termin_MeisterIn FOREIGN KEY (PersonID) REFERENCES MeisterIn (PersonID),
    CONSTRAINT fk_Termin_Projekt FOREIGN KEY (ProjektID) REFERENCES Projekt (ProjektID),
    CONSTRAINT fk_Termin_Bienenvolk FOREIGN KEY (VolkID) REFERENCES Bienenvolk (VolkID)
);

-- entity type Versuch (weak)
CREATE TABLE Versuch (
    TerminID   INTEGER NOT NULL,
    Nummer     VARCHAR(255) NOT NULL,
    Bedingung  VARCHAR(255),
    Ergebnis   VARCHAR(255),
    CONSTRAINT pk_Versuch PRIMARY KEY (TerminID, Nummer),
    CONSTRAINT fk_Versuch_Termin FOREIGN KEY (TerminID) REFERENCES Termin (TerminID) ON DELETE CASCADE
);

-- categorisation of Person (overlapping)
CREATE TABLE PersonCategory (
    PersonID  INTEGER NOT NULL,
    category  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_PersonCategory PRIMARY KEY (PersonID, category),
    CONSTRAINT ck_PersonCategory_category CHECK (category IN ('Meister*in', 'Imker*in')),
    CONSTRAINT fk_PersonCategory_Person FOREIGN KEY (PersonID) REFERENCES Person (PersonID) ON DELETE CASCADE
);

-- relationship arbeitet an (complex-complex)
CREATE TABLE MeisterIn_arbeitetAn_Projekt (
    PersonID   INTEGER NOT NULL,
    ProjektID  INTEGER NOT NULL,
    CONSTRAINT pk_MeisterIn_arbeitetAn_c797d8 PRIMARY KEY (PersonID, ProjektID),
    CONSTRAINT fk_MeisterIn_arbeitetAn_eceb69 FOREIGN KEY (PersonID) REFERENCES MeisterIn (PersonID),
    CONSTRAINT fk_MeisterIn_arbeitetAn_19fd0c FOREIGN KEY (ProjektID) REFERENCES Projekt (ProjektID)
);

-- relationship baut auf (recursive, n:1)
CREATE TABLE Projekt_bautAuf_Projekt (
    Nachfolgerin  INTEGER NOT NULL,
    Vorgaengerin  INTEGER NOT NULL,
    CONSTRAINT pk_Projekt_bautAuf_Projekt PRIMARY KEY (Nachfolgerin),
    CONSTRAINT fk_Projekt_bautAuf_Proj_334b1b FOREIGN KEY (Nachfolgerin) REFERENCES Projekt (ProjektID),
    CONSTRAINT fk_Projekt_bautAuf_Proj_334_2 FOREIGN KEY (Vorgaengerin) REFERENCES Projekt (ProjektID)
);

-- relationship beschäftigt (complex-complex)
CREATE TABLE Werkstatt_beschaeftigt_MeisterIn (
    Name      VARCHAR(255) NOT NULL,
    PersonID  INTEGER NOT NULL,
    von       VARCHAR(255),
    bis       VARCHAR(255),
    CONSTRAINT pk_Werkstatt_beschaefti_5fbacd PRIMARY KEY (Name, PersonID),
    CONSTRAINT fk_Werkstatt_beschaefti_c634cc FOREIGN KEY (Name) REFERENCES Werkstatt (Name),
    CONSTRAINT fk_Werkstatt_beschaefti_0d3ef4 FOREIGN KEY (PersonID) REFERENCES MeisterIn (PersonID)
);

-- not enforced by this schema (needs triggers or the application):
--   each Meister*in has, in wird betreut von, Werkstatt: at least 1
--   each Meister*in has, in arbeitet an, Projekt: at least 1
--   each Projekt has, in arbeitet an, Meister*in: at least 1
--   each Projekt has, in baut auf, Projekt: at least 1
--   each Werkstatt has, in beschäftigt, Meister*in: at least 1
--   each Meister*in has, in beschäftigt, Werkstatt: at least 1
--   each Meister*in has, in durchführt, Termin: at least 1
--   each Projekt has, in in, Termin: at least 1
--   each Imker*in has, in pflegt, Bienenvolk: at least 1
--   each Bienenvolk has, in mit, Termin: at least 1
--   each Termin has, in besteht aus, Versuch: at least 1

