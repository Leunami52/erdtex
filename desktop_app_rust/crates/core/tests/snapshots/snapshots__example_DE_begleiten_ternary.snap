== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- decision: Relationship begleiten (1:n:1): Ausbilder – Lehrlinge – Projektthemen: Own relation, key: Lehrlinge, Projektthemen
-- note: 4 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Begleiten CASCADE;
DROP TABLE IF EXISTS Projektthemen CASCADE;
DROP TABLE IF EXISTS Lehrlinge CASCADE;
DROP TABLE IF EXISTS Ausbilder CASCADE;

-- entity type Ausbilder
CREATE TABLE Ausbilder (
    PersNr  INTEGER NOT NULL,
    CONSTRAINT pk_Ausbilder PRIMARY KEY (PersNr)
);

-- entity type Lehrlinge
CREATE TABLE Lehrlinge (
    LehrlingNr  INTEGER NOT NULL,
    CONSTRAINT pk_Lehrlinge PRIMARY KEY (LehrlingNr)
);

-- entity type Projektthemen
CREATE TABLE Projektthemen (
    ThemaNr  INTEGER NOT NULL,
    CONSTRAINT pk_Projektthemen PRIMARY KEY (ThemaNr)
);

-- relationship begleiten (3-ary 1:n:1)
CREATE TABLE Begleiten (
    PersNr      INTEGER NOT NULL,
    LehrlingNr  INTEGER NOT NULL,
    ThemaNr     INTEGER NOT NULL,
    Note        VARCHAR(255),
    CONSTRAINT pk_Begleiten PRIMARY KEY (LehrlingNr, ThemaNr),
    CONSTRAINT uq_Begleiten_PersNr_LehrlingNr UNIQUE (PersNr, LehrlingNr),
    CONSTRAINT fk_Begleiten_Ausbilder FOREIGN KEY (PersNr) REFERENCES Ausbilder (PersNr),
    CONSTRAINT fk_Begleiten_Lehrlinge FOREIGN KEY (LehrlingNr) REFERENCES Lehrlinge (LehrlingNr),
    CONSTRAINT fk_Begleiten_Projektthemen FOREIGN KEY (ThemaNr) REFERENCES Projektthemen (ThemaNr)
);

