-- note: 7 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS "Completed workshops" CASCADE;
DROP TABLE IF EXISTS Workshop CASCADE;
DROP TABLE IF EXISTS Mentor CASCADE;
DROP TABLE IF EXISTS Trainee CASCADE;

-- entity type Trainee
CREATE TABLE Trainee (
    traineeID  INTEGER NOT NULL,
    name       VARCHAR(255),
    CONSTRAINT pk_Trainee PRIMARY KEY (traineeID)
);

-- entity type Mentor
CREATE TABLE Mentor (
    persID  INTEGER NOT NULL,
    name    VARCHAR(255),
    CONSTRAINT pk_Mentor PRIMARY KEY (persID)
);

-- entity type Workshop
