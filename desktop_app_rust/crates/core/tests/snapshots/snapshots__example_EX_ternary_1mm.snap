    workshoptitle  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_Workshop PRIMARY KEY (workshoptitle)
);

-- relationship pass (3-ary m:1:m)
CREATE TABLE "Completed workshops" (
    traineeID      INTEGER NOT NULL,
    persID         INTEGER NOT NULL,
    workshoptitle  VARCHAR(255) NOT NULL,
    grade          VARCHAR(255),
    "date"         DATE,
    CONSTRAINT pk_Completed_workshops PRIMARY KEY (traineeID, workshoptitle),
    CONSTRAINT fk_Completed_workshops_Trainee FOREIGN KEY (traineeID) REFERENCES Trainee (traineeID),
    CONSTRAINT fk_Completed_workshops_Mentor FOREIGN KEY (persID) REFERENCES Mentor (persID),
