-- PostgreSQL schema, generated by ERDTeX
-- note: derived attribute Person.Alter is not stored
-- note: 5 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS PersonEMail CASCADE;
DROP TABLE IF EXISTS Person CASCADE;

-- entity type Person
CREATE TABLE Person (
    PID          INTEGER NOT NULL,
    Strasse      VARCHAR(255),
    PLZ          VARCHAR(255),
    rechnungPLZ  VARCHAR(255),
    CONSTRAINT pk_Person PRIMARY KEY (PID)
);

-- multi-valued attribute Person.E-Mail
CREATE TABLE PersonEMail (
    PID    INTEGER NOT NULL,
    EMail  VARCHAR(255) NOT NULL,
    CONSTRAINT pk_PersonEMail PRIMARY KEY (PID, EMail),
    CONSTRAINT fk_PersonEMail_Person FOREIGN KEY (PID) REFERENCES Person (PID) ON DELETE CASCADE
);

