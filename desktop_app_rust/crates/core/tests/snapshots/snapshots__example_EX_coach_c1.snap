-- entity type Member
CREATE TABLE Member (
    memberNo  INTEGER NOT NULL,
    name      VARCHAR(255),
    CONSTRAINT pk_Member PRIMARY KEY (memberNo)
);

-- entity type Club
CREATE TABLE Club (
    clubNo    INTEGER NOT NULL,
    name      VARCHAR(255),
    memberNo  INTEGER NOT NULL,
    CONSTRAINT pk_Club PRIMARY KEY (clubNo),
    CONSTRAINT uq_Club_memberNo UNIQUE (memberNo),
    CONSTRAINT fk_Club_Member FOREIGN KEY (memberNo) REFERENCES Member (memberNo)
);

