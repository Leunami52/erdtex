== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- note: 'bewerten': all foreign keys form the key, because (min,max) cannot express that some sides determine another.
-- note: 4 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Bewerten CASCADE;
DROP TABLE IF EXISTS Kurse CASCADE;
DROP TABLE IF EXISTS Lehrlinge CASCADE;
DROP TABLE IF EXISTS Ausbilder CASCADE;

-- entity type Ausbilder
CREATE TABLE Ausbilder (
    PersNr  INTEGER NOT NULL,
    CONSTRAINT pk_Ausbilder PRIMARY KEY (PersNr)
);

-- entity type Lehrlinge
CREATE TABLE Lehrlinge (
    LehrlingNr  INTEGER NOT NULL,
    CONSTRAINT pk_Lehrlinge PRIMARY KEY (LehrlingNr)
);

-- entity type Kurse
CREATE TABLE Kurse (
    KursNr  INTEGER NOT NULL,
    CONSTRAINT pk_Kurse PRIMARY KEY (KursNr)
);

-- relationship bewerten (3-ary (0,*):(0,*):(0,*))
CREATE TABLE Bewerten (
    PersNr      INTEGER NOT NULL,
    LehrlingNr  INTEGER NOT NULL,
    KursNr      INTEGER NOT NULL,
    Note        VARCHAR(255),
    CONSTRAINT pk_Bewerten PRIMARY KEY (PersNr, LehrlingNr, KursNr),
    CONSTRAINT fk_Bewerten_Ausbilder FOREIGN KEY (PersNr) REFERENCES Ausbilder (PersNr),
    CONSTRAINT fk_Bewerten_Lehrlinge FOREIGN KEY (LehrlingNr) REFERENCES Lehrlinge (LehrlingNr),
    CONSTRAINT fk_Bewerten_Kurse FOREIGN KEY (KursNr) REFERENCES Kurse (KursNr)
);

