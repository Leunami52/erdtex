    category   VARCHAR(255),
    classID    INTEGER,
    CONSTRAINT pk_StudentSecondLine PRIMARY KEY (StudentID),
    CONSTRAINT ck_StudentSecondLine_category CHECK (category IN ('Undergrad', 'Postgrad')),
    CONSTRAINT fk_StudentSecondLine_Class FOREIGN KEY (classID) REFERENCES Class (classID)
);

-- entity type Undergrad, subtype of Student Second line
