-- entity type Course
CREATE TABLE Course (
    CourseID  INTEGER NOT NULL,
    Title     VARCHAR(255),
    Credits   VARCHAR(255),
    code      INTEGER NOT NULL,
    CONSTRAINT pk_Course PRIMARY KEY (CourseID, code)
);

-- entity type Assignment (weak)
CREATE TABLE Assignment (
    CourseID              INTEGER NOT NULL,
    code                  INTEGER NOT NULL,
    courseCourseID        INTEGER NOT NULL,
    courseCode            INTEGER NOT NULL,
    No                    INTEGER NOT NULL,
    Title                 VARCHAR(255),
    Due                   VARCHAR(255),
    courseCourseCourseID  INTEGER NOT NULL,
    courseCourseCode      INTEGER NOT NULL,
    CONSTRAINT pk_Assignment PRIMARY KEY (CourseID, code, courseCourseID, courseCode, No),
    CONSTRAINT fk_Assignment_Course FOREIGN KEY (CourseID, code) REFERENCES Course (CourseID, code) ON DELETE CASCADE,
    CONSTRAINT fk_Assignment_Course_2 FOREIGN KEY (courseCourseID, courseCode) REFERENCES Course (CourseID, code) ON DELETE CASCADE,
    CONSTRAINT fk_Assignment_Course_3 FOREIGN KEY (courseCourseCourseID, courseCourseCode) REFERENCES Course (CourseID, code) ON DELETE CASCADE
);

-- entity type Class
CREATE TABLE Class (
    classID         INTEGER NOT NULL,
    "all"           VARCHAR(255),
    eight           VARCHAR(255),
    now             VARCHAR(255),
    possible        VARCHAR(255),
    CourseID        INTEGER,
    code            INTEGER,
    courseCourseID  INTEGER,
    courseCode      INTEGER,
    No              INTEGER,
    CONSTRAINT pk_Class PRIMARY KEY (classID),
    CONSTRAINT fk_Class_Assignment FOREIGN KEY (CourseID, code, courseCourseID, courseCode, No) REFERENCES Assignment (CourseID, code, courseCourseID, courseCode, No)
);

-- entity type Student Second line
-- box: Students subdomain
CREATE TABLE StudentSecondLine (
