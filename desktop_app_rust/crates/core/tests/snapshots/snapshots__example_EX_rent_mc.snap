== SQL (PostgreSQL)
-- PostgreSQL schema, generated by ERDTeX
-- note: 9 data type(s) were guessed from attribute names (set them with 'name : type').

DROP TABLE IF EXISTS Bicycle CASCADE;
DROP TABLE IF EXISTS Rider CASCADE;

-- entity type Rider
CREATE TABLE Rider (
    riderNo   INTEGER NOT NULL,
    name      VARCHAR(255),
    street    VARCHAR(255),
    location  VARCHAR(255),
    CONSTRAINT pk_Rider PRIMARY KEY (riderNo)
);

-- entity type Bicycle
CREATE TABLE Bicycle (
    frameNo     INTEGER NOT NULL,
    title       VARCHAR(255),
    publisher   VARCHAR(255),
    year        INTEGER,
    riderNo     INTEGER,
    returnDate  DATE,
    CONSTRAINT pk_Bicycle PRIMARY KEY (frameNo),
    CONSTRAINT fk_Bicycle_Rider FOREIGN KEY (riderNo) REFERENCES Rider (riderNo)
);

-- not enforced by this schema (needs triggers or the application):
--   each Rider has, in rent, Bicycle: at least 1

